-- examples/counter_island.march — CounterIsland: canonical Counter island example.
--
-- Demonstrates the Bastion island pattern (init / update / render / decode_msg /
-- encode_state / decode_state / ssr).  This island can be tested entirely on the
-- server in pure March without a browser or WASM runtime.
--
-- Usage in a page template:
--
--   let state       = CounterIsland.initial()
--   let state_json  = CounterIsland.encode_state(state)
--   let island_html = CounterIsland.ssr(state)
--
-- Msg JSON format (sent by the JS runtime after user events):
--   {"tag":"Increment"}
--   {"tag":"Decrement"}
--   {"tag":"Reset"}
--   {"tag":"SetValue","value":42}
--
-- State JSON format:
--   {"count":0}

mod CounterIsland do

import Islands

-- ── Types ──────────────────────────────────────────────────────────────────

type State = { count : Int }

type Msg = Increment | Decrement | Reset | SetValue(Int)

-- ── Lifecycle ──────────────────────────────────────────────────────────────

doc "Return the default initial state for the counter island (count=0)."
fn initial() : State do
  { count: 0 }
end

doc """
Apply a message to the current state and return the next state.

  Increment   — adds 1 to count
  Decrement   — subtracts 1 from count
  Reset       — resets count to 0
  SetValue(n) — sets count to n
"""
fn update(state : State, msg : Msg) : State do
  match msg do
  Increment    -> { count: state.count + 1 }
  Decrement    -> { count: state.count - 1 }
  Reset        -> { count: 0 }
  SetValue(n)  -> { count: n }
  end
end

-- ── Rendering ──────────────────────────────────────────────────────────────

doc """
Render the counter island as an HTML fragment.

The rendered HTML uses data-on-click attributes so the JS runtime routes
click events to the island's update function as Msg JSON.
"""
fn render(state : State) : String do
  let count_str = int_to_string(state.count)
  "<div class=\"counter\">" ++
  "<button data-on-click=\"Decrement\">-</button>" ++
  "<span class=\"count\">" ++ count_str ++ "</span>" ++
  "<button data-on-click=\"Increment\">+</button>" ++
  "<button data-on-click=\"Reset\">Reset</button>" ++
  "</div>"
end

doc "Return the count value from a State record."
fn count_of(state : State) : Int do
  state.count
end

-- ── SSR wrapper ────────────────────────────────────────────────────────────

doc """
Render the island and wrap it with Bastion island hydration metadata.

Returns the full island wrapper div including data-march-island,
data-march-hydrate, and data-march-state attributes, with the SSR
content inside.  Use this in page templates.
"""
fn ssr(state : State) : String do
  let state_json = encode_state(state)
  let ssr_html   = render(state)
  Islands.wrap("CounterIsland", Islands.eager(), state_json, ssr_html)
end

-- ── Serialisation ──────────────────────────────────────────────────────────

doc "Encode a State value to a JSON string."
fn encode_state(state : State) : String do
  "{\"count\":" ++ int_to_string(state.count) ++ "}"
end

doc """
Decode a State from a JSON string.

Parses {\"count\":N} and returns a State record.
Falls back to {count:0} if the JSON cannot be parsed.
"""
fn decode_state(json : String) : State do
  -- Split {"count":N} at ":" to isolate N
  -- String.split_first returns Option((String,String)) via make_some_ptr — no int-tag issue
  let count = match String.split_first(json, ":") do
    None -> 0
    Some((_, after)) ->
      -- after = "N}" or "-N}" — collect digits then parse
      let digits = ci_collect_digits(after, "")
      ci_parse_int(digits)
    end
  { count: count }
end

doc """
Decode a Msg from a JSON string.

Handles:
  {\"tag\":\"Increment\"}
  {\"tag\":\"Decrement\"}
  {\"tag\":\"Reset\"}
  {\"tag\":\"SetValue\",\"value\":N}

Unknown tags fall back to Reset.
"""
fn decode_msg(json : String) : Msg do
  -- Use String.contains to detect the tag — avoids String.index_of int-tag bug
  if String.contains(json, "\"Increment\"") do
    Increment
  else if String.contains(json, "\"Decrement\"") do
    Decrement
  else if String.contains(json, "\"SetValue\"") do
    -- Extract value integer: split at "value": to get the digits
    let n = match String.split_first(json, "\"value\":") do
      None -> 0
      Some((_, after)) ->
        let digits = ci_collect_digits(after, "")
        ci_parse_int(digits)
      end
    SetValue(n)
  else if String.contains(json, "\"Reset\"") do
    Reset
  else
    Reset
  end end end end
end

-- ── Private JSON helpers ───────────────────────────────────────────────────
--
-- NOTE: String.index_of returns Option(Int) via make_some_i64 (raw i64 in
-- the Some payload).  The March compiler emits `asr #1` to untag the Int,
-- which halves the raw value.  We therefore avoid String.index_of entirely
-- and use String.contains / String.split_first instead.

-- Collect ASCII digit (and leading '-') characters from the start of s.
pfn ci_collect_digits(s : String, acc : String) : String do
  if String.is_empty(s) do
    acc
  else
    let first = String.slice_bytes(s, 0, 1)
    let is_digit_char =
      first == "0" || first == "1" || first == "2" || first == "3" ||
      first == "4" || first == "5" || first == "6" || first == "7" ||
      first == "8" || first == "9" || first == "-"
    if is_digit_char do
      let rest = String.slice_bytes(s, 1, String.byte_size(s) - 1)
      ci_collect_digits(rest, acc ++ first)
    else
      acc
    end
  end
end

-- Parse a decimal digit string to Int without using string_to_int
-- (which also suffers from the Option(Int) int-tag bug).
pfn ci_parse_int(s : String) : Int do
  if String.is_empty(s) do
    0
  else
    let first = String.slice_bytes(s, 0, 1)
    if first == "-" do
      let rest = String.slice_bytes(s, 1, String.byte_size(s) - 1)
      0 - ci_digits_to_int(rest, 0)
    else
      ci_digits_to_int(s, 0)
    end
  end
end

pfn ci_digits_to_int(s : String, acc : Int) : Int do
  if String.is_empty(s) do
    acc
  else
    let first = String.slice_bytes(s, 0, 1)
    let rest  = String.slice_bytes(s, 1, String.byte_size(s) - 1)
    let digit =
      if first == "0" do 0
      else if first == "1" do 1
      else if first == "2" do 2
      else if first == "3" do 3
      else if first == "4" do 4
      else if first == "5" do 5
      else if first == "6" do 6
      else if first == "7" do 7
      else if first == "8" do 8
      else if first == "9" do 9
      else 0
      end end end end end end end end end end
    ci_digits_to_int(rest, acc * 10 + digit)
  end
end

end
