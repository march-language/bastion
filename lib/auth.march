-- lib/auth.march — Bastion.Auth stub
--
-- Placeholder for the Auth module referenced by Bastion.Test.Auth.
-- A full implementation is generated by `forge bastion.gen.auth`.
--
-- This stub provides the core login/logout primitives so that
-- Bastion.Test.Auth compiles.  Applications should use the generated
-- Auth module from gen.auth, which includes user token tables,
-- password hashing, and remember-me cookies.

mod Auth do

  -- ── Login / logout ────────────────────────────────────────────────────────

  doc """
  Log a user in by writing their ID to the session.

  Renews the session (clears all existing session data) to prevent
  session fixation attacks, then sets "current_user_id".

      let conn2 = Auth.log_in(conn, user.id)
  """
  fn log_in(conn, user_id : String) do
    let conn2 = Session.clear(conn)
    Session.put(conn2, "current_user_id", user_id)
  end

  doc """
  Log the current user out by clearing the session.

      let conn2 = Auth.log_out(conn)
  """
  fn log_out(conn) do
    Session.clear(conn)
  end

  doc """
  Return the current user ID from the session, or None.

      Auth.current_user_id(conn)   -- Some("42") or None
  """
  fn current_user_id(conn) : Option(String) do
    Session.get(conn, "current_user_id")
  end

end
