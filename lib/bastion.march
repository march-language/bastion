-- Bastion — a plug-style HTTP web framework for March.
--
-- Bastion wraps HttpServer with ergonomic higher-level abstractions:
-- a declarative router, typed middleware pipeline, static file serving,
-- and structured request/response helpers.
--
-- Usage:
--
--   fn main() do
--     let router =
--       Router.new()
--       |> Router.get("/", home_handler)
--       |> Router.get("/users/:id", user_handler)
--       |> Router.post("/users", create_user_handler)
--
--     Bastion.start(router, Bastion.default_opts(4000))
--   end

mod Bastion do
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process

  needs IO.Console

  -- Server configuration options.
  --
  -- Fields (positional):
  --   port            — TCP port to listen on
  --   max_connections — maximum number of concurrent connections
  --   idle_timeout    — seconds before an idle connection is closed
  type Opts = Opts(Int, Int, Int)

  doc "Returns a default Opts with the given port, 1000 max connections, and 60s idle timeout."
  fn default_opts(port : Int) : Opts do
    Opts(port, 1000, 60)
  end

  doc "Returns the port from an Opts value."
  fn opts_port(opts : Opts) : Int do
    match opts do
    Opts(port, _, _) -> port
    end
  end

  doc "Alias for opts_port. Returns the port from an Opts value."
  fn port(opts : Opts) : Int do
    opts_port(opts)
  end

  doc "Returns a new Opts with the port replaced."
  fn with_port(opts : Opts, port : Int) : Opts do
    match opts do
    Opts(_, mc, it) -> Opts(port, mc, it)
    end
  end

  doc "Returns a new Opts with max_connections replaced."
  fn with_max_connections(opts : Opts, n : Int) : Opts do
    match opts do
    Opts(port, _, it) -> Opts(port, n, it)
    end
  end

  doc "Returns a new Opts with idle_timeout (in seconds) replaced."
  fn with_idle_timeout(opts : Opts, secs : Int) : Opts do
    match opts do
    Opts(port, mc, _) -> Opts(port, mc, secs)
    end
  end

  -- ── CLI Entry Point ─────────────────────────────────────────────────

  fn main() : Unit do
    let args = Process.argv()
    match args do
    Cons(_, Cons(cmd, rest)) ->
      match cmd do
      "new" ->
        match rest do
        Cons(name, _) -> cmd_new(name)
        Nil ->
          todo("error: missing app name\nusage: bastion new <app_name>")
        end
      _ ->
        todo("error: unknown command: " ++ cmd)
      end
    _ -> do
      print_help()
    end
    end
  end

  pfn print_help() : Unit do
    println("Bastion — web framework CLI")
    println("")
    println("Commands:")
    println("  bastion new <app_name>   Create a new Bastion application")
  end

  -- ── new command ───────────────────────────────────────────────────────

  pfn cmd_new(name : String) : Unit do
    match Dir.exists(name) do
    true ->
      todo("error: directory '" ++ name ++ "' already exists")
    false -> do
      println("Creating Bastion app: " ++ name)
      scaffold(name)
      println("")
      println("Done! Next steps:")
      println("")
      println("  cd " ++ name)
      println("  forge deps")
      println("  forge run")
      println("")
      println("Your app will be at http://localhost:4000")
    end
    end
  end

  -- ── Scaffolding ───────────────────────────────────────────────────────

  pfn scaffold(name : String) : Unit do
    let pascal = to_pascal(name)

    -- Directory structure
    Dir.mkdir_p(name)
    Dir.mkdir_p(name ++ "/lib")
    Dir.mkdir_p(name ++ "/public")
    Dir.mkdir_p(name ++ "/public/css")
    Dir.mkdir_p(name ++ "/public/js")
    Dir.mkdir_p(name ++ "/islands")
    Dir.mkdir_p(name ++ "/test")

    -- Project files
    write_file(name ++ "/forge.toml",           forge_toml(name))
    write_file(name ++ "/.editorconfig",        editorconfig_tpl())
    write_file(name ++ "/.gitignore",           gitignore_tpl())
    write_file(name ++ "/README.md",            readme_tpl(name))

    -- Lib files
    write_file(name ++ "/lib/" ++ name ++ ".march",           main_module(name, pascal))
    write_file(name ++ "/lib/page_controller.march",          page_controller(pascal))
    write_file(name ++ "/lib/counter.march",                  counter_island(pascal))

    -- Public assets
    write_file(name ++ "/public/css/app.css",   app_css())
    write_file(name ++ "/public/js/.gitkeep",   "")
    write_file(name ++ "/islands/.gitkeep",     "")

    -- Tests
    write_file(name ++ "/test/" ++ name ++ "_test.march", test_module(name, pascal))

    println("  created " ++ name ++ "/")
  end

  pfn write_file(path : String, content : String) : Unit do
    File.write(path, content)
    println("  created " ++ path)
  end

  -- ── Name helpers ──────────────────────────────────────────────────────

  -- Convert snake_case to PascalCase: "my_app" -> "MyApp"
  pfn to_pascal(s : String) : String do
    join_parts(String.split(s, "_"), "")
  end

  pfn join_parts(parts : List(String), acc : String) : String do
    match parts do
    Nil              -> acc
    Cons(part, rest) -> join_parts(rest, acc ++ capitalise(part))
    end
  end

  pfn capitalise(s : String) : String do
    match String.is_empty(s) do
    true  -> s
    false -> do
      let head = String.slice_bytes(s, 0, 1)
      let tail = String.slice_bytes(s, 1, String.byte_size(s) - 1)
      String.to_uppercase(head) ++ tail
    end
    end
  end

  -- ── File templates ────────────────────────────────────────────────────

  pfn forge_toml(name : String) : String do
    "[package]\n" ++
    "name = \"" ++ name ++ "\"\n" ++
    "version = \"0.1.0\"\n" ++
    "type = \"app\"\n" ++
    "description = \"\"\n" ++
    "author = \"\"\n" ++
    "\n" ++
    "[deps]\n" ++
    "bastion = { path: \"../bastion\" }\n" ++
    "islands = { path: \"../islands\" }\n"
  end

  pfn editorconfig_tpl() : String do
    "root = true\n\n" ++
    "[*]\n" ++
    "indent_style = space\n" ++
    "indent_size = 2\n" ++
    "charset = utf-8\n" ++
    "end_of_line = lf\n" ++
    "trim_trailing_whitespace = true\n" ++
    "insert_final_newline = true\n\n" ++
    "[*.march]\n" ++
    "indent_style = space\n" ++
    "indent_size = 2\n"
  end

  pfn gitignore_tpl() : String do
    "/.march/\n" ++
    "/islands/*.wasm\n" ++
    "/islands/*.glue.js\n"
  end

  pfn readme_tpl(name : String) : String do
    "# " ++ to_pascal(name) ++ "\n\n" ++
    "A [Bastion](https://github.com/march-lang/bastion) web application.\n\n" ++
    "## Getting started\n\n" ++
    "```bash\n" ++
    "forge deps\n" ++
    "forge run\n" ++
    "```\n\n" ++
    "Visit http://localhost:4000\n\n" ++
    "## Structure\n\n" ++
    "```\n" ++
    "lib/\n" ++
    "  " ++ name ++ ".march          # Router and server entry point\n" ++
    "  page_controller.march  # Page handlers\n" ++
    "  counter.march          # Example island component\n" ++
    "public/                  # Static assets (CSS, JS, images)\n" ++
    "islands/                 # Compiled .wasm island modules\n" ++
    "test/                    # Tests\n" ++
    "```\n\n" ++
    "## Islands\n\n" ++
    "Compile an island to WASM:\n\n" ++
    "```bash\n" ++
    "march --compile --target wasm32-unknown-unknown lib/counter.march -o islands/Counter.wasm\n" ++
    "```\n"
  end

  pfn main_module(_name : String, pascal : String) : String do
    "mod " ++ pascal ++ " do\n\n" ++
    "  import HttpServer\n" ++
    "  import Router\n" ++
    "  import Middleware\n" ++
    "  import Controller\n" ++
    "  import IslandSocket\n" ++
    "  import IslandAssets\n" ++
    "  import Static\n" ++
    "  import PageController\n" ++
    "  import Counter\n\n" ++
    "  pfn build_router() : Router do\n" ++
    "    Router.new()\n" ++
    "    |> Router.action(Get, \"/\",       fn conn -> PageController.home(conn))\n" ++
    "    |> Router.action(Get, \"/about\",  fn conn -> PageController.about(conn))\n" ++
    "    |> Router.get(\"/health\", fn conn -> health(conn))\n" ++
    "  end\n\n" ++
    "  pfn health(conn : Conn) : Conn do\n" ++
    "    Controller.json(conn, 200, \"{\\\"status\\\":\\\"ok\\\"}\")\n" ++
    "  end\n\n" ++
    "  -- ── Island registry ──────────────────────────────────────────────\n" ++
    "  -- Register all island modules with their JSON bridge functions.\n" ++
    "  -- Each island exposes update_json/render_json wrappers that handle\n" ++
    "  -- JSON string serialization across the WebSocket boundary.\n\n" ++
    "  pfn build_island_registry() : IslandSocket.Registry do\n" ++
    "    IslandSocket.new_registry()\n" ++
    "    |> IslandSocket.register(\"Counter\", fn (state, msg) -> Counter.update_json(state, msg), fn state -> Counter.render_json(state))\n" ++
    "  end\n\n" ++
    "  fn main() : Unit do\n" ++
    "    let router  = build_router()\n" ++
    "    let plug    = Router.to_plug(router)\n\n" ++
    "    -- Island infrastructure\n" ++
    "    let registry      = build_island_registry()\n" ++
    "    let island_ws     = IslandSocket.plug(IslandSocket.default_config(), registry)\n" ++
    "    let island_assets = IslandAssets.plug(IslandAssets.default_config())\n" ++
    "    let static_files  = Static.serve(\"public\")\n\n" ++
    "    let app = fn conn -> do\n" ++
    "      -- 1. Island WebSocket upgrade (must be first)\n" ++
    "      let c = island_ws(conn)\n" ++
    "      match HttpServer.halted(c) do true -> c | false -> do\n" ++
    "      -- 2. Island JS assets\n" ++
    "      let c = island_assets(c)\n" ++
    "      match HttpServer.halted(c) do true -> c | false -> do\n" ++
    "      -- 3. Static files\n" ++
    "      let c = static_files(c)\n" ++
    "      match HttpServer.halted(c) do true -> c | false -> do\n" ++
    "      -- 4. Middleware + router\n" ++
    "      let c = Middleware.logger(c)\n" ++
    "      let c = Middleware.request_id(c)\n" ++
    "      -- CORS is not enabled by default; configure an explicit origin\n" ++
    "      -- allowlist instead:  let c = Middleware.cors([\"https://example.com\"])(c)\n" ++
    "      match HttpServer.halted(c) do\n" ++
    "      true  -> c\n" ++
    "      false -> plug(c)\n" ++
    "      end\n" ++
    "      end end end\n" ++
    "    end\n\n" ++
    "    println(\"" ++ pascal ++ " listening on http://localhost:4000\")\n" ++
    "    HttpServer.new(4000)\n" ++
    "    |> HttpServer.plug(app)\n" ++
    "    |> HttpServer.listen()\n" ++
    "  end\n\n" ++
    "end\n"
  end

  pfn page_controller(pascal : String) : String do
    "mod PageController do\n\n" ++
    "  import HttpServer\n" ++
    "  import Controller\n" ++
    "  import Response\n\n" ++
    "  -- ── Actions ────────────────────────────────────────────────────────\n" ++
    "  -- Actions return Controller.ActionResult.  The router's fallback\n" ++
    "  -- handles Error results automatically — no per-handler wiring needed.\n\n" ++
    "  fn home(conn : Conn) : Controller.ActionResult do\n" ++
    "    let html = layout(\"Home\", ~H\"\"\"\n" ++
    "      <h1>Welcome to " ++ pascal ++ "!</h1>\n" ++
    "      <p>Edit <code>lib/page_controller.march</code> to get started.</p>\n" ++
    "      <p><a href=\"/about\">About</a></p>\n" ++
    "      <h2>Interactive Counter (Island)</h2>\n" ++
    "      <div data-march-island=\"Counter\" data-march-state='{\"count\":0}'></div>\n" ++
    "    \"\"\")\n" ++
    "    Controller.ActionOk(Response.html(conn, 200, html))\n" ++
    "  end\n\n" ++
    "  fn about(conn : Conn) : Controller.ActionResult do\n" ++
    "    let html = layout(\"About\", ~H\"\"\"\n" ++
    "      <h1>About</h1>\n" ++
    "      <p>Built with <a href=\"https://github.com/march-lang/bastion\">Bastion</a>.</p>\n" ++
    "    \"\"\")\n" ++
    "    Controller.ActionOk(Response.html(conn, 200, html))\n" ++
    "  end\n\n" ++
    "  -- ── Templates ──────────────────────────────────────────────────────\n\n" ++
    "  pfn layout(title : String, body : String) : String do\n" ++
    "    ~H\"\"\"\n" ++
    "    <!DOCTYPE html>\n" ++
    "    <html lang=\"en\">\n" ++
    "    <head>\n" ++
    "      <meta charset=\"utf-8\">\n" ++
    "      <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" ++
    "      <title>#{title} · " ++ pascal ++ "</title>\n" ++
    "      <link rel=\"stylesheet\" href=\"/css/app.css\">\n" ++
    "    </head>\n" ++
    "    <body>\n" ++
    "      <nav><a href=\"/\">Home</a> <a href=\"/about\">About</a></nav>\n" ++
    "      <main>\n" ++
    "        #{body}\n" ++
    "      </main>\n" ++
    "      <script src=\"/_bastion/islands.js\"></script>\n" ++
    "    </body>\n" ++
    "    </html>\n" ++
    "    \"\"\"\n" ++
    "  end\n\n" ++
    "end\n"
  end

  pfn counter_island(_pascal : String) : String do
    "-- Counter — example island component.\n" ++
    "--\n" ++
    "-- Islands follow the create/update/render protocol.\n" ++
    "-- Derive Json on State and Msg to get automatic update_json/render_json\n" ++
    "-- bridge functions generated by the compiler — no manual serialization needed.\n\n" ++
    "mod Counter do\n\n" ++
    "  type Props = { initial : Int }\n" ++
    "  type State = { count : Int }\n" ++
    "  type Msg = Increment | Decrement | Reset\n\n" ++
    "  derive Json for State\n" ++
    "  derive Json for Msg\n\n" ++
    "  fn create(props : Props) : State do\n" ++
    "    { count: props.initial }\n" ++
    "  end\n\n" ++
    "  fn update(st : State, msg : Msg) : State do\n" ++
    "    match msg do\n" ++
    "    Increment -> { count: st.count + 1 }\n" ++
    "    Decrement -> { count: st.count - 1 }\n" ++
    "    Reset     -> { count: 0 }\n" ++
    "    end\n" ++
    "  end\n\n" ++
    "  fn render(st : State) : IOList do\n" ++
    "    ~H\"\"\"\n" ++
    "    <div id=\"counter\" class=\"counter\">\n" ++
    "      <button data-msg=\"Decrement\">−</button>\n" ++
    "      <span class=\"count\">#{int_to_string(st.count)}</span>\n" ++
    "      <button data-msg=\"Increment\">+</button>\n" ++
    "    </div>\n" ++
    "    \"\"\"\n" ++
    "  end\n\n" ++
    "  -- update_json and render_json are auto-generated by the compiler\n" ++
    "  -- because State and Msg both derive Json.\n\n" ++
    "end\n"
  end

  pfn app_css() : String do
    "*, *::before, *::after { box-sizing: border-box; }\n\n" ++
    "body {\n" ++
    "  font-family: system-ui, sans-serif;\n" ++
    "  max-width: 800px;\n" ++
    "  margin: 0 auto;\n" ++
    "  padding: 1rem;\n" ++
    "  color: #1a1a1a;\n" ++
    "}\n\n" ++
    "nav { margin-bottom: 2rem; }\n" ++
    "nav a { margin-right: 1rem; color: #0070f3; text-decoration: none; }\n" ++
    "nav a:hover { text-decoration: underline; }\n\n" ++
    ".counter {\n" ++
    "  display: inline-flex;\n" ++
    "  align-items: center;\n" ++
    "  gap: 0.75rem;\n" ++
    "  font-size: 1.5rem;\n" ++
    "}\n\n" ++
    ".counter button {\n" ++
    "  font-size: 1.5rem;\n" ++
    "  width: 2.5rem;\n" ++
    "  height: 2.5rem;\n" ++
    "  border: 1px solid #ccc;\n" ++
    "  border-radius: 6px;\n" ++
    "  cursor: pointer;\n" ++
    "  background: white;\n" ++
    "}\n\n" ++
    ".counter button:hover { background: #f0f0f0; }\n"
  end

  pfn test_module(_name : String, pascal : String) : String do
    "mod " ++ pascal ++ "Test do\n\n" ++
    "  import Counter\n\n" ++
    "  describe \"Counter island\" do\n\n" ++
    "    test \"render_json shows initial count\" do\n" ++
    "      let html = Counter.render_json(\"{\\\"count\\\":0}\")\n" ++
    "      assert (String.contains(html, \"0\"))\n" ++
    "    end\n\n" ++
    "    test \"update_json increment increases count\" do\n" ++
    "      -- derive Json encodes variants as {\"tag\":\"Increment\"}\n" ++
    "      let next = Counter.update_json(\"{\\\"count\\\":5}\", \"{\\\"tag\\\":\\\"Increment\\\"}\")\n" ++
    "      assert (String.contains(next, \"6\"))\n" ++
    "    end\n\n" ++
    "    test \"update_json decrement decreases count\" do\n" ++
    "      let next = Counter.update_json(\"{\\\"count\\\":5}\", \"{\\\"tag\\\":\\\"Decrement\\\"}\")\n" ++
    "      assert (String.contains(next, \"4\"))\n" ++
    "    end\n\n" ++
    "    test \"render_json produces correct HTML\" do\n" ++
    "      let html = Counter.render_json(\"{\\\"count\\\":42}\")\n" ++
    "      assert (String.contains(html, \"42\"))\n" ++
    "      assert (String.contains(html, \"data-msg\"))\n" ++
    "      assert (String.contains(html, \"Increment\"))\n" ++
    "      assert (String.contains(html, \"Decrement\"))\n" ++
    "    end\n\n" ++
    "    test \"update_json then render_json round-trip\" do\n" ++
    "      let next = Counter.update_json(\"{\\\"count\\\":0}\", \"{\\\"tag\\\":\\\"Increment\\\"}\")\n" ++
    "      let html = Counter.render_json(next)\n" ++
    "      assert (String.contains(html, \"1\"))\n" ++
    "    end\n\n" ++
    "  end\n\n" ++
    "end\n"
  end

end
