-- BastionServer — convenience wrappers for starting a Bastion HTTP server.
--
-- Usage:
--
--   fn main() do
--     let router = build_router()
--     BastionServer.start(router, Bastion.default_opts(4000))
--   end

mod BastionServer do

  import HttpServer
  import Router
  import Bastion

  doc """
  Start the Bastion server with the given router and options.

  Converts the Router into an HttpServer plug and calls HttpServer.listen/1.
  Blocks the calling process until the server exits.

  Example:
    BastionServer.start(router, Bastion.default_opts(4000))
  """
  fn start(router : Router, opts : Opts) : Unit do
    start_plug(Router.to_plug(router), opts)
  end

  doc """
  Start the Bastion server with a pre-built plug and options.  Use this when
  you need to wrap the router in middleware (logger, static-file, etc.)
  before serving — the plug you supply is the single handler that every
  request flows through.

  Example:
    let pipeline = fn conn ->
      Middleware.pipeline([Middleware.logger, static_plug, Router.to_plug(router)], conn)
    BastionServer.start_plug(pipeline, Bastion.default_opts(4000))
  """
  fn start_plug(plug : Conn -> Conn, opts : Opts) : Unit do
    match opts do
    Opts(port, mc, it) -> do
      HttpServer.new(port)
      |> HttpServer.max_connections(mc)
      |> HttpServer.idle_timeout(it)
      |> HttpServer.plug(plug)
      |> HttpServer.listen()
    end
    end
  end

  doc """
  Start the server in a subprocess that handles exactly n requests, then exits.
  Returns an integer handle that can be passed to BastionServer.wait_for/1.
  Useful for integration tests — lets the test drive request count.
  """
  fn spawn_n(router : Router, opts : Opts, n : Int) : Int do
    match opts do
    Opts(port, mc, it) -> do
      let plug = Router.to_plug(router)
      HttpServer.new(port)
      |> HttpServer.max_connections(mc)
      |> HttpServer.idle_timeout(it)
      |> HttpServer.plug(plug)
      |> HttpServer.spawn_n(n)
    end
    end
  end

  doc "Wait for a server subprocess returned by spawn_n to exit."
  fn wait_for(handle : Int) : Unit do
    HttpServer.wait_for(handle)
  end

end
