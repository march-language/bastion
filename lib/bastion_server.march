-- BastionServer — convenience wrappers for starting a Bastion HTTP server.
--
-- Usage:
--
--   fn main() do
--     let router = build_router()
--     BastionServer.start(router, Bastion.default_opts(4000))
--   end

mod BastionServer do

  import HttpServer
  import Router
  import Bastion

  doc """
  Start the Bastion server with the given router and options.

  Converts the Router into an HttpServer plug and calls HttpServer.listen/1.
  Blocks the calling process until the server exits.

  Example:
    BastionServer.start(router, Bastion.default_opts(4000))
  """
  fn start(router : Router, opts) : Unit do
    let plug = Router.to_plug(router)
    HttpServer.new(opts_port(opts))
    |> HttpServer.max_connections(opts_max_connections(opts))
    |> HttpServer.idle_timeout(opts_idle_timeout(opts))
    |> HttpServer.plug(plug)
    |> HttpServer.listen()
  end

  doc """
  Start the server in a subprocess that handles exactly n requests, then exits.
  Returns an integer handle that can be passed to BastionServer.wait_for/1.
  Useful for integration tests — lets the test drive request count.
  """
  fn spawn_n(router : Router, opts, n : Int) : Int do
    let plug = Router.to_plug(router)
    HttpServer.new(opts_port(opts))
    |> HttpServer.max_connections(opts_max_connections(opts))
    |> HttpServer.idle_timeout(opts_idle_timeout(opts))
    |> HttpServer.plug(plug)
    |> HttpServer.spawn_n(n)
  end

  doc "Wait for a server subprocess returned by spawn_n to exit."
  fn wait_for(handle : Int) : Unit do
    HttpServer.wait_for(handle)
  end

end
