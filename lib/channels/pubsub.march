-- lib/pubsub.march — In-process publish/subscribe for Bastion.
--
-- PubSub provides topic-based broadcast within a single node.  It is the
-- delivery layer for Channel broadcasts and any other real-time fan-out the
-- framework or user code needs.
--
-- Subscriptions are stored in a Vault table keyed by "topic:sub_id".
-- The value is the send_fn callback.  To iterate all subs for a topic,
-- we use Vault.all() and filter by the topic prefix.
--
-- ── Usage ─────────────────────────────────────────────────────────────────────
--
--   -- Subscribe to a topic (typically done inside a WebSocket loop):
--   let sub_id = "conn:" ++ conn_id ++ ":" ++ topic
--   Bastion.PubSub.subscribe(topic, sub_id, fn event -> fn payload_json ->
--     WebSocket.send_frame(ws, TextFrame(make_frame(topic, event, payload_json)))
--   )
--
--   -- Broadcast from a channel handler:
--   Bastion.PubSub.broadcast("room:42", "message:new", "{\"body\":\"hello\"}")
--
--   -- Broadcast excluding the sender:
--   Bastion.PubSub.broadcast_from(conn_id, "room:42", "typing", "{}")

mod Bastion.PubSub do
  -- march main enforces the capability ceiling at codegen: a module's
  -- emitted code must stay within its own `needs`. Declared here so
  -- downstream projects can `forge build` against a current toolchain.
  needs IO.Mut

  -- Vault table: "topic:sub_id" → send_fn (String -> String -> ())
  let table_name = "_bastion_pubsub"

  -- ── Subscription management ───────────────────────────────────────────────

  doc """
  Subscribe to a topic with a delivery callback.

  sub_id    — unique string identifying this subscription (e.g. "conn:abc123:room:42")
  send_fn   — fn(event)(payload_json) called on each broadcast to this topic

  If sub_id is already subscribed, the old send_fn is replaced.
  """
  fn subscribe(topic : String, sub_id : String, send_fn) do
    let table = Vault.new(table_name)
    Vault.set(table, topic ++ ":" ++ sub_id, send_fn)
  end

  doc """
  Unsubscribe from a topic.  No-op if sub_id is not registered.
  """
  fn unsubscribe(topic : String, sub_id : String) do
    let table = Vault.new(table_name)
    Vault.drop(table, topic ++ ":" ++ sub_id)
  end

  doc """
  Remove all subscriptions held by a connection across every topic.
  Call this when a WebSocket connection closes to avoid stale send_fns.
  """
  fn unsubscribe_all(conn_id : String) do
    let table  = Vault.new(table_name)
    let all    = Vault.all(table)
    let prefix = "conn:" ++ conn_id ++ ":"
    List.each(all, fn pair ->
      let (key, _) = pair
      -- key format is "topic:sub_id" and sub_id starts with "conn:conn_id:"
      -- We need to check if the sub portion starts with the conn prefix
      -- sub_id is the part after the first colon sequence
      -- Simplest: store sub_id with no separator ambiguity
      -- key = topic ++ ":" ++ sub_id; sub_id contains "conn:" prefix
      -- We delete if the key contains ":" ++ prefix anywhere
      if String.contains(key, ":" ++ prefix) do
        Vault.drop(table, key)
      else ()
      end
    )
  end

  -- ── Broadcasting ──────────────────────────────────────────────────────────

  doc """
  Broadcast an event to all subscribers of a topic.

      Bastion.PubSub.broadcast("room:42", "message:new", "{\"body\":\"hi\"}")
  """
  fn broadcast(topic : String, event : String, payload_json : String) do
    deliver(topic, None, event, payload_json)
  end

  doc """
  Broadcast an event to all subscribers of a topic, excluding one subscriber.

      Bastion.PubSub.broadcast_from(sub_id, "room:42", "typing:start", "{}")
  """
  fn broadcast_from(exclude_sub_id : String, topic : String, event : String, payload_json : String) do
    deliver(topic, Some(exclude_sub_id), event, payload_json)
  end

  -- ── Internal delivery ─────────────────────────────────────────────────────

  pfn deliver(topic : String, exclude : Option(String), event : String, payload_json : String) do
    let table  = Vault.new(table_name)
    let all    = Vault.all(table)
    let prefix = topic ++ ":"
    let plen   = String.byte_size(prefix)
    List.each(all, fn pair ->
      let (key, send_fn) = pair
      let klen = String.byte_size(key)
      if klen > plen && String.slice_bytes(key, 0, plen) == prefix do
        let sub_id = String.slice_bytes(key, plen, klen - plen)
        let skip = match exclude do
          None    -> false
          Some(x) -> x == sub_id
        end
        if !skip do
          let _ = send_fn(event, payload_json)
          ()
        else ()
        end
      else ()
      end
    )
  end

  -- ── Introspection (useful for tests) ─────────────────────────────────────

  doc "Return the number of active subscribers for a topic."
  fn subscriber_count(topic : String) : Int do
    let table  = Vault.new(table_name)
    let all    = Vault.all(table)
    let prefix = topic ++ ":"
    let plen   = String.byte_size(prefix)
    List.length(List.filter(all, fn pair ->
      let (key, _) = pair
      let klen = String.byte_size(key)
      klen > plen && String.slice_bytes(key, 0, plen) == prefix
    ))
  end

  doc "Return true if any subscriber is registered for a topic."
  fn has_subscribers(topic : String) : Bool do
    subscriber_count(topic) > 0
  end

end
