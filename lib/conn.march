-- Bastion.Conn — higher-level helpers for the HttpServer.Conn type.
--
-- The underlying connection type is HttpServer.Conn.  This module adds
-- ergonomic shortcuts and parsed views on top of the raw accessors that
-- HttpServer already provides.
--
-- All functions in this module accept and return HttpServer.Conn values.
-- There is no separate Bastion.Conn type — this avoids duplicating the
-- transport-layer type and keeps conversion overhead at zero.

mod Conn do

  import HttpServer

  -- ── Request accessors ──────────────────────────────────────────────

  doc "Returns the HTTP method of the request (Get, Post, Put, …)."
  fn method(conn : Conn) : Atom do
    HttpServer.method(conn)
  end

  doc "Returns the raw request path string, e.g. \"/users/42\"."
  fn path(conn : Conn) : String do
    HttpServer.path(conn)
  end

  doc "Returns the path split on '/', empty segments filtered out."
  fn path_info(conn : Conn) : List(String) do
    HttpServer.path_info(conn)
  end

  doc "Returns the raw query string, e.g. \"page=1&limit=10\". Empty string if none."
  fn query_string(conn : Conn) : String do
    HttpServer.query_string(conn)
  end

  doc "Returns all request headers as a list of Header(name, value) values."
  fn req_headers(conn : Conn) : List(Header) do
    HttpServer.req_headers(conn)
  end

  doc "Returns the raw request body as a string."
  fn req_body(conn : Conn) : String do
    HttpServer.req_body(conn)
  end

  doc "Look up a request header by name (case-insensitive). Returns None if missing."
  fn get_req_header(conn : Conn, name : String) : Option(String) do
    HttpServer.get_req_header(conn, name)
  end

  doc """
  Returns the value of the Content-Type request header, if present.
  Equivalent to get_req_header(conn, \"content-type\").
  """
  fn content_type(conn : Conn) : Option(String) do
    HttpServer.get_req_header(conn, "content-type")
  end

  doc """
  Returns the value of the Accept request header, if present.
  """
  fn accept(conn : Conn) : Option(String) do
    HttpServer.get_req_header(conn, "accept")
  end

  -- ── Assigns ───────────────────────────────────────────────────────

  doc """
  Look up a value stored in conn's assigns map by key.
  Assigns are set by middleware or router param extraction.
  Returns None if the key is not present.
  """
  fn get_assign(conn : Conn, key : String) : Option(String) do
    HttpServer.get_assign(conn, key)
  end

  doc "Store a key/value pair in the conn's assigns map. Returns updated conn."
  fn assign(conn : Conn, key : String, value : String) : Conn do
    HttpServer.assign(conn, key, value)
  end

  -- ── Response state ────────────────────────────────────────────────

  doc "Returns the current response status code (0 means not yet set)."
  fn status(conn : Conn) : Int do
    HttpServer.status(conn)
  end

  doc "Returns all response headers accumulated so far."
  fn resp_headers(conn : Conn) : List(Header) do
    HttpServer.resp_headers(conn)
  end

  doc "Returns the response body string accumulated so far."
  fn resp_body(conn : Conn) : String do
    HttpServer.resp_body(conn)
  end

  doc "Returns true if the response has been sent (conn is halted)."
  fn halted(conn : Conn) : Bool do
    HttpServer.halted(conn)
  end

  -- ── Response mutations ────────────────────────────────────────────

  doc "Add a response header. Returns updated conn."
  fn put_resp_header(conn : Conn, name : String, value : String) : Conn do
    HttpServer.put_resp_header(conn, name, value)
  end

  doc """
  Set the response status and body, and mark the conn as halted.
  After send_resp the pipeline stops processing further plugs.
  """
  fn send_resp(conn : Conn, status : Int, body : String) : Conn do
    HttpServer.send_resp(conn, status, body)
  end

  doc "Halt the conn without setting a response (used by auth middleware to short-circuit)."
  fn halt(conn : Conn) : Conn do
    HttpServer.halt(conn)
  end

  -- ── Cookie accessors ──────────────────────────────────────────────────

  doc """
  Look up a cookie value from the request Cookie header by name.

  Returns None if the cookie is not present.

      Conn.get_req_cookie(conn, "_session")  -- Some("...") or None
  """
  fn get_req_cookie(conn : Conn, name : String) : Option(String) do
    match HttpServer.get_req_header(conn, "cookie") do
    None    -> None
    Some(v) -> find_cookie(String.split(v, "; "), name)
    end
  end

  doc """
  Add a Set-Cookie response header.

  `name` and `value` are the cookie name/value.  `opts` is a list of
  (attribute, value) pairs — e.g. [("Path", "/"), ("HttpOnly", ""), ("SameSite", "Lax")].
  A value of "" renders the attribute as a flag with no `=`.

  Example:
    Conn.put_resp_cookie(conn, "_session", signed_value,
      [("Path", "/"), ("HttpOnly", ""), ("SameSite", "Lax"), ("Max-Age", "604800")])
  """
  fn put_resp_cookie(conn : Conn, name : String, value : String, opts : List((String, String))) : Conn do
    let cookie = build_cookie(name, value, opts)
    HttpServer.put_resp_header(conn, "set-cookie", cookie)
  end

  doc """
  Delete a cookie by setting it with an expired Max-Age.

      Conn.delete_resp_cookie(conn, "_session")
  """
  fn delete_resp_cookie(conn : Conn, name : String) : Conn do
    put_resp_cookie(conn, name, "", [("Path", "/"), ("Max-Age", "0"), ("HttpOnly", ""), ("SameSite", "Lax")])
  end

  -- ── After-send hooks ──────────────────────────────────────────────────
  --
  -- After-send callbacks are identified by string keys stored in assigns
  -- under "_after_send_hooks".  The server calls Conn.run_after_send/1
  -- after the response is sent.  Hooks are dispatched by key — the caller
  -- registers a well-known key and the server resolves it.
  --
  -- Built-in hook keys understood by BastionServer:
  --   "session_commit"  — writes the session cookie (registered by Session.load)

  doc """
  Register a named after-send hook.  The hook is identified by a string key
  that the server resolves to a function.

  Multiple hooks can be registered; they are stored as a comma-separated list.

      Conn.register_after_send(conn, "session_commit")
  """
  fn register_after_send(conn : Conn, hook_key : String) : Conn do
    let current = match HttpServer.get_assign(conn, "_after_send_hooks") do
      Some(v) -> v
      None    -> ""
      end
    let updated = if String.is_empty(current) do hook_key
                  else current ++ "," ++ hook_key
                  end
    HttpServer.assign(conn, "_after_send_hooks", updated)
  end

  doc """
  Return the list of registered after-send hook keys.

  Called by BastionServer after send_resp to dispatch the hooks.
  """
  fn after_send_hooks(conn : Conn) : List(String) do
    match HttpServer.get_assign(conn, "_after_send_hooks") do
    None    -> []
    Some(v) ->
      if String.is_empty(v) do []
      else String.split(v, ",")
      end
    end
  end

  -- ── Form param helper ─────────────────────────────────────────────────

  doc """
  Look up a single URL-encoded form body parameter by name.

  Parses the request body as application/x-www-form-urlencoded.
  Returns None if the param is not present.

      Conn.get_form_param(conn, "email")  -- Some("me@example.com") or None
  """
  fn get_form_param(conn : Conn, key : String) : Option(String) do
    let body = HttpServer.req_body(conn)
    find_param(String.split(body, "&"), key)
  end

  -- ── Internal helpers ──────────────────────────────────────────────────

  pfn find_cookie(pairs : List(String), name : String) : Option(String) do
    match pairs do
    Nil -> None
    Cons(pair, rest) ->
      match String.split_first(pair, "=") do
      Some((k, v)) ->
        if String.trim(k) == name do Some(v)
        else find_cookie(rest, name)
        end
      None -> find_cookie(rest, name)
      end
    end
  end

  pfn build_cookie(name : String, value : String, opts : List((String, String))) : String do
    let base = name ++ "=" ++ value
    let attrs = String.join(List.map(opts, fn (k, v) ->
      if String.is_empty(v) do "; " ++ k
      else "; " ++ k ++ "=" ++ v
      end
    ), "")
    base ++ attrs
  end

  pfn find_param(pairs : List(String), key : String) : Option(String) do
    match pairs do
    Nil -> None
    Cons(pair, rest) ->
      match String.split_first(pair, "=") do
      Some((k, v)) ->
        if k == key do Some(v)
        else find_param(rest, key)
        end
      None -> find_param(rest, key)
      end
    end
  end

end
