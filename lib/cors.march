-- lib/cors.march — Cors
--
-- CORS (Cross-Origin Resource Sharing) middleware for Bastion.
-- Off by default — call Cors.allow/2 only on routes that need it.
--
-- Usage in your router:
--
--   -- Apply CORS to all API routes
--   fn route(conn, method, Cons("api", rest)) do
--     conn
--     |> Cors.allow(Cors.config(["https://frontend.myapp.com"]))
--     |> MyApp.API.route(method, rest)
--   end
--
--   -- Handle OPTIONS preflight for API routes
--   fn route(conn, :options, Cons("api", _)) do
--     conn
--     |> Cors.allow(Cors.config(["https://frontend.myapp.com"]))
--     |> HttpServer.send_resp(204, "")
--   end
--
-- For wildcard origins (development or public APIs):
--
--   conn |> Cors.allow(Cors.config_open())
--
-- For credentialed requests (cookies / Authorization header):
--
--   conn |> Cors.allow(Cors.config_credentialed(["https://frontend.myapp.com"]))

mod Cors do

  import HttpServer

  -- ── Config type ─────────────────────────────────────────────────────────────

  -- CORS configuration record.
  --
  -- Fields:
  --   origins      : List(String)  — allowed origins; ["*"] for open APIs
  --   methods      : List(String)  — allowed HTTP methods ("GET", "POST", etc.)
  --   headers      : List(String)  — allowed request headers
  --   expose       : List(String)  — response headers to expose to the browser
  --   max_age      : Int           — preflight cache seconds (0 = no cache header)
  --   credentials  : Bool          — whether to allow credentials (cookies, auth)
  --
  -- Use Cors.config/1, Cors.config_open/0, or Cors.config_credentialed/1
  -- instead of building this record directly.
  type CorsConfig = {
    origins     : List(String),
    methods     : List(String),
    headers     : List(String),
    expose      : List(String),
    max_age     : Int,
    credentials : Bool
  }

  -- ── Config constructors ──────────────────────────────────────────────────────

  doc """
  Build a basic CORS config for the given origins list.
  Default methods: GET, POST, PUT, PATCH, DELETE, OPTIONS.
  Default request headers: content-type, authorization.
  No credentials (cookies not sent cross-origin).

      Cors.config(["https://frontend.myapp.com", "https://staging.myapp.com"])
  """
  fn config(origins) do
    {
      origins     = origins,
      methods     = ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      headers     = ["content-type", "authorization"],
      expose      = [],
      max_age     = 86400,
      credentials = false
    }
  end

  doc """
  Open CORS config (wildcard origin). Suitable for fully public APIs.
  Credentials are disabled (not allowed with wildcard origin per the spec).

      conn |> Cors.allow(Cors.config_open())
  """
  fn config_open() do
    {
      origins     = ["*"],
      methods     = ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      headers     = ["content-type", "authorization"],
      expose      = [],
      max_age     = 86400,
      credentials = false
    }
  end

  doc """
  Credentialed CORS config for the given origins.
  Allows cookies and Authorization headers cross-origin.
  Wildcard origins are not allowed with credentials=true per the spec;
  always pass explicit origins.

      Cors.config_credentialed(["https://app.myapp.com"])
  """
  fn config_credentialed(origins) do
    {
      origins     = origins,
      methods     = ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      headers     = ["content-type", "authorization"],
      expose      = [],
      max_age     = 86400,
      credentials = true
    }
  end

  -- ── Middleware ───────────────────────────────────────────────────────────────

  doc """
  Apply CORS headers to the response based on the config.

  For simple requests: sets Access-Control-Allow-Origin (if request Origin
  matches), Access-Control-Allow-Credentials, and any exposed headers.

  For preflight (OPTIONS) requests: also sets Access-Control-Allow-Methods,
  Access-Control-Allow-Headers, and Access-Control-Max-Age. The caller is
  responsible for sending the 204 response for preflight routes.

  If the request has no Origin header, or the origin is not in the allowed
  list, no CORS headers are added (the request is treated as same-origin).

      conn |> Cors.allow(Cors.config(["https://frontend.myapp.com"]))
  """
  fn allow(conn, cfg) do
    match Conn.get_req_header(conn, "origin") do
    None         -> conn   -- no Origin header; same-origin request, skip
    Some(origin) ->
      if is_valid_origin_format(origin) && is_origin_allowed(origin, cfg.origins) do
        let conn2 = set_origin_header(conn, origin, cfg.origins, cfg.credentials)
        let conn3 = set_expose_headers(conn2, cfg.expose)
        let conn4 = match HttpServer.method(conn3) do
          :options -> set_preflight_headers(conn3, cfg)
          _        -> conn3
          end
        conn4
      else
        conn   -- origin not allowed; no CORS headers
      end
    end
  end

  -- ── Private helpers ──────────────────────────────────────────────────────────

  -- Validate that an Origin header value is structurally a web origin
  -- (scheme://host[:port]) before it can be reflected into a response
  -- header.  A serialized origin never contains a path, query, fragment,
  -- userinfo, whitespace, or control characters — reject anything that
  -- does so a malformed or hostile value is never echoed back, even when
  -- the allow-list contains "*".
  pfn is_valid_origin_format(origin : String) : Bool do
    let host = match scheme_host(origin) do
      Some(h) -> h
      None    -> ""
      end
    if String.is_empty(host) do false
    else
      String.byte_size(origin) <= 256 &&
      all_host_chars(string_chars(host))
    end
  end

  -- Strip a recognised scheme prefix, returning the host[:port] part.
  pfn scheme_host(origin : String) : Option(String) do
    if String.starts_with(origin, "https://") do
      Some(String.slice_bytes(origin, 8, String.byte_size(origin) - 8))
    else if String.starts_with(origin, "http://") do
      Some(String.slice_bytes(origin, 7, String.byte_size(origin) - 7))
    else
      None
    end end
  end

  -- host[:port] may contain only letters, digits, ".", "-", ":" (port
  -- separator), and "[" / "]" (IPv6 literals).
  pfn all_host_chars(cs : List(String)) : Bool do
    match cs do
    Nil -> true
    Cons(c, rest) ->
      let ok = char_is_alphanumeric(c) || c == "." || c == "-" ||
               c == ":" || c == "[" || c == "]"
      if ok do all_host_chars(rest) else false end
    end
  end

  pfn is_origin_allowed(origin, allowed) do
    match allowed do
    Nil               -> false
    Cons("*", _)      -> true
    Cons(h, rest)     ->
      if h == origin do true
      else is_origin_allowed(origin, rest)
      end
    end
  end

  pfn set_origin_header(conn, origin, allowed_origins, credentials) do
    -- If wildcard and no credentials, set "*"; otherwise echo the specific origin
    let allow_value = match allowed_origins do
      Cons("*", Nil) ->
        if credentials do origin  -- must echo origin when credentials=true
        else "*"
        end
      _ -> origin
    end
    let conn2 = HttpServer.put_resp_header(conn, "access-control-allow-origin", allow_value)
    -- Vary: Origin so caches key correctly when reflecting specific origins
    let conn3 = match allowed_origins do
      Cons("*", Nil) -> conn2
      _              -> HttpServer.put_resp_header(conn2, "vary", "Origin")
      end
    if credentials do
      HttpServer.put_resp_header(conn3, "access-control-allow-credentials", "true")
    else
      conn3
    end
  end

  pfn set_expose_headers(conn, expose) do
    match expose do
    Nil -> conn
    _   ->
      let value = join_strings(expose, ", ")
      HttpServer.put_resp_header(conn, "access-control-expose-headers", value)
    end
  end

  pfn set_preflight_headers(conn, cfg) do
    let methods_str = join_strings(cfg.methods, ", ")
    let headers_str = join_strings(cfg.headers, ", ")
    let conn2 = HttpServer.put_resp_header(conn, "access-control-allow-methods", methods_str)
    let conn3 = HttpServer.put_resp_header(conn2, "access-control-allow-headers", headers_str)
    if cfg.max_age > 0 do
      HttpServer.put_resp_header(conn3, "access-control-max-age", int_to_string(cfg.max_age))
    else
      conn3
    end
  end

  pfn join_strings(lst, sep) do
    match lst do
    Nil           -> ""
    Cons(h, rest) -> join_strings_acc(rest, sep, h)
    end
  end

  pfn join_strings_acc(lst, sep, acc) do
    match lst do
    Nil           -> acc
    Cons(h, rest) -> join_strings_acc(rest, sep, acc ++ sep ++ h)
    end
  end

end
