-- Bastion.ErrorOverlay — dev-mode error overlay with in-browser crash REPL.
--
-- Provides:
--   1. `rescue_errors/1` plug — wraps the rest of the pipeline in a panic
--      handler; on unhandled error renders a rich HTML error page (dev only).
--   2. Crash REPL — each error page connects via WebSocket to a per-crash
--      March REPL session at /_bastion/debug/:session_id.  Variables from the
--      crash context are injected so you can inspect state interactively.
--   3. `router_plug/1` — mounts the debug WebSocket endpoint; call from your
--      router when `Bastion.Dev.dev_env?()` is true.
--
-- IMPORTANT: Never use this module in production.  The crash REPL exposes
-- arbitrary code execution in the server process.
--
-- Typical setup in your router:
--
--   import Bastion.ErrorOverlay
--   import Bastion.Dev
--
--   -- In your pipeline:
--   conn
--   |> (if dev_env?() do rescue_errors else fn c -> c end end)()
--   |> ...rest of pipeline...
--
--   -- Mount the debug WebSocket (dev only):
--   if dev_env?() do
--     conn |> ErrorOverlay.router_plug()
--   else conn end

mod Bastion.ErrorOverlay do

  import Bastion.Dev
  import Vault

-- ---------------------------------------------------------------------------
-- Public API
-- ---------------------------------------------------------------------------

doc """
Wrap the next pipeline step in error recovery.  On panic/exception, renders
the dev error overlay HTML page and stores a crash session for the REPL.

Only intended for use when `Bastion.Dev.dev_env?()` is true.

    conn |> Bastion.ErrorOverlay.rescue_errors()
"""
fn rescue_errors(conn) do
  match HttpServer.try_call(conn) do
  Ok(conn2)     -> conn2
  Err(err_info) -> render_error_page(conn, err_info)
  end
end

doc """
Handle a WebSocket connection to the crash-site REPL.
Called by `router_plug/1` when the path matches /_bastion/debug/:session_id.

    conn |> Bastion.ErrorOverlay.debug_socket(session_id)
"""
fn debug_socket(conn, session_id : String) do
  match Vault.get(:_bastion_debug_sessions, session_id) do
  None ->
    HttpServer.send_resp(conn, 404, "text/plain", "Debug session not found or expired")
  Some(crash_ctx) ->
    let conn2 = WebSocket.upgrade(conn)
    debug_repl_loop(conn2, session_id, crash_ctx, March.Repl.start_session(crash_bindings(crash_ctx)))
  end
end

doc """
Route plug: intercept /_bastion/debug/:id WebSocket requests.
Mount this in your router (dev only).

    conn |> Bastion.ErrorOverlay.router_plug()
"""
fn router_plug(conn) do
  let path = HttpServer.request_path(conn)
  let prefix = "/_bastion/debug/"
  if String.starts_with(path, prefix) do
    let session_id = String.slice_bytes(path, String.byte_size(prefix),
                       String.byte_size(path) - String.byte_size(prefix))
    debug_socket(conn, session_id)
  else conn end
end

-- ---------------------------------------------------------------------------
-- Crash context + REPL session
-- ---------------------------------------------------------------------------

-- Build the initial REPL bindings from a crash context.
-- Injects the conn, the error, and any captured request parameters.
pfn crash_bindings(crash_ctx) do
  match crash_ctx do
  {conn = c, error = e, params = p, assigns = a} ->
    Cons(("conn",    c),
    Cons(("error",   e),
    Cons(("params",  p),
    Cons(("assigns", a),
    Nil))))
  _ -> Nil
  end
end

-- REPL loop over a WebSocket connection.  Reads lines of March code from the
-- client, evaluates them in the session, sends results back.
pfn debug_repl_loop(conn, session_id : String, crash_ctx, repl_session) do
  match WebSocket.recv_frame(conn) do
  TextFrame(input) -> do
    let trimmed = String.trim(input)
    if trimmed == ":quit" || trimmed == ":exit" do
      let _ = WebSocket.send_frame(conn, TextFrame(repl_json("info", "Session closed.")))
      let _ = Vault.delete(:_bastion_debug_sessions, session_id)
      ()
    else
      let result = March.Repl.eval(repl_session, trimmed)
      let (output, new_session) = match result do
        Ok((value_str, sess2)) -> (repl_json("ok",    value_str), sess2)
        Err((msg,      sess2)) -> (repl_json("error", msg),       sess2)
        end
      let _ = WebSocket.send_frame(conn, TextFrame(output))
      debug_repl_loop(conn, session_id, crash_ctx, new_session)
    end
  end
  Close(_, _) -> do
    let _ = March.Repl.stop_session(repl_session)
    ()
  end
  _ -> debug_repl_loop(conn, session_id, crash_ctx, repl_session)
  end
end

pfn repl_json(tag : String, content : String) : String do
  "{\"type\":\"" ++ tag ++ "\",\"value\":" ++ Json.encode_string(content) ++ "}"
end

-- ---------------------------------------------------------------------------
-- Error page rendering
-- ---------------------------------------------------------------------------

pfn render_error_page(conn, err_info) do
  let session_id  = Crypto.generate_token(16)
  let crash_ctx   = build_crash_ctx(conn, err_info)
  let _           = Vault.put_ttl(:_bastion_debug_sessions, session_id, crash_ctx, 3600)
  let html        = error_page_html(err_info, session_id)
  HttpServer.send_resp(conn, 500, "text/html; charset=utf-8", html)
end

pfn build_crash_ctx(conn, err_info) do
  {
    conn    = conn,
    error   = err_info,
    params  = HttpServer.params(conn),
    assigns = HttpServer.assigns(conn),
  }
end

-- ---------------------------------------------------------------------------
-- Error page HTML
-- ---------------------------------------------------------------------------

pfn error_page_html(err_info, session_id : String) : String do
  let msg        = HttpServer.error_message(err_info)
  let stack      = HttpServer.error_stacktrace(err_info)
  let stack_html = format_stacktrace(stack)
  "<!DOCTYPE html>\n" ++
  "<html lang=\"en\">\n" ++
  "<head>\n" ++
  "  <meta charset=\"UTF-8\">\n" ++
  "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" ++
  "  <title>Error — Bastion Dev Overlay</title>\n" ++
  "  <style>" ++ overlay_css() ++ "</style>\n" ++
  "</head>\n" ++
  "<body>\n" ++
  "  <div class=\"overlay\">\n" ++
  "    <header>\n" ++
  "      <span class=\"badge\">RuntimeError</span>\n" ++
  "      <h1 class=\"message\">" ++ Html.escape(msg) ++ "</h1>\n" ++
  "    </header>\n" ++
  "    <section class=\"stacktrace\">\n" ++
  "      <h2>Stack Trace</h2>\n" ++
  "      <ol class=\"frames\">" ++ stack_html ++ "</ol>\n" ++
  "    </section>\n" ++
  "    <section class=\"repl\">\n" ++
  "      <h2>Crash REPL\n" ++
  "        <span class=\"hint\">evaluate March expressions in the crash context</span>\n" ++
  "      </h2>\n" ++
  "      <div class=\"repl-output\" id=\"repl-output\"></div>\n" ++
  "      <form class=\"repl-input-form\" id=\"repl-form\">\n" ++
  "        <span class=\"prompt\">iex&gt;</span>\n" ++
  "        <input type=\"text\" id=\"repl-input\" autocomplete=\"off\"\n" ++
  "               placeholder=\"conn.method  |  params  |  Vault.all(:my_table)\" />\n" ++
  "        <button type=\"submit\">Run</button>\n" ++
  "      </form>\n" ++
  "    </section>\n" ++
  "    <section class=\"request-info\">\n" ++
  "      <h2>Request</h2>\n" ++
  "      <dl id=\"req-info\"></dl>\n" ++
  "    </section>\n" ++
  "  </div>\n" ++
  "  <script>" ++ overlay_js(session_id) ++ "</script>\n" ++
  "</body>\n" ++
  "</html>\n"
end

pfn format_stacktrace(frames) : String do
  fn go(fs, acc) do
    match fs do
    Nil -> acc
    Cons(frame, rest) ->
      go(rest, acc ++ "<li class=\"frame\">" ++
        "<span class=\"fn-name\">" ++ Html.escape(frame.fn_name) ++ "</span>" ++
        "<span class=\"location\">" ++ Html.escape(frame.file) ++
        ":" ++ int_to_string(frame.line) ++ "</span>" ++
        "</li>")
    end
  end
  go(frames, "")
end

-- ---------------------------------------------------------------------------
-- Static assets (inlined)
-- ---------------------------------------------------------------------------

pfn overlay_css() : String do
  "* { box-sizing: border-box; margin: 0; padding: 0; }" ++
  "body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;" ++
  "       background: #0f0f10; color: #e2e8f0; min-height: 100vh; }" ++
  ".overlay { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }" ++
  "header { border-left: 4px solid #e53e3e; padding-left: 1rem; margin-bottom: 2rem; }" ++
  ".badge { background: #e53e3e; color: #fff; font-size: .75rem; font-weight: 700;" ++
  "         padding: .2rem .5rem; border-radius: 4px; text-transform: uppercase; }" ++
  "h1.message { font-size: 1.4rem; font-weight: 600; margin-top: .5rem;" ++
  "             color: #fed7d7; word-break: break-word; }" ++
  "section { margin-bottom: 2rem; }" ++
  "h2 { font-size: .85rem; text-transform: uppercase; letter-spacing: .08em;" ++
  "     color: #718096; margin-bottom: .75rem; display: flex; align-items: center; gap: .5rem; }" ++
  ".hint { font-size: .8rem; color: #4a5568; text-transform: none; letter-spacing: 0; }" ++
  ".frames { list-style: none; counter-reset: frame; border: 1px solid #2d3748;" ++
  "          border-radius: 6px; overflow: hidden; }" ++
  ".frame { counter-increment: frame; display: flex; align-items: baseline; gap: .75rem;" ++
  "         padding: .6rem .9rem; border-bottom: 1px solid #2d3748; }" ++
  ".frame:last-child { border-bottom: none; }" ++
  ".frame::before { content: counter(frame); color: #4a5568; font-size: .75rem;" ++
  "                 min-width: 1.5rem; }" ++
  ".fn-name { font-family: monospace; color: #90cdf4; font-size: .9rem; flex: 1; }" ++
  ".location { font-family: monospace; font-size: .8rem; color: #718096; }" ++
  ".repl-output { font-family: monospace; font-size: .9rem; background: #1a202c;" ++
  "               border: 1px solid #2d3748; border-radius: 6px 6px 0 0;" ++
  "               min-height: 120px; max-height: 320px; overflow-y: auto;" ++
  "               padding: .75rem; }" ++
  ".repl-line { margin-bottom: .25rem; }" ++
  ".repl-line.ok    { color: #68d391; }" ++
  ".repl-line.error { color: #fc8181; }" ++
  ".repl-line.info  { color: #90cdf4; }" ++
  ".repl-line.input { color: #cbd5e0; }" ++
  ".repl-input-form { display: flex; align-items: center; background: #1a202c;" ++
  "                   border: 1px solid #2d3748; border-top: none; border-radius: 0 0 6px 6px;" ++
  "                   padding: .5rem .75rem; gap: .5rem; }" ++
  ".prompt { color: #68d391; font-family: monospace; font-weight: 700; }" ++
  "#repl-input { flex: 1; background: transparent; border: none; outline: none;" ++
  "              color: #e2e8f0; font-family: monospace; font-size: .9rem; }" ++
  "button { background: #2d3748; color: #e2e8f0; border: none; border-radius: 4px;" ++
  "         padding: .3rem .7rem; cursor: pointer; font-size: .85rem; }" ++
  "button:hover { background: #4a5568; }" ++
  "dl { display: grid; grid-template-columns: max-content 1fr; gap: .3rem .75rem;" ++
  "     font-size: .9rem; }" ++
  "dt { color: #718096; }" ++
  "dd { font-family: monospace; word-break: break-all; color: #e2e8f0; }"
end

pfn overlay_js(session_id : String) : String do
  "const SID = " ++ Json.encode_string(session_id) ++ ";\n" ++
  "const output = document.getElementById('repl-output');\n" ++
  "const form   = document.getElementById('repl-form');\n" ++
  "const input  = document.getElementById('repl-input');\n" ++
  "const ws     = new WebSocket(`ws://${location.host}/_bastion/debug/${SID}`);\n" ++
  "const history = []; let histIdx = -1;\n" ++
  "\n" ++
  "function appendLine(cls, text) {\n" ++
  "  const el = document.createElement('div');\n" ++
  "  el.className = 'repl-line ' + cls;\n" ++
  "  el.textContent = text;\n" ++
  "  output.appendChild(el);\n" ++
  "  output.scrollTop = output.scrollHeight;\n" ++
  "}\n" ++
  "\n" ++
  "ws.onopen    = () => appendLine('info', '-- Connected. Type :quit to exit.');\n" ++
  "ws.onclose   = () => appendLine('info', '-- Session closed.');\n" ++
  "ws.onmessage = (e) => {\n" ++
  "  const msg = JSON.parse(e.data);\n" ++
  "  appendLine(msg.type === 'ok' ? 'ok' : msg.type === 'error' ? 'error' : 'info', msg.value);\n" ++
  "};\n" ++
  "\n" ++
  "form.addEventListener('submit', (e) => {\n" ++
  "  e.preventDefault();\n" ++
  "  const code = input.value.trim();\n" ++
  "  if (!code) return;\n" ++
  "  appendLine('input', 'iex> ' + code);\n" ++
  "  ws.send(code);\n" ++
  "  history.unshift(code); histIdx = -1;\n" ++
  "  input.value = '';\n" ++
  "});\n" ++
  "\n" ++
  "input.addEventListener('keydown', (e) => {\n" ++
  "  if (e.key === 'ArrowUp')   { histIdx = Math.min(histIdx + 1, history.length - 1); input.value = history[histIdx] || ''; e.preventDefault(); }\n" ++
  "  if (e.key === 'ArrowDown') { histIdx = Math.max(histIdx - 1, -1); input.value = histIdx < 0 ? '' : history[histIdx]; e.preventDefault(); }\n" ++
  "});\n" ++
  "\n" ++
  "// Populate request info\n" ++
  "fetch('/_bastion/debug/' + SID + '/info')\n" ++
  "  .then(r => r.json()).then(info => {\n" ++
  "    const dl = document.getElementById('req-info');\n" ++
  "    Object.entries(info).forEach(([k, v]) => {\n" ++
  "      const dt = document.createElement('dt'); dt.textContent = k;\n" ++
  "      const dd = document.createElement('dd'); dd.textContent = v;\n" ++
  "      dl.appendChild(dt); dl.appendChild(dd);\n" ++
  "    });\n" ++
  "  }).catch(() => {});\n" ++
  "\n" ++
  "input.focus();"
end

end -- mod Bastion.ErrorOverlay
