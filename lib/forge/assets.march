-- Forge.Assets — forge assets build / deploy / watch
--
-- Shells out to esbuild to bundle the assets in assets/ into
-- priv/static/assets/.
--
--   build   — dev bundle: sourcemaps, no minification
--   deploy  — prod bundle: minified + content-hash fingerprinting, writes manifest
--   watch   — runs esbuild in --watch mode (for use alongside forge bastion server)
--
-- Directory conventions (relative to project root):
--   assets/js/app.js              JS entry point (may import CSS)
--   assets/css/app.css            CSS entry point
--   priv/static/assets/           output directory (gitignored)
--   priv/static/assets/manifest.json  digest manifest (deploy only)
--
-- esbuild must be on PATH.  Install with:
--   npm install -g esbuild    OR    brew install esbuild
--
-- Ported from cmd_assets.ml.

mod Forge.Assets do

  needs IO.Console

-- ── Helpers ──────────────────────────────────────────────────────────────────

-- List all regular files immediately inside dir (non-recursive).
pfn readdir_files(dir) do
  match Dir.list(dir) do
  Ok(entries) ->
    List.filter(entries, fn name -> do
      let p = dir ++ "/" ++ name
      File.exists(p) && !Dir.exists(p)
    end)
  Err(_) -> []
  end
end

-- Locate esbuild in PATH.
pfn find_esbuild() do
  let path_dirs = match Process.env("PATH") do
    None    -> ["/usr/local/bin", "/usr/bin", "/bin"]
    Some(p) -> String.split(p, ":")
  end
  match List.filter_map(path_dirs, fn d -> do
    let candidate = d ++ "/esbuild"
    if File.exists(candidate) do Some(candidate) else None end
  end) do
  Nil ->
    Err("esbuild not found in PATH.\nInstall it with one of:\n  npm install -g esbuild\n  brew install esbuild")
  Cons(exe, _) -> Ok(exe)
  end
end

-- 8-hex-char fingerprint using sha256.  Good enough for cache-busting.
pfn fingerprint_file(filepath) do
  let cmd = "sha256sum 2>/dev/null \"" ++ filepath ++ "\" || shasum -a 256 \"" ++ filepath ++ "\""
  match Process.run("sh", ["-c", cmd]) do
  Ok(r) ->
    let out = String.trim(Process.stdout(r))
    String.slice_bytes(out, 0, 8)
  Err(_) -> "00000000"
  end
end

-- Ensure priv/static/assets/ exists.
pfn ensure_output_dir(root) do
  let _ = Dir.mkdir_p(root ++ "/priv/static/assets")
  ()
end

-- Build the esbuild command from entry points, flags, and output directory.
pfn esbuild_cmd(esbuild_exe, root, extra_flags) do
  let js_entry  = root ++ "/assets/js/app.js"
  let css_entry = root ++ "/assets/css/app.css"
  let out_dir   = root ++ "/priv/static/assets"
  let entries = List.filter_map([js_entry, css_entry], fn p -> do
    if File.exists(p) do Some(p) else None end
  end)
  if List.is_empty(entries) do
    Err("No entry points found. Expected assets/js/app.js or assets/css/app.css")
  else
    let entry_str = String.join(entries, " ")
    let cmd = esbuild_exe ++ " " ++ entry_str
             ++ " --bundle --outdir=" ++ out_dir
             ++ " " ++ extra_flags
    Ok(cmd)
  end
end

-- ── Digest (deploy only) ──────────────────────────────────────────────────────

-- Fingerprint all output files, rename them with a hash suffix, and write
-- priv/static/assets/manifest.json.
-- The manifest maps logical names (e.g. "app.js") to digested names
-- (e.g. "app-a1b2c3d4.js").
pfn digest_assets(root) do
  let assets_dir = root ++ "/priv/static/assets"
  let files = readdir_files(assets_dir)
    |> List.filter(fn f -> f != "manifest.json")
  let manifest_entries = List.filter_map(files, fn filename -> do
    let filepath = assets_dir ++ "/" ++ filename
    let hash     = fingerprint_file(filepath)
    let ext      = Path.extension(filename)
    let stem     = Path.strip_extension(filename)
    let ext_str  = if String.is_empty(ext) do "" else "." ++ ext end
    let hashed   = stem ++ "-" ++ hash ++ ext_str
    let hashed_p = assets_dir ++ "/" ++ hashed
    match File.rename(filepath, hashed_p) do
    Ok(_)  -> Some((filename, hashed))
    Err(e) ->
      println("warning: could not rename " ++ filename ++ ": " ++ to_string(e))
      Some((filename, hashed))
    end
  end)
  -- Write manifest.json
  let manifest_path = assets_dir ++ "/manifest.json"
  let pairs = List.map(manifest_entries, fn entry -> do
    let (k, v) = entry
    "  \"" ++ k ++ "\": \"" ++ v ++ "\""
  end)
  let content = "{\n" ++ String.join(pairs, ",\n") ++ "\n}\n"
  let _ = File.write(manifest_path, content)
  let count = List.length(manifest_entries)
  let entry_word = if count == 1 do "entry" else "entries" end
  println("wrote " ++ manifest_path ++ " (" ++ String.from_int(count) ++ " " ++ entry_word ++ ")")
  let _ = List.map(manifest_entries, fn entry -> do
    let (k, v) = entry
    println("  " ++ k ++ " -> " ++ v)
  end)
end

-- ── Public commands ───────────────────────────────────────────────────────────

doc "forge assets build — dev bundle with sourcemaps, no minification."
fn build() : Result((), String) do
  match Forge.Project.load() do
  Err(msg) -> Err(msg)
  Ok(proj) ->
    let root = proj.root
    ensure_output_dir(root)
    with Ok(esbuild) <- find_esbuild(),
         Ok(cmd)     <- esbuild_cmd(esbuild, root, "--sourcemap") do
      println("--> forge assets build\n    " ++ cmd)
      match Process.run("sh", ["-c", cmd]) do
      Ok(r) ->
        if Process.exit_code(r) == 0 do
          println("--> assets built successfully.")
          Ok(())
        else
          Err("esbuild failed:\n" ++ Process.stderr(r))
        end
      Err(e) -> Err("esbuild failed: " ++ e)
      end
    else
      Err(e) -> Err(e)
    end
  end
end

doc "forge assets deploy — prod bundle: minified + digest fingerprinting."
fn deploy() do
  match Forge.Project.load() do
  Err(msg) -> Err(msg)
  Ok(proj) ->
    let root = proj.root
    ensure_output_dir(root)
    with Ok(esbuild) <- find_esbuild(),
         Ok(cmd)     <- esbuild_cmd(esbuild, root, "--minify --sourcemap=external") do
      println("--> forge assets deploy\n    " ++ cmd)
      match Process.run("sh", ["-c", cmd]) do
      Ok(r) ->
        if Process.exit_code(r) == 0 do
          println("--> bundling complete, fingerprinting...")
          digest_assets(root)
          println("--> assets deployed successfully.")
          Ok(())
        else
          Err("esbuild failed:\n" ++ Process.stderr(r))
        end
      Err(e) -> Err("esbuild failed: " ++ e)
      end
    else
      Err(e) -> Err(e)
    end
  end
end

doc "forge assets watch — rebuild on file changes (dev mode)."
fn watch() do
  match Forge.Project.load() do
  Err(msg) -> Err(msg)
  Ok(proj) ->
    let root = proj.root
    ensure_output_dir(root)
    with Ok(esbuild) <- find_esbuild(),
         Ok(cmd)     <- esbuild_cmd(esbuild, root, "--sourcemap --watch") do
      println("--> forge assets watch (press Ctrl+C to stop)\n    " ++ cmd)
      match Process.run("sh", ["-c", cmd]) do
      Ok(_) -> Ok(())
      Err(e) -> Err("esbuild failed: " ++ e)
      end
    else
      Err(e) -> Err(e)
    end
  end
end

fn main() do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  match args do
  Nil -> do
    println("Usage: forge bastion.assets <command>")
    println("  build   — dev bundle (sourcemaps, no minification)")
    println("  deploy  — prod bundle (minified + content-hash manifest)")
    println("  watch   — rebuild on file changes")
  end
  Cons(cmd, _) ->
    let _ = if cmd == "build" do build()
            else if cmd == "deploy" do deploy()
            else if cmd == "watch" do watch()
            else do
              println("Unknown assets command: " ++ cmd)
              Err("unknown command: " ++ cmd)
            end end end end
    ()
  end
end

end
