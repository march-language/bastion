-- Forge.Console — forge bastion.console
--
-- Starts an interactive March REPL with the application fully loaded.
-- Analogous to `iex -S mix` (Elixir) or `rails console` (Rails).
--
-- Usage:
--   forge bastion.console              # start REPL, no HTTP server
--   forge bastion.console --server     # start REPL + HTTP server together
--
-- The REPL session has access to all compiled app modules, running Vault
-- tables, and (with --server) live Depot connection pools.
--
-- Auto-imports defined in forge.toml [console] section:
--
--   [console]
--   imports = [
--     "MyApp.Accounts",
--     "MyApp.Repo",
--     "Bastion.Vault",
--   ]
--
-- Example session:
--
--   iex(my_app)> MyApp.Accounts.list_users()
--   [%{id: 1, email: "alice@example.com"}, ...]
--
--   iex(my_app)> Vault.all(:response_cache) |> List.length()
--   42
--
--   iex(my_app)> :quit
--   Goodbye.

mod Forge.Console do

-- ---------------------------------------------------------------------------
-- Config
-- ---------------------------------------------------------------------------

type ConsoleConfig = {
  app_name    : String,
  with_server : Bool,
  imports     : List(String),
  banner      : String
}

pfn default_banner(app_name : String) : String do
  "\n" ++
  "  Bastion Console — " ++ app_name ++ "\n" ++
  "  Type :quit or Ctrl+C to exit\n" ++
  "  Loading app modules from lib/...\n" ++
  "\n"
end

-- ---------------------------------------------------------------------------
-- Entry point
-- ---------------------------------------------------------------------------

fn main() do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  run(args)
end

fn run(args : List(String)) do
  let with_server = List.any(args, fn a -> a == "--server")

  -- Load project once for name, root dir, and dep paths.
  let proj_result = Forge.Project.load()
  let app_name = match proj_result do Ok(proj) -> proj.name | Err(_) -> "app" end
  let proj_root = match proj_result do Ok(proj) -> proj.root | Err(_) -> "." end
  let imports  = read_console_imports()

  let config = {
    app_name    = app_name,
    with_server = with_server,
    imports     = imports,
    banner      = default_banner(app_name)
  }

  println(config.banner)

  -- Set MARCH_LIB_PATH so :load resolves dep module imports (e.g. import Router).
  -- Collect lib/ directories of all PathDep entries from forge.toml.
  let dep_lib_paths = match proj_result do
    Err(_)   -> Nil
    Ok(proj) ->
      List.filter_map(proj.deps, fn pair ->
        match Tuple.second(pair) do
        PathDep(p) ->
          let abs = if String.starts_with(p, "/") do p
                    else proj_root ++ "/" ++ p
                    end
          Some(abs ++ "/lib")
        _ -> None
        end)
  end
  -- Reverse dep list so later deps (e.g. depot) take priority over earlier ones
  -- (e.g. bastion's Pool stub). Prepend proj config/ and proj lib/ so the batch
  -- compiler (--server) auto-discovers all app modules (todos.march etc.).
  let reversed_dep_paths = List.reverse(dep_lib_paths)
  let config_path = proj_root ++ "/config"
  let app_lib_path = proj_root ++ "/lib"
  let march_lib_path =
    config_path ++ ":" ++ app_lib_path ++
    (if !String.is_empty(String.join(reversed_dep_paths, ":")) do
      ":" ++ String.join(reversed_dep_paths, ":")
    else "" end)
  let _ = Process.set_env("MARCH_LIB_PATH", march_lib_path)

  -- Force interpreter mode so cross-module calls (e.g. TodoApp.Application.start())
  -- work correctly in the REPL. The JIT backend can't resolve symbols for modules
  -- loaded via :load because they're not in the JIT symbol table.
  let _ = Process.set_env("MARCH_REPL_INTERP", "1")
  let march_bin = match Process.env("MARCH_CONSOLE_BIN") do Some(b) -> b | None -> "march" end
  let _ = Process.set_env("MARCH_BIN", march_bin)

  -- Pass the project root and app module name via env so the TCL script can
  -- glob the right lib/ directory even when forge changes CWD to the dep package.
  let _ = Process.set_env("MARCH_PROJECT_ROOT", proj_root)
  let app_pascal = snake_to_pascal(app_name)
  let _ = Process.set_env("MARCH_APP_MOD", app_pascal)
  let _ = Process.set_env("MARCH_APP_NAME", app_name)

  -- Use `expect` to spawn march with a real PTY (readline/history work).
  -- Glob is anchored to the project root so it always loads the *user's* lib/
  -- files regardless of where forge invokes the task from.
  --
  -- --server: run the app via the batch compiler in the background.
  -- The batch compiler links all modules together, so cross-module calls work
  -- without the JIT symbol issues that break PTY REPL expression evaluation.
  -- The app's main() calls start_server() → spawn_n (forks the HTTP worker)
  -- → wait_for (blocks the batch process). Both log to /dev/tty so output
  -- appears interleaved in the terminal alongside the interactive REPL.
  -- The interactive REPL starts Application.start() separately for DB access.
  let server_send = if with_server do
    "exec sh -c \"$env(MARCH_BIN) $proot/lib/$env(MARCH_APP_NAME).march >/dev/tty 2>/dev/tty &\"; " ++
    "expect -re {march\\(\\d+\\)>}; " ++
    "send \"$env(MARCH_APP_MOD).Application.start()\\r\"; "
  else
    "expect -re {march\\(\\d+\\)>}; " ++
    "send \"$env(MARCH_APP_MOD).Application.start()\\r\"; "
  end
  -- Load order matters for the REPL (unlike the batch compiler which resolves
  -- the whole project at once). The stages below ensure every module is in the
  -- env before a file that references it is loaded:
  --   1. config/*.march in DECREASING order — sub-configs (dev/prod/test) load
  --      before config.march, which references Config.Dev etc. by qualified name.
  --   2. lib/**/*.march (sub-module files) — application, repo, etc. load before
  --      the top-level modules that depend on them.
  --   3. lib/*.march — all files except the main app module in alphabetical
  --      order, then the main app module last. This ensures utility modules
  --      (e.g. math.march) and peer modules (e.g. todos.march) are registered
  --      before the top-level module that references them.
  let tcl =
    -- log_user 0 suppresses REPL output during module loading — prevents the
    -- "Variables in Scope" dump that march prints after every :load. interact
    -- hands the PTY directly to the terminal regardless of log_user.
    "log_user 0; " ++
    "spawn $env(MARCH_BIN) repl; " ++
    "set proot $env(MARCH_PROJECT_ROOT); " ++
    "foreach f [lsort -decreasing [glob -nocomplain $proot/config/*.march]] { " ++
      "expect -re {march\\(\\d+\\)>}; " ++
      "send \":load $f\\r\" }; " ++
    -- Guard [file dirname $f] ne $proot/lib: TCL's ** matches zero intermediate
    -- segments, so lib/**/*.march also matches lib/foo.march. Without the guard
    -- those top-level files load twice (here AND in the lib/*.march loop below).
    "foreach f [lsort [glob -nocomplain $proot/lib/**/*.march]] { " ++
      "if {[file dirname $f] ne \"$proot/lib\"} { " ++
        "expect -re {march\\(\\d+\\)>}; " ++
        "send \":load $f\\r\" } }; " ++
    "set _app_file \"$proot/lib/$env(MARCH_APP_NAME).march\"; " ++
    "foreach f [lsort [glob -nocomplain $proot/lib/*.march]] { " ++
      "if {$f ne $_app_file} { " ++
        "expect -re {march\\(\\d+\\)>}; " ++
        "send \":load $f\\r\" } }; " ++
    "if {[file exists $_app_file]} { " ++
      "expect -re {march\\(\\d+\\)>}; " ++
      "send \":load $_app_file\\r\" }; " ++
    server_send ++
    "expect -re {march\\(\\d+\\)>}; " ++
    "interact"
  let shell =
    "(command -v expect >/dev/null 2>&1 && " ++
    "expect -c '" ++ tcl ++ "' </dev/tty >/dev/tty 2>/dev/tty)" ++
    " || exec " ++ march_bin ++ " repl </dev/tty >/dev/tty 2>/dev/tty" ++
    " || exec " ++ march_bin ++ " repl"
  match Process.run("sh", ["-c", shell]) do
    Err(msg) -> println("  Error starting REPL: " ++ msg)
    Ok(_)    -> ()
  end
end

-- ---------------------------------------------------------------------------
-- Helpers
-- ---------------------------------------------------------------------------

pfn snake_to_pascal(s : String) : String do
  let parts     = String.split(s, "_")
  let non_empty = List.filter(parts, fn p -> !String.is_empty(p))
  let capped    = List.map(non_empty, fn p ->
    if String.is_empty(p) do p
    else String.to_uppercase(String.slice_bytes(p, 0, 1)) ++ String.slice_bytes(p, 1, String.byte_size(p) - 1)
    end)
  String.join(capped, "")
end

-- ---------------------------------------------------------------------------
-- App startup
-- ---------------------------------------------------------------------------

-- start_app runs in the Forge process before the REPL is spawned.
-- Real application startup (Logger actor, Depot pool, etc.) happens
-- inside the REPL process via Application.start() injected by the
-- TCL script below — exactly like `iex -S mix` starts the OTP app.
pfn start_app(_config : ConsoleConfig) do
  ()
end

pfn server_port() : String do
  Env.get("PORT", "4000")
end

-- ---------------------------------------------------------------------------
-- Config file reading
-- ---------------------------------------------------------------------------

pfn read_console_imports() : List(String) do
  Nil
end

end -- mod Forge.Console
