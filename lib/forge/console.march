-- Forge.Console — forge bastion.console
--
-- Starts an interactive March REPL with the application fully loaded.
-- Analogous to `iex -S mix` (Elixir) or `rails console` (Rails).
--
-- Usage:
--   forge bastion.console              # start REPL, no HTTP server
--   forge bastion.console --server     # start REPL + HTTP server together
--
-- The REPL session has access to all compiled app modules, running Vault
-- tables, and (with --server) live Depot connection pools.
--
-- Auto-imports defined in forge.toml [console] section:
--
--   [console]
--   imports = [
--     "MyApp.Accounts",
--     "MyApp.Repo",
--     "Bastion.Vault",
--   ]
--
-- Example session:
--
--   iex(my_app)> MyApp.Accounts.list_users()
--   [%{id: 1, email: "alice@example.com"}, ...]
--
--   iex(my_app)> Vault.all(:response_cache) |> List.length()
--   42
--
--   iex(my_app)> :quit
--   Goodbye.

mod Forge.Console do

-- ---------------------------------------------------------------------------
-- Config
-- ---------------------------------------------------------------------------

type ConsoleConfig = {
  app_name    : String,
  with_server : Bool,
  imports     : List(String),
  banner      : String
}

pfn default_banner(app_name : String) : String do
  "\n" ++
  "  Bastion Console — " ++ app_name ++ "\n" ++
  "  Type :quit or Ctrl+C to exit\n" ++
  "  App modules loaded from lib/ — type :env to list bindings\n" ++
  "\n"
end

-- ---------------------------------------------------------------------------
-- Entry point
-- ---------------------------------------------------------------------------

fn main() do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  run(args)
end

fn run(args : List(String)) do
  let with_server = List.any(args, fn a -> a == "--server")
  let app_name    = read_app_name()
  let imports     = read_console_imports()

  let config = {
    app_name    = app_name,
    with_server = with_server,
    imports     = imports,
    banner      = default_banner(app_name)
  }

  println(config.banner)

  -- Start the application supervision tree (Vault, Depot pool, etc.)
  let _ = start_app(config)

  -- Optionally start the HTTP server alongside
  let _ = if with_server do
    println("  HTTP server starting on http://localhost:" ++ server_port() ++ "\n")
  else () end

  -- ORC JIT cuts per-fragment compile time from ~145ms to ~0.2ms.
  -- register_module_decl (march repl_jit.ml) compiles :load-ed DMod functions
  -- into the ORC dylib so Counter.create etc. are resolvable in later fragments.
  let _ = Process.set_env("MARCH_JIT_BACKEND", "orc")
  let march_bin = match Process.env("MARCH_CONSOLE_BIN") do Some(b) -> b | None -> "march" end
  -- expose march_bin to the Tcl script via env so there are no quoting issues
  let _ = Process.set_env("MARCH_BIN", march_bin)
  -- Use `expect` to spawn march with a real PTY (so readline/history work),
  -- inject a :load command for each lib/*.march file (which uses the DMod-wrap
  -- path, giving Counter.create, PageController.home etc.), then `interact` to
  -- hand the session to the user.  All output goes through expect's PTY.
  -- Forge nulls stdin, so all three streams are tied to /dev/tty.
  -- Fallback chain: if expect or /dev/tty is absent, plain exec without loads.
  let tcl =
    "log_user 1; " ++
    "spawn $env(MARCH_BIN) repl; " ++
    "foreach f [glob -nocomplain lib/*.march] { " ++
      "expect -re {march\\(\\d+\\)>}; " ++
      "send \":load $f\\r\" }; " ++
    "expect -re {march\\(\\d+\\)>}; " ++
    "interact"
  let shell =
    "(command -v expect >/dev/null 2>&1 && " ++
    "expect -c '" ++ tcl ++ "' </dev/tty >/dev/tty 2>/dev/tty)" ++
    " || exec " ++ march_bin ++ " repl </dev/tty >/dev/tty 2>/dev/tty" ++
    " || exec " ++ march_bin ++ " repl"
  match Process.run("sh", ["-c", shell]) do
    Err(msg) -> println("  Error starting REPL: " ++ msg)
    Ok(_)    -> ()
  end
end

-- ---------------------------------------------------------------------------
-- App startup
-- ---------------------------------------------------------------------------

pfn start_app(_config : ConsoleConfig) do
  -- Start Vault tables the app uses
  let _ = Vault.open("response_cache")
  let _ = Vault.open("session_store")
  let _ = Vault.open("rate_limit")
  let _ = Vault.open("pubsub_registry")
  -- TODO: start Depot pool when Depot module is available
  ()
end

pfn server_port() : String do
  Env.get("PORT", "4000")
end

-- ---------------------------------------------------------------------------
-- Config file reading
-- ---------------------------------------------------------------------------

pfn read_app_name() : String do
  -- TODO: read from forge.toml when Toml module is available
  match Forge.Project.load() do
  Ok(proj) -> proj.name
  Err(_)   -> "app"
  end
end

pfn read_console_imports() : List(String) do
  -- TODO: read from forge.toml [console] section when Toml module is available
  Nil
end

end -- mod Forge.Console
