pfn user_tokens_migration_source(ts) do
  """-- Auto-generated by forge bastion gen auth

mod Migrations.CreateUserTokens do

fn up() do
  Depot.Migration.create_table("user_tokens", {
    id: ("UUID",        { primary_key: true }),
    user_id: ("UUID",        { null: false }),
    token: ("String",      { null: false }),
    context: ("String",      { null: false }),
    sent_to: ("String",      { null: true }),
    inserted_at: ("UtcDatetime", { null: false })
  })
  Depot.Migration.create_index("user_tokens", ["token"],              { unique: true })
  Depot.Migration.create_index("user_tokens", ["context", "sent_to"], {})
  -- Foreign key: deleting a user cascades to their tokens
  Depot.Migration.execute("ALTER TABLE user_tokens ADD CONSTRAINT user_tokens_user_id_fkey FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE")
end

fn down() do
  Depot.Migration.drop_table("user_tokens")
end

fn version() do
  """ ++ String.from_int(ts) ++ """
end

end
"""
end

pfn accounts_context_source(pascal) do
  """-- Auto-generated by forge bastion gen auth
-- The Accounts context is the public API for user management.
-- All callers should go through this module, not the schemas directly.

mod """ ++ pascal ++ """.Accounts do

alias """ ++ pascal ++ """.Accounts.User as User
alias """ ++ pascal ++ """.Accounts.UserToken as UserToken
alias """ ++ pascal ++ """.Accounts.UserNotifier as UserNotifier
alias Depot.Repo as Repo
alias Depot.Gate as Gate
alias Depot.Query as Q

fn get_user(id) do
  Repo.get(User.schema(), id)
end

fn get_user_by_email(email) do
  Repo.get_by(User.schema(), { email: email })
end

fn get_user_by_email_and_password(email, password) do
  match Repo.get_by(User.schema(), { email: email }) do
  None -> None
  Some(user) ->
    if User.valid_password(user, password) do
      Some(user)
    else None end
  end
end

fn register_user(params) do
  let gate = User.registration_gate(params)
  if Gate.is_valid(gate) do
    let final_gate = User.hash_password(gate)
    match Repo.insert(User.schema(), final_gate) do
    Ok(user) ->
      UserNotifier.deliver_welcome(user)
      Ok(user)
    Err(g) -> Err(g)
    end
  else Err(gate) end
end

fn change_user_registration(attrs) do
  User.registration_gate(attrs)
end

fn update_user_email(user, params) do
  let gate = User.update_email_gate(user, params)
  if Gate.is_valid(gate) do
    Repo.update(User.schema(), gate)
  else Err(gate) end
end

fn update_user_password(user, params) do
  let gate = User.update_password_gate(user, params)
  if Gate.is_valid(gate) do
    let final_gate = User.hash_password(gate)
    match Repo.update(User.schema(), final_gate) do
    Ok(updated_user) ->
      delete_all_user_tokens(user, "session")
      Ok(updated_user)
    Err(g) -> Err(g)
    end
  else Err(gate) end
end

fn change_user_password(user) do
  User.update_password_gate(user, [])
end

fn create_session_token(user) do
  let (token, gate) = UserToken.build_session_token(user)
  match Repo.insert(UserToken.schema(), gate) do
  Ok(_) -> Ok(token)
  Err(g) -> Err(g)
  end
end

fn get_user_by_session_token(token) do
  match Repo.get_by(UserToken.schema(), { token: token, context: "session" }) do
  None -> None
  Some(tok) -> Repo.get(User.schema(), tok.user_id)
  end
end

fn delete_session_token(token) do
  match Repo.get_by(UserToken.schema(), { token: token, context: "session" }) do
  None -> :ok
  Some(tok) ->
    Repo.delete(UserToken.schema(), tok.id)
    :ok
  end
end

fn deliver_user_confirmation_instructions(user, url_fn) do
  let (token, gate) = UserToken.build_email_token(user, "confirm")
  match Repo.insert(UserToken.schema(), gate) do
  Ok(_) ->
    UserNotifier.deliver_confirmation_instructions(user, url_fn(token))
    :ok
  Err(_) -> :error
  end
end

fn confirm_user(token_str) do
  let hashed = Crypto.sha256(token_str)
  match Repo.get_by(UserToken.schema(), { token: hashed, context: "confirm" }) do
  None -> Err("invalid or expired confirmation token")
  Some(tok) ->
    match Repo.get(User.schema(), tok.user_id) do
    None -> Err("user not found")
    Some(user) ->
      let now = DateTime.now()
      let gate = Gate.cast_record(user, { confirmed_at: now }, ["confirmed_at"])
      match Repo.update(User.schema(), gate) do
      Ok(confirmed_user) ->
        Repo.delete(UserToken.schema(), tok.id)
        Ok(confirmed_user)
      Err(g) -> Err(g)
      end
    end
  end
end

fn deliver_user_reset_password_instructions(user, url_fn) do
  let (token, gate) = UserToken.build_email_token(user, "reset_password")
  match Repo.insert(UserToken.schema(), gate) do
  Ok(_) ->
    UserNotifier.deliver_reset_password_instructions(user, url_fn(token))
    :ok
  Err(_) -> :error
  end
end

fn get_user_by_reset_password_token(token_str) do
  let hashed = Crypto.sha256(token_str)
  match Repo.get_by(UserToken.schema(), { token: hashed, context: "reset_password" }) do
  None -> None
  Some(tok) -> Repo.get(User.schema(), tok.user_id)
  end
end

fn reset_user_password(user, params) do
  let gate = User.update_password_gate(user, params)
  if Gate.is_valid(gate) do
    let final_gate = User.hash_password(gate)
    match Repo.update(User.schema(), final_gate) do
    Ok(updated_user) ->
      delete_all_user_tokens(user, "reset_password")
      Ok(updated_user)
    Err(g) -> Err(g)
    end
  else Err(gate) end
end

pfn delete_all_user_tokens(user, context) do
  let tokens = Q.from(UserToken.schema())
    |> Q.where_(fn tok -> tok.user_id == user.id && tok.context == context)
    |> Q.execute(Repo.all(UserToken.schema()))
  List.each(tokens, fn tok -> Repo.delete(UserToken.schema(), tok.id))
end

end
"""
end

pfn auth_middleware_source(pascal) do
  """-- Auto-generated by forge bastion gen auth
-- Auth middleware plugs for the router pipeline.

mod """ ++ pascal ++ """.Auth do

alias """ ++ pascal ++ """.Accounts as Accounts
alias HttpServer as H

-- Resolve the current user from the session token. Returns Some(user) when
-- logged in, None otherwise. Read the user this way from controllers
-- (Auth.current_user(conn)) rather than from a conn assign — conn assigns
-- store String values only, so a user record cannot live there.
fn current_user(conn) do
  match Session.get(conn, "user_token") do
  None        -> None
  Some(token) -> Accounts.get_user_by_session_token(token)
  end
end

fn require_authenticated_user(conn) do
  match current_user(conn) do
  Some(_user) -> conn
  None ->
    conn
      |> Flash.put("error", "You must log in to access this page.")
      |> H.redirect("/users/log_in")
      |> H.halt()
  end
end

fn redirect_if_authenticated(conn) do
  match current_user(conn) do
  None -> conn
  Some(_user) ->
    conn
      |> H.redirect("/")
      |> H.halt()
  end
end

end
"""
end

pfn registration_controller_source(pascal) do
  let q = tq()
  """-- Auto-generated by forge bastion gen auth

mod """ ++ pascal ++ """.Controllers.Auth.RegistrationController do

alias """ ++ pascal ++ """.Accounts as Accounts
alias HttpServer as H
alias RateLimit

-- Vault table for registration rate limiting (5 registrations per IP per 10 minutes)
let rate_table = Vault.new("auth_rate_limit")

fn new(conn) do
  let gate = Accounts.change_user_registration([])
  H.html(conn, 200, render_form(gate, ""))
end

fn create(conn) do
  match RateLimit.check(conn, rate_table, RateLimit.ip_key, 5, 600) do
  Err(conn2) -> conn2
  Ok(conn2) -> do
    let params = Request.body_params(conn2)
    match Accounts.register_user(params) do
    Ok(_user) ->
      conn2
        |> Flash.put("info", "Account created! Please check your email to confirm your account.")
        |> H.redirect("/users/log_in")
    Err(gate) ->
      H.html(conn2, 422, render_form(gate, ""))
    end
  end
  end
end

-- TODO: replace with your ~H template
pfn render_form(_gate, _error) do
  ~H""" ++ q ++ """<div class="auth-form">
  <h1>Create an account</h1>
  <form method="post" action="/users/register">
    <label>Email <input type="email" name="email" required></label>
    <label>Password <input type="password" name="password" required minlength="12"></label>
    <button type="submit">Register</button>
  </form>
  <p><a href="/users/log_in">Already have an account? Log in</a></p>
</div>""" ++ q ++ """
end

end
"""
end

pfn session_controller_source(pascal) do
  let q = tq()
  let error_html_var = iv("error_html")
  """-- Auto-generated by forge bastion gen auth

mod """ ++ pascal ++ """.Controllers.Auth.SessionController do

alias """ ++ pascal ++ """.Accounts as Accounts
alias HttpServer as H
alias RateLimit

-- Vault table for login/reset rate limiting (10 attempts per IP per minute)
let rate_table = Vault.new("auth_rate_limit")

fn new(conn) do
  H.html(conn, 200, render_form(""))
end

fn create(conn) do
  match RateLimit.check(conn, rate_table, RateLimit.ip_key, 10, 60) do
  Err(conn2) -> conn2
  Ok(conn2) -> do
    let params = Request.body_params(conn2)
    let email_str = match List.filter_map(params, fn pair -> do
        let (k, v) = pair
        if k == "email" do Some(v) else None end
      end) do
      Cons(e, _) -> e
      Nil -> ""
    end
    let password_str = match List.filter_map(params, fn pair -> do
        let (k, v) = pair
        if k == "password" do Some(v) else None end
      end) do
      Cons(p, _) -> p
      Nil -> ""
    end
    match Accounts.get_user_by_email_and_password(email_str, password_str) do
    None ->
      conn2
        |> Flash.put("error", "Invalid email or password.")
        |> H.html(200, render_form("Invalid email or password."))
    Some(user) ->
      match Accounts.create_session_token(user) do
      Ok(token) ->
        conn2
          |> Session.put("user_token", token)
          |> Flash.put("info", "Welcome back!")
          |> H.redirect("/")
      Err(_) ->
        H.html(conn2, 500, "Internal error")
      end
    end
  end
  end
end

fn delete(conn) do
  match Session.get(conn, "user_token") do
  Some(token) -> Accounts.delete_session_token(token)
  None -> :ok
  end
  conn
    |> Session.clear()
    |> Flash.put("info", "Logged out successfully.")
    |> H.redirect("/")
end

-- TODO: replace with your ~H template
pfn render_form(error) do
  let error_html = if error == "" do ""
                   else "<p class=\\"error\\">" ++ error ++ "</p>" end
  ~H""" ++ q ++ """<div class="auth-form">
  <h1>Log in</h1>
  """ ++ error_html_var ++ """
  <form method="post" action="/users/log_in">
    <label>Email <input type="email" name="email" required></label>
    <label>Password <input type="password" name="password" required></label>
    <button type="submit">Log in</button>
  </form>
  <p><a href="/users/register">Need an account? Register</a></p>
  <p><a href="/users/reset_password">Forgot your password?</a></p>
</div>""" ++ q ++ """
end

end
"""
end

pfn user_settings_controller_source(pascal) do
  let q = tq()
  let user_email_var = iv("user.email")
  """-- Auto-generated by forge bastion gen auth

mod """ ++ pascal ++ """.Controllers.Auth.UserSettingsController do

alias """ ++ pascal ++ """.Accounts as Accounts
alias """ ++ pascal ++ """.Auth as Auth
alias HttpServer as H

fn edit(conn) do
  match Auth.current_user(conn) do
  None ->
    conn |> H.redirect("/users/log_in") |> H.halt()
  Some(user) ->
    let email_gate = Accounts.User.update_email_gate(user, [])
    let pw_gate    = Accounts.change_user_password(user)
    H.html(conn, 200, render_settings(user, email_gate, pw_gate))
  end
end

fn update_email(conn) do
  match Auth.current_user(conn) do
  None ->
    conn |> H.redirect("/users/log_in") |> H.halt()
  Some(user) ->
    let params = Request.body_params(conn)
    match Accounts.update_user_email(user, params) do
    Ok(_) ->
      conn
        |> Flash.put("info", "Email updated successfully.")
        |> H.redirect("/users/settings")
    Err(gate) ->
      let pw_gate = Accounts.change_user_password(user)
      H.html(conn, 422, render_settings(user, gate, pw_gate))
    end
  end
end

fn update_password(conn) do
  match Auth.current_user(conn) do
  None ->
    conn |> H.redirect("/users/log_in") |> H.halt()
  Some(user) ->
    let params = Request.body_params(conn)
    match Accounts.update_user_password(user, params) do
    Ok(_) ->
      conn
        |> Flash.put("info", "Password updated. Please log in again.")
        |> H.redirect("/users/log_in")
    Err(gate) ->
      let email_gate = Accounts.User.update_email_gate(user, [])
      H.html(conn, 422, render_settings(user, email_gate, gate))
    end
  end
end

-- TODO: replace with your ~H template
pfn render_settings(user, _email_gate, _pw_gate) do
  ~H""" ++ q ++ """<div class="settings">
  <h1>Account settings for """ ++ user_email_var ++ """</h1>

  <section>
    <h2>Change email</h2>
    <form method="post" action="/users/settings/email">
      <label>New email <input type="email" name="email" required></label>
      <button type="submit">Update email</button>
    </form>
  </section>

  <section>
    <h2>Change password</h2>
    <form method="post" action="/users/settings/password">
      <label>New password <input type="password" name="password" required minlength="12"></label>
      <label>Confirm <input type="password" name="password_confirmation" required></label>
      <button type="submit">Update password</button>
    </form>
  </section>
</div>""" ++ q ++ """
end

end
"""
end

pfn confirmation_controller_source(pascal) do
  """-- Auto-generated by forge bastion gen auth

mod """ ++ pascal ++ """.Controllers.Auth.ConfirmationController do

alias """ ++ pascal ++ """.Accounts as Accounts
alias """ ++ pascal ++ """.Auth as Auth
alias HttpServer as H

-- GET /users/confirm/:token — confirm the user's email address
fn confirm(conn) do
  let p = H.path_info(conn)
  let token = match p do
    Cons("users", Cons("confirm", Cons(t, Nil))) -> t
    _ -> ""
  end
  if token == "" do
    conn
      |> Flash.put("error", "Confirmation link is invalid or has expired.")
      |> H.redirect("/")
      |> H.halt()
  else
    match Accounts.confirm_user(token) do
    Ok(_) ->
      conn
        |> Flash.put("info", "Email confirmed successfully! You can now log in.")
        |> H.redirect("/users/log_in")
    Err(_) ->
      conn
        |> Flash.put("error", "Confirmation link is invalid or has expired.")
        |> H.redirect("/")
    end
  end
end

-- POST /users/confirm — resend the confirmation email
fn resend(conn) do
  match Auth.current_user(conn) do
  None ->
    conn
      |> Flash.put("error", "You must be logged in to resend confirmation.")
      |> H.redirect("/users/log_in")
  Some(user) ->
    Accounts.deliver_user_confirmation_instructions(
      user,
      fn token -> "/users/confirm/" ++ token
    )
    conn
      |> Flash.put("info", "Confirmation email sent. Please check your inbox.")
      |> H.redirect("/")
  end
end

end
"""
end

pfn password_reset_controller_source(pascal) do
  let q = tq()
  """-- Auto-generated by forge bastion gen auth

mod """ ++ pascal ++ """.Controllers.Auth.PasswordResetController do

alias """ ++ pascal ++ """.Accounts as Accounts
alias HttpServer as H
alias RateLimit

-- Rate-limit table shared with session controller for login/reset routes
let rate_table = Vault.new("auth_rate_limit")

-- GET /users/reset_password — show the "forgot password?" form
fn new(conn) do
  H.html(conn, 200, render_request_form())
end

-- POST /users/reset_password — send the reset email (rate limited)
fn create(conn) do
  match RateLimit.check(conn, rate_table, RateLimit.ip_key, 5, 60) do
  Err(conn2) -> conn2
  Ok(conn2) -> do
    let params = Request.body_params(conn2)
    let email_str = match List.filter_map(params, fn pair -> do
        let (k, v) = pair
        if k == "email" do Some(v) else None end
      end) do
      Cons(e, _) -> e
      Nil -> ""
    end
    -- Always show success to avoid email enumeration
    match Accounts.get_user_by_email(email_str) do
    Some(user) ->
      Accounts.deliver_user_reset_password_instructions(
        user,
        fn token -> "/users/reset_password/" ++ token
      )
    None -> :ok
    end
    conn2
      |> Flash.put("info", "If your email is registered, you will receive reset instructions shortly.")
      |> H.redirect("/users/log_in")
  end
  end
end

-- GET /users/reset_password/:token — show the "enter new password" form
fn edit(conn) do
  let token = extract_token(H.path_info(conn))
  if token == "" do
    conn
      |> Flash.put("error", "Reset link is invalid or has expired.")
      |> H.redirect("/users/log_in")
      |> H.halt()
  else
    match Accounts.get_user_by_reset_password_token(token) do
    None ->
      conn
        |> Flash.put("error", "Reset link is invalid or has expired.")
        |> H.redirect("/users/log_in")
        |> H.halt()
    Some(_user) ->
      H.html(conn, 200, render_reset_form(token, ""))
    end
  end
end

-- PATCH /users/reset_password/:token — apply the new password
fn update(conn) do
  let token = extract_token(H.path_info(conn))
  match Accounts.get_user_by_reset_password_token(token) do
  None ->
    conn
      |> Flash.put("error", "Reset link is invalid or has expired.")
      |> H.redirect("/users/log_in")
      |> H.halt()
  Some(user) ->
    let params = Request.body_params(conn)
    match Accounts.reset_user_password(user, params) do
    Ok(_) ->
      conn
        |> Flash.put("info", "Password reset successfully. Please log in with your new password.")
        |> H.redirect("/users/log_in")
    Err(gate) ->
      let errs    = Depot.Gate.errors(gate)
      let err_msg = String.join(List.map(errs, fn e -> do let (f, m) = e; f ++ " " ++ m end), ", ")
      H.html(conn, 422, render_reset_form(token, err_msg))
    end
  end
end

pfn extract_token(path_info) do
  match path_info do
  Cons("users", Cons("reset_password", Cons(token, Nil))) -> token
  _ -> ""
  end
end

-- TODO: replace with your ~H templates
pfn render_request_form() do
  ~H""" ++ q ++ """<div class="auth-form">
  <h1>Reset your password</h1>
  <form method="post" action="/users/reset_password">
    <label>Email <input type="email" name="email" required></label>
    <button type="submit">Send reset instructions</button>
  </form>
  <p><a href="/users/log_in">Back to log in</a></p>
</div>""" ++ q ++ """
end

pfn render_reset_form(token, error) do
  let error_html = if error == "" do ""
                   else "<p class=\\"error\\">" ++ error ++ "</p>" end
  ~H""" ++ q ++ """<div class="auth-form">
  <h1>Set a new password</h1>
  """ ++ iv("error_html") ++ """
  <form method="post" action="/users/reset_password/""" ++ iv("token") ++ """"
        data-method="patch">
    <label>New password <input type="password" name="password" required minlength="12"></label>
    <label>Confirm     <input type="password" name="password_confirmation" required></label>
    <button type="submit">Reset password</button>
  </form>
</div>""" ++ q ++ """
end

end
"""
end

pfn accounts_fixtures_source(pascal) do
  """-- Auto-generated by forge bastion gen auth
-- Test factory helpers for the Accounts context.

mod """ ++ pascal ++ """.AccountsFixtures do

alias """ ++ pascal ++ """.Accounts as Accounts

let user_counter = Vault.new("_auth_fixtures_counter")

pfn unique_email() do
  let n = match Vault.get(user_counter, "count") do
    Some(c) -> c + 1
    None -> 1
  end
  Vault.set(user_counter, "count", n)
  "user" ++ String.from_int(n) ++ "@example.com"
end

fn user_fixture_attrs(overrides) do
  let defaults = [("email", unique_email()), ("password", "ValidPassword123!")]
  List.fold_left(defaults, overrides, fn (acc, pair) -> do
    let (k, v) = pair
    List.filter(acc, fn entry -> do
      let (ek, _) = entry
      ek != k
    end) ++ [(k, v)]
  end)
end

fn user_fixture(overrides) do
  let attrs = user_fixture_attrs(overrides)
  match Accounts.register_user(attrs) do
  Ok(user) ->
    let confirm_gate = Depot.Gate.cast_record(
      user,
      { confirmed_at: DateTime.now() },
      ["confirmed_at"]
    )
    match Depot.Repo.update(""" ++ pascal ++ """.Accounts.User.schema(), confirm_gate) do
    Ok(confirmed) -> confirmed
    Err(_) -> user
    end
  Err(gate) ->
    let errs = Depot.Gate.errors(gate)
    let msg = List.map(errs, fn entry -> do
      let (f, m) = entry
      f ++ ": " ++ m
    end) |> String.join(", ")
    error("user_fixture failed: " ++ msg)
  end
end

fn create_session_token(user) do
  match Accounts.create_session_token(user) do
  Ok(token) -> token
  Err(_) -> error("create_session_token failed")
  end
end

end
"""
end

-- ── Run ──────────────────────────────────────────────────────────────────────

doc "Generate auth boilerplate in the current project directory."
fn run() do
  let pascal      = detect_app_name()
  let app_snake   = String.to_lowercase(pascal)
  let ts          = DateTime.now()
  let ts2         = ts + 1

  let lib_dir       = "lib/" ++ app_snake
  let accounts_dir  = lib_dir ++ "/accounts"
  let auth_ctrl_dir = lib_dir ++ "/controllers/auth"
  let mig_dir       = "priv/depot/migrations"
  let support_dir   = "test/support"

  let _ = Dir.mkdir_p(accounts_dir)
  let _ = Dir.mkdir_p(auth_ctrl_dir)
  let _ = Dir.mkdir_p(mig_dir)
  let _ = Dir.mkdir_p(support_dir)

  let write = fn path -> fn content -> do
    let _ = File.write(path, content)
    println("* creating " ++ path)
  end

  write(accounts_dir ++ "/user.march")(user_schema_source(pascal))
  write(accounts_dir ++ "/user_token.march")(user_token_schema_source(pascal))
  write(accounts_dir ++ "/user_notifier.march")(user_notifier_source(pascal))
  write(lib_dir ++ "/accounts.march")(accounts_context_source(pascal))
  write(lib_dir ++ "/auth.march")(auth_middleware_source(pascal))
  write(auth_ctrl_dir ++ "/registration_controller.march")(registration_controller_source(pascal))
  write(auth_ctrl_dir ++ "/session_controller.march")(session_controller_source(pascal))
  write(auth_ctrl_dir ++ "/user_settings_controller.march")(user_settings_controller_source(pascal))
  write(auth_ctrl_dir ++ "/confirmation_controller.march")(confirmation_controller_source(pascal))
  write(auth_ctrl_dir ++ "/password_reset_controller.march")(password_reset_controller_source(pascal))
  write(mig_dir ++ "/" ++ String.from_int(ts)  ++ "_create_users.march")(users_migration_source(ts))
  write(mig_dir ++ "/" ++ String.from_int(ts2) ++ "_create_user_tokens.march")(user_tokens_migration_source(ts2))
  write(support_dir ++ "/accounts_fixtures.march")(accounts_fixtures_source(pascal))

  let lower_app = String.to_lowercase(pascal)

  println("")
  println("Done!  Files generated for " ++ pascal ++ ".")
  println("")
  println("Next steps")
  println("──────────")
  println("")
  println("1. Add auth routes to your router  (lib/" ++ lower_app ++ "/router.march):")
  println("")
  println("     (:post, Cons(\"users\", Cons(\"register\", Nil)))  -> " ++ pascal ++ ".Controllers.Auth.RegistrationController.create(conn)")
  println("     (:get,  Cons(\"users\", Cons(\"register\", Nil)))  -> " ++ pascal ++ ".Controllers.Auth.RegistrationController.new(conn)")
  println("     (:post, Cons(\"users\", Cons(\"log_in\", Nil)))    -> " ++ pascal ++ ".Controllers.Auth.SessionController.create(conn)")
  println("     (:get,  Cons(\"users\", Cons(\"log_in\", Nil)))    -> " ++ pascal ++ ".Controllers.Auth.SessionController.new(conn)")
  println("     (:delete, Cons(\"users\", Cons(\"log_out\", Nil))) -> " ++ pascal ++ ".Controllers.Auth.SessionController.delete(conn)")
  println("     (:get,  Cons(\"users\", Cons(\"settings\", Nil)))  -> " ++ pascal ++ ".Controllers.Auth.UserSettingsController.edit(conn)")
  println("     (:get,  Cons(\"users\", Cons(\"confirm\", Cons(_, Nil)))) -> " ++ pascal ++ ".Controllers.Auth.ConfirmationController.confirm(conn)")
  println("     (:post, Cons(\"users\", Cons(\"confirm\", Nil)))   -> " ++ pascal ++ ".Controllers.Auth.ConfirmationController.resend(conn)")
  println("     (:get,  Cons(\"users\", Cons(\"reset_password\", Nil)))           -> " ++ pascal ++ ".Controllers.Auth.PasswordResetController.new(conn)")
  println("     (:post, Cons(\"users\", Cons(\"reset_password\", Nil)))           -> " ++ pascal ++ ".Controllers.Auth.PasswordResetController.create(conn)")
  println("     (:get,  Cons(\"users\", Cons(\"reset_password\", Cons(_, Nil))))  -> " ++ pascal ++ ".Controllers.Auth.PasswordResetController.edit(conn)")
  println("     (:patch, Cons(\"users\", Cons(\"reset_password\", Cons(_, Nil)))) -> " ++ pascal ++ ".Controllers.Auth.PasswordResetController.update(conn)")
  println("")
  println("2. Protect routes that require a logged-in user (in your router pipeline):")
  println("")
  println("     alias " ++ pascal ++ ".Auth as Auth")
  println("     let conn2 = Auth.require_authenticated_user(conn)")
  println("")
  println("   In controllers, read the current user with Auth.current_user(conn).")
  println("")
  println("3. Run the migrations:")
  println("")
  println("     forge depot migrate")
  println("")
  println("4. Replace placeholder HTML in each controller with real ~H templates.")
  println("5. Implement " ++ pascal ++ ".Accounts.UserNotifier to send real emails.")

  Ok(())
end

fn main() do
  let _ = run()
  ()
end

end
