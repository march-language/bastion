-- Forge.GenAuth — forge bastion gen auth
--
-- Generates authentication boilerplate for a Bastion web application.
-- Modelled on Phoenix phx.gen.auth — produces ready-to-use files that
-- developers can customise.
--
-- Files created:
--   lib/<app>/accounts/user.march
--   lib/<app>/accounts/user_token.march
--   lib/<app>/accounts/user_notifier.march
--   lib/<app>/accounts.march
--   lib/<app>/auth.march
--   lib/<app>/controllers/auth/registration_controller.march
--   lib/<app>/controllers/auth/session_controller.march
--   lib/<app>/controllers/auth/user_settings_controller.march
--   lib/<app>/controllers/auth/confirmation_controller.march
--   priv/depot/migrations/<ts>_create_users.march
--   priv/depot/migrations/<ts+1>_create_user_tokens.march
--   test/support/accounts_fixtures.march
--
-- Ported from gen_auth.ml.

mod Forge.GenAuth do

  needs IO.Console

-- Capitalise the first character of a string.
pfn capitalize(s) do
  if String.is_empty(s) do s
  else
    String.to_uppercase(String.slice_bytes(s, 0, 1)) ++ String.slice_bytes(s, 1, String.byte_size(s) - 1)
  end
end

-- Produce a literal ${name} for use inside generated source templates.
pfn iv(_name) do
  "${" ++ _name ++ "}"
end

-- Produce a literal """ for use inside generated source templates.
pfn tq() do
  "\"\"\""
end

-- Derive the Pascal module name from the cwd basename.
pfn detect_app_name() do
  let name = Path.basename(Process.cwd())
  let parts = String.split(name, "_")
  let non_empty = List.filter(parts, fn p -> !String.is_empty(p))
  List.map(non_empty, fn p -> capitalize(p))
    |> String.join("")
end

-- ── Templates ────────────────────────────────────────────────────────────────

pfn user_schema_source(pascal) do
  """-- Auto-generated by forge bastion gen auth
-- Represents a registered user account.
-- Passwords are hashed with PBKDF2-SHA256 via Crypto.hash_password.

mod """ ++ pascal ++ """.Accounts.User do

alias Depot.Gate as Gate
alias Depot.Schema as Schema

fn schema() do
  Schema.define("users", {
    fields: {
      email: "String",
      hashed_password: "String",
      confirmed_at: ("UtcDatetime", { null: true }),
      inserted_at: "UtcDatetime",
      updated_at: "UtcDatetime"
    }
  })
end

-- Gate for new user registration.
fn registration_gate(params) do
  Gate.cast(params, ["email", "password"])
    |> Gate.validate_required(["email", "password"])
    |> validate_email()
    |> validate_password()
end

fn update_email_gate(user, params) do
  Gate.cast_record(user, params, ["email"])
    |> Gate.validate_required(["email"])
    |> validate_email()
end

fn update_password_gate(user, params) do
  Gate.cast_record(user, params, ["password", "password_confirmation"])
    |> Gate.validate_required(["password", "password_confirmation"])
    |> validate_password()
    |> Gate.validate_confirmation("password")
end

fn hash_password(gate) do
  match Gate.get_change(gate, "password") do
  None -> gate
  Some(password) ->
    let hashed = Crypto.hash_password(password)
    Gate.put_change(gate, "hashed_password", hashed)
      |> Gate.delete_change("password")
  end
end

fn valid_password(user, password) do
  Crypto.verify_password(password, user.hashed_password)
end

pfn validate_email(gate) do
  Gate.validate_format(gate, "email", ".+@.+\\..+")
    |> Gate.validate_length("email", [LenMax(160)])
    |> Gate.unique_constraint("email",
        [ConstraintName("users_email_index"),
         ConstraintMessage("has already been taken")])
end

pfn validate_password(gate) do
  Gate.validate_length(gate, "password", [LenMin(12), LenMax(72)])
end

end
"""
end

pfn user_token_schema_source(pascal) do
  """-- Auto-generated by forge bastion gen auth
-- Stores session tokens and email-based tokens (confirmation, password reset).

mod """ ++ pascal ++ """.Accounts.UserToken do

alias Depot.Gate as Gate
alias Depot.Schema as Schema

let session_validity_days      = 60
let confirm_validity_days      = 7
let change_email_validity_days = 7
let reset_validity_days        = 1

fn schema() do
  Schema.define("user_tokens", {
    fields: {
      user_id: "UUID",
      token: "String",
      context: "String",
      sent_to: ("String", { null: true }),
      inserted_at: "UtcDatetime"
    }
  })
end

-- Build a session token gate.
-- Returns (raw_token, gate) — insert the gate, hand the raw token to the browser.
fn build_session_token(user) do
  let token = Crypto.random_hex(32)
  let gate = Gate.cast(
    [("user_id", user.id), ("token", token), ("context", "session")],
    ["user_id", "token", "context"]
  )
  (token, gate)
end

-- Build an email token gate (confirmation, password reset, email change).
-- Returns (raw_token, gate) — insert the gate, email the raw token.
-- The stored token is the SHA-256 hash of the raw token.
fn build_email_token(user, context) do
  let token = Crypto.random_hex(32)
  let hashed = Crypto.sha256(token)
  let gate = Gate.cast(
    [("user_id", user.id), ("token", hashed),
     ("context", context), ("sent_to", user.email)],
    ["user_id", "token", "context", "sent_to"]
  )
  (token, gate)
end

end
"""
end

