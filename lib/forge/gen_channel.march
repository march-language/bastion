-- Forge.GenChannel — forge bastion.gen.channel <Name>
--
-- Generates a WebSocket channel handler stub.
--
-- Usage:
--   forge bastion.gen.channel Room
--   forge bastion.gen.channel Chat
--
-- The generated module implements the Bastion.Channel behaviour:
--   fn join/3       — authorise and set up the socket connection
--   fn handle_in/3  — handle incoming messages from the client
--   fn handle_out/3 — intercept outgoing broadcasts (optional)

mod Forge.GenChannel do

  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process

-- ── Name helpers ─────────────────────────────────────────────────────────────

pfn capitalize(s) do
  if String.is_empty(s) do s
  else String.to_uppercase(String.slice_bytes(s, 0, 1)) ++ String.slice_bytes(s, 1, String.byte_size(s) - 1)
  end
end

pfn pascal_to_snake(s) do
  let chars = String.split(s, "")
  pascal_to_snake_loop(chars, "", true)
end

pfn pascal_to_snake_loop(chars, acc, first) do
  match chars do
  Nil -> acc
  Cons(c, rest) -> do
    let upper    = String.to_uppercase(c)
    let is_upper = c == upper && !String.is_empty(String.trim(c))
    if is_upper && !first do
      pascal_to_snake_loop(rest, acc ++ "_" ++ String.to_lowercase(c), false)
    else
      pascal_to_snake_loop(rest, acc ++ String.to_lowercase(c), false)
    end
  end
  end
end

pfn detect_app_name() do
  let name = Path.basename(Process.cwd())
  let parts = String.split(name, "_")
  let non_empty = List.filter(parts, fn p -> !String.is_empty(p))
  List.map(non_empty, fn p -> capitalize(p))
    |> String.join("")
end

-- ── Channel template ──────────────────────────────────────────────────────────

pfn channel_source(app_name, pascal, snake) do
  let topic_prefix = String.to_lowercase(snake)
  "-- Auto-generated by forge bastion.gen.channel\n\n" ++
  "mod " ++ app_name ++ "." ++ pascal ++ "Channel do\n\n" ++
  "import Bastion.Channel\n\n" ++
  "-- Called when a client joins a topic matching \"" ++ topic_prefix ++ ":*\".\n" ++
  "-- Return Ok(conn) to accept the join, Err(:unauthorized) to reject.\n" ++
  "fn join(conn, _topic, _params) do\n" ++
  "  Ok(conn)\n" ++
  "end\n\n" ++
  "-- Called for each message pushed from the client.\n" ++
  "-- Use Channel.broadcast/3 to fan out to all topic subscribers.\n" ++
  "fn handle_in(conn, event, _params) do\n" ++
  "  match event do\n" ++
  "  _ -> conn\n" ++
  "  end\n" ++
  "end\n\n" ++
  "-- Called before an outgoing broadcast reaches this socket.\n" ++
  "-- Return Ok(conn) to deliver, Err(:drop) to suppress for this subscriber.\n" ++
  "fn handle_out(conn, _event, _payload) do\n" ++
  "  Ok(conn)\n" ++
  "end\n\n" ++
  "end\n"
end

-- ── Entry point ───────────────────────────────────────────────────────────────

fn run(args) do
  match args do
  Nil -> do
    println("Usage: forge bastion.gen.channel <Name>")
    println("  <Name>  PascalCase channel name (e.g. Room, Chat, Notification)")
    println("")
    println("Examples:")
    println("  forge bastion.gen.channel Room")
    println("  forge bastion.gen.channel Notification")
  end
  Cons(name, _) -> do
    let snake     = pascal_to_snake(name)
    let app_name  = detect_app_name()
    let lower_app = String.to_lowercase(app_name)
    let chan_dir  = "lib/" ++ lower_app ++ "/channels"
    let chan_file = chan_dir ++ "/" ++ snake ++ "_channel.march"
    let _ = Dir.mkdir_p(chan_dir)
    match File.exists(chan_file) do
    true  -> println("  Skipping " ++ chan_file ++ " (already exists)")
    false -> do
      let _ = File.write(chan_file, channel_source(app_name, name, snake))
      println("  Created  " ++ chan_file)
    end
    end
    println("")
    println("Register in your endpoint (lib/" ++ lower_app ++ "/endpoint.march):")
    println("")
    println("  |> Bastion.Channel.socket(\"/socket\", " ++ app_name ++ "." ++ name ++ "Channel)")
    println("")
    println("Client-side usage:")
    println("")
    println("  const channel = socket.channel(\"" ++ snake ++ ":lobby\", {})")
    println("  channel.join()")
    println("  channel.push(\"event_name\", { key: \"value\" })")
    println("")
  end
  end
end

fn main(_cap_console : Cap(IO.Console), _cap_fileread : Cap(IO.FileRead), _cap_filewrite : Cap(IO.FileWrite), _cap_process : Cap(IO.Process)) do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  run(args)
end

end
