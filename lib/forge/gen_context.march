-- Forge.GenContext — forge bastion.gen.context <Context> <Schema> <table> [field:type ...]
--
-- Generates a context module, schema module, and migration from a field spec.
--
-- Usage:
--   forge bastion.gen.context Accounts User users name:string email:string
--   forge bastion.gen.context Blog Post posts title:string body:text published_at:datetime
--
-- Supported field types (map to Depot column types):
--   string    → String (varchar 255)
--   text      → Text
--   integer   → Int
--   float     → Float
--   boolean   → Bool
--   datetime  → UtcDatetime
--   date      → Date
--   uuid      → UUID
--
-- Files created:
--   lib/<app>/<context_snake>/<schema_snake>.march     — schema + gate
--   lib/<app>/<context_snake>.march                    — context CRUD API
--   priv/depot/migrations/<ts>_create_<table>.march    — migration

mod Forge.GenContext do

-- ── Name helpers ─────────────────────────────────────────────────────────────

pfn capitalize(s) do
  if String.is_empty(s) do s
  else String.to_uppercase(String.slice_bytes(s, 0, 1)) ++ String.slice_bytes(s, 1, String.byte_size(s) - 1)
  end
end

pfn pascal_to_snake(s) do
  let chars = String.split(s, "")
  pascal_to_snake_loop(chars, "", true)
end

pfn pascal_to_snake_loop(chars, acc, first) do
  match chars do
  Nil -> acc
  Cons(c, rest) -> do
    let upper    = String.to_uppercase(c)
    let is_upper = c == upper && !String.is_empty(String.trim(c))
    if is_upper && !first do
      pascal_to_snake_loop(rest, acc ++ "_" ++ String.to_lowercase(c), false)
    else
      pascal_to_snake_loop(rest, acc ++ String.to_lowercase(c), false)
    end
  end
  end
end

pfn snake_to_pascal(s) do
  let parts     = String.split(s, "_")
  let non_empty = List.filter(parts, fn p -> !String.is_empty(p))
  List.map(non_empty, fn p -> capitalize(p)) |> String.join("")
end

pfn detect_app_name() do
  let name = Path.basename(Process.cwd())
  let parts = String.split(name, "_")
  let non_empty = List.filter(parts, fn p -> !String.is_empty(p))
  List.map(non_empty, fn p -> capitalize(p)) |> String.join("")
end

-- ── Field type mapping ────────────────────────────────────────────────────────

pfn field_type_to_depot(user_type) do
  match user_type do
  "string"    -> "String"
  "text"      -> "Text"
  "integer"   -> "Int"
  "int"       -> "Int"
  "float"     -> "Float"
  "boolean"   -> "Bool"
  "bool"      -> "Bool"
  "datetime"  -> "UtcDatetime"
  "date"      -> "Date"
  "uuid"      -> "UUID"
  other       -> snake_to_pascal(other)   -- pass-through unknown types as PascalCase
  end
end

-- Parse "field:type" into (field_name, user_type)
pfn parse_field(s) do
  match String.split_first(s, ":") do
  None            -> (s, "string")   -- default to string if no type given
  Some((name, t)) -> (name, t)
  end
end

pfn parse_fields(args) do
  List.map(args, fn a -> parse_field(a))
end

-- ── Source generators ────────────────────────────────────────────────────────

pfn schema_source(app_name, context, schema, table, fields) do
  let schema_mod = app_name ++ "." ++ context ++ "." ++ schema
  let field_lines = build_schema_fields(fields, "")
  let cast_fields = build_cast_list(fields)
  let required_fields = build_required_list(fields)
  """-- Auto-generated by forge bastion.gen.context
-- Schema for """ ++ table ++ """ (""" ++ schema_mod ++ """).

mod """ ++ schema_mod ++ """ do

alias Depot.Gate as Gate
alias Depot.Schema as Schema

fn schema() do
  Schema.define(""" ++ "\"" ++ table ++ "\"" ++ """, {
    fields = {
      id = ("UUID", { primary_key = true }),
""" ++ field_lines ++ """      inserted_at = ("UtcDatetime", { null = false }),
      updated_at  = ("UtcDatetime", { null = false })
    }
  })
end

-- Gate for create operations.
fn create_gate(params) do
  Gate.cast(params, [""" ++ cast_fields ++ """])
    |> Gate.validate_required([""" ++ required_fields ++ """])
end

-- Gate for update operations.
fn update_gate(record, params) do
  Gate.cast_record(record, params, [""" ++ cast_fields ++ """])
end

end
"""
end

pfn build_schema_fields(fields, acc) do
  match fields do
  Nil -> acc
  Cons((name, user_type), rest) ->
    let depot_type = field_type_to_depot(user_type)
    let line = "      " ++ name ++ " = (\"" ++ depot_type ++ "\", { null = false }),\n"
    build_schema_fields(rest, acc ++ line)
  end
end

pfn build_cast_list(fields) do
  let names = List.map(fields, fn field -> do
    let (n, _) = field
    "\"" ++ n ++ "\""
  end)
  String.join(names, ", ")
end

pfn build_required_list(fields) do
  let names = List.map(fields, fn field -> do
    let (n, _) = field
    "\"" ++ n ++ "\""
  end)
  String.join(names, ", ")
end

pfn context_source(app_name, context, schema, table, fields) do
  let context_mod = app_name ++ "." ++ context
  let schema_mod  = app_name ++ "." ++ context ++ "." ++ schema
  let schema_var  = String.to_lowercase(schema)
  let _ = fields  -- fields not needed in context template (schema defines them)
  let _ = table
  """-- Auto-generated by forge bastion.gen.context
-- Context API for """ ++ context ++ """ (""" ++ context_mod ++ """).
-- All database access for """ ++ context ++ """ goes through this module.

mod """ ++ context_mod ++ """ do

alias """ ++ schema_mod ++ """ as """ ++ schema ++ """
alias Depot.Repo as Repo
alias Depot.Gate as Gate

doc "Fetch all """ ++ schema_var ++ """s."
fn list_""" ++ String.to_lowercase(schema) ++ """s() do
  Repo.all(""" ++ schema ++ """.schema())
end

doc "Fetch a single """ ++ schema_var ++ """ by ID. Returns None if not found."
fn get_""" ++ String.to_lowercase(schema) ++ """(id) do
  Repo.get(""" ++ schema ++ """.schema(), id)
end

doc "Create a new """ ++ schema_var ++ """ from params. Returns Ok(record) or Err(gate)."
fn create_""" ++ String.to_lowercase(schema) ++ """(params) do
  let gate = """ ++ schema ++ """.create_gate(params)
  if Gate.is_valid(gate) do
    Repo.insert(""" ++ schema ++ """.schema(), gate)
  else Err(gate) end
end

doc "Update an existing """ ++ schema_var ++ """ from params. Returns Ok(record) or Err(gate)."
fn update_""" ++ String.to_lowercase(schema) ++ """(record, params) do
  let gate = """ ++ schema ++ """.update_gate(record, params)
  if Gate.is_valid(gate) do
    Repo.update(""" ++ schema ++ """.schema(), gate)
  else Err(gate) end
end

doc "Delete a """ ++ schema_var ++ """ by ID."
fn delete_""" ++ String.to_lowercase(schema) ++ """(id) do
  Repo.delete(""" ++ schema ++ """.schema(), id)
end

doc "Build an empty gate for displaying a new """ ++ schema_var ++ """ form."
fn change_""" ++ String.to_lowercase(schema) ++ """(attrs) do
  """ ++ schema ++ """.create_gate(attrs)
end

end
"""
end

pfn migration_source(table, fields, ts) do
  let field_lines = build_migration_fields(fields, "")
  """-- Auto-generated by forge bastion.gen.context

mod Migrations.Create""" ++ snake_to_pascal(table) ++ """ do

fn up() do
  Depot.Migration.create_table(""" ++ "\"" ++ table ++ "\"" ++ """, {
    id          = ("UUID",        { primary_key = true }),
""" ++ field_lines ++ """    inserted_at = ("UtcDatetime", { null = false }),
    updated_at  = ("UtcDatetime", { null = false })
  })
end

fn down() do
  Depot.Migration.drop_table(""" ++ "\"" ++ table ++ "\"" ++ """)
end

fn version() do
  """ ++ String.from_int(ts) ++ """
end

end
"""
end

pfn build_migration_fields(fields, acc) do
  match fields do
  Nil -> acc
  Cons((name, user_type), rest) ->
    let depot_type = field_type_to_depot(user_type)
    let line = "    " ++ name ++ " = (\"" ++ depot_type ++ "\", { null = false }),\n"
    build_migration_fields(rest, acc ++ line)
  end
end

-- ── Run ──────────────────────────────────────────────────────────────────────

fn run(args) do
  match args do
  Nil -> do
    println("Usage: forge bastion.gen.context <Context> <Schema> <table> [field:type ...]")
    println("")
    println("Examples:")
    println("  forge bastion.gen.context Accounts User users name:string email:string")
    println("  forge bastion.gen.context Blog Post posts title:string body:text")
    println("")
    println("Supported types: string text integer float boolean datetime date uuid")
  end
  Cons(context, rest) ->
    match rest do
    Nil -> do
      println("Error: need Schema and table name after Context")
      println("Usage: forge bastion.gen.context <Context> <Schema> <table> [field:type ...]")
    end
    Cons(schema, rest2) ->
      match rest2 do
      Nil -> do
        println("Error: need table name after Schema")
        println("Usage: forge bastion.gen.context <Context> <Schema> <table> [field:type ...]")
      end
      Cons(table, field_args) -> do
        let app_name      = detect_app_name()
        let app_snake     = String.to_lowercase(app_name)
        let ctx_snake     = pascal_to_snake(context)
        let schema_snake  = pascal_to_snake(schema)
        let fields        = parse_fields(field_args)
        let ts            = DateTime.now()

        let lib_dir   = "lib/" ++ app_snake ++ "/" ++ ctx_snake
        let mig_dir   = "priv/depot/migrations"

        let _ = Dir.mkdir_p(lib_dir)
        let _ = Dir.mkdir_p(mig_dir)

        let write = fn path -> fn content -> do
          let _ = File.write(path, content)
          println("  Created  " ++ path)
        end

        let schema_file  = lib_dir ++ "/" ++ schema_snake ++ ".march"
        let context_file = "lib/" ++ app_snake ++ "/" ++ ctx_snake ++ ".march"
        let mig_file     = mig_dir ++ "/" ++ String.from_int(ts) ++ "_create_" ++ table ++ ".march"

        write(schema_file)(schema_source(app_name, context, schema, table, fields))
        write(context_file)(context_source(app_name, context, schema, table, fields))
        write(mig_file)(migration_source(table, fields, ts))

        println("")
        println("Done!  Context generated.")
        println("")
        println("Next steps:")
        println("")
        println("1. Run the migration:")
        println("     forge bastion.depot.migrate")
        println("")
        println("2. Use the context in your handlers:")
        println("     alias " ++ app_name ++ "." ++ context ++ " as " ++ context)
        println("     let items = " ++ context ++ ".list_" ++ String.to_lowercase(schema) ++ "s()")
        println("")
        println("3. Generate a handler:")
        println("     forge bastion.gen.handler " ++ schema ++ " index show new create edit update delete")
      end
      end
    end
  end
end

fn main() do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  run(args)
end

end
