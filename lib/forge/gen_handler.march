-- Forge.GenHandler — forge bastion.gen.handler <Name> [action ...]
--
-- Generates a controller module stub with the specified actions.
--
-- Usage:
--   forge bastion.gen.handler Users
--   forge bastion.gen.handler Users index show new create edit update delete
--
-- Without explicit actions, all seven CRUD actions are generated:
--   index   GET    /<plural>
--   show    GET    /<plural>/:id
--   new     GET    /<plural>/new
--   create  POST   /<plural>
--   edit    GET    /<plural>/:id/edit
--   update  PUT    /<plural>/:id
--   delete  DELETE /<plural>/:id

mod Forge.GenHandler do

needs IO.File, IO.FS

-- ── Name helpers ─────────────────────────────────────────────────────────────

pfn capitalize(s) do
  if String.is_empty(s) do s
  else String.to_uppercase(String.slice_bytes(s, 0, 1)) ++ String.slice_bytes(s, 1, String.byte_size(s) - 1)
  end
end

pfn pascal_to_snake(s) do
  let chars = String.split(s, "")
  pascal_to_snake_loop(chars, "", true)
end

pfn pascal_to_snake_loop(chars, acc, first) do
  match chars do
  Nil -> acc
  Cons(c, rest) -> do
    let upper    = String.to_uppercase(c)
    let is_upper = c == upper && !String.is_empty(String.trim(c))
    if is_upper && !first do
      pascal_to_snake_loop(rest, acc ++ "_" ++ String.to_lowercase(c), false)
    else
      pascal_to_snake_loop(rest, acc ++ String.to_lowercase(c), false)
    end
  end
  end
end

pfn detect_app_name() do
  let name = Path.basename(Process.cwd())
  let parts = String.split(name, "_")
  let non_empty = List.filter(parts, fn p -> !String.is_empty(p))
  List.map(non_empty, fn p -> capitalize(p))
    |> String.join("")
end

-- ── Action templates ──────────────────────────────────────────────────────────

pfn action_source(action, pascal, plural) do
  match action do
  "index" ->
    "-- GET /" ++ plural ++ "\n" ++
    "fn index(conn) do\n" ++
    "  H.html(conn, 200, \"<h1>" ++ pascal ++ " list</h1>\")\n" ++
    "end\n"
  "show" ->
    "-- GET /" ++ plural ++ "/:id\n" ++
    "fn show(conn, id) do\n" ++
    "  H.html(conn, 200, \"<h1>" ++ pascal ++ " \" ++ id ++ \"</h1>\")\n" ++
    "end\n"
  "new" ->
    "-- GET /" ++ plural ++ "/new\n" ++
    "fn new(conn) do\n" ++
    "  H.html(conn, 200, \"<h1>New " ++ pascal ++ "</h1>\")\n" ++
    "end\n"
  "create" ->
    "-- POST /" ++ plural ++ "\n" ++
    "fn create(conn) do\n" ++
    "  H.redirect(conn, 302, \"/" ++ plural ++ "\")\n" ++
    "end\n"
  "edit" ->
    "-- GET /" ++ plural ++ "/:id/edit\n" ++
    "fn edit(conn, id) do\n" ++
    "  H.html(conn, 200, \"<h1>Edit " ++ pascal ++ " \" ++ id ++ \"</h1>\")\n" ++
    "end\n"
  "update" ->
    "-- PUT /" ++ plural ++ "/:id\n" ++
    "fn update(conn, id) do\n" ++
    "  H.redirect(conn, 302, \"/" ++ plural ++ "/\" ++ id)\n" ++
    "end\n"
  "delete" ->
    "-- DELETE /" ++ plural ++ "/:id\n" ++
    "fn delete(conn, id) do\n" ++
    "  H.redirect(conn, 302, \"/" ++ plural ++ "\")\n" ++
    "end\n"
  other ->
    "fn " ++ other ++ "(conn) do\n" ++
    "  H.html(conn, 200, \"" ++ other ++ "\")\n" ++
    "end\n"
  end
end

pfn controller_source(app_name, pascal, snake, actions) do
  let plural = snake ++ "s"
  let bodies = List.map(actions, fn a -> "\n" ++ action_source(a, pascal, plural))
    |> String.join("")
  "-- Auto-generated by forge bastion.gen.handler\n\n" ++
  "mod " ++ app_name ++ ".Controllers." ++ pascal ++ "Controller do\n\n" ++
  "alias HttpServer as H\n" ++
  bodies ++
  "\nend\n"
end

pfn test_source(app_name, pascal, actions) do
  let stubs = List.map(actions, fn a ->
    "  test \"" ++ a ++ " placeholder\" do\n    assert true\n  end\n")
    |> String.join("")
  "-- Auto-generated by forge bastion.gen.handler\n\n" ++
  "mod " ++ app_name ++ ".Controllers.Test" ++ pascal ++ "Controller do\n\n" ++
  "describe \"" ++ pascal ++ "Controller\" do\n\n" ++
  stubs ++
  "\nend\n\nend\n"
end

-- ── Route snippet ─────────────────────────────────────────────────────────────

pfn print_route_for(app_name, pascal, action, plural) do
  match action do
  "index" -> do
    println("  -- ROUTE: GET /" ++ plural)
    println("  (:get, Cons(\"" ++ plural ++ "\", Nil)) ->")
    println("    " ++ app_name ++ ".Controllers." ++ pascal ++ "Controller.index(conn)")
    println("")
  end
  "new" -> do
    println("  -- ROUTE: GET /" ++ plural ++ "/new")
    println("  (:get, Cons(\"" ++ plural ++ "\", Cons(\"new\", Nil))) ->")
    println("    " ++ app_name ++ ".Controllers." ++ pascal ++ "Controller.new(conn)")
    println("")
  end
  "show" -> do
    println("  -- ROUTE: GET /" ++ plural ++ "/:id")
    println("  (:get, Cons(\"" ++ plural ++ "\", Cons(id, Nil))) ->")
    println("    " ++ app_name ++ ".Controllers." ++ pascal ++ "Controller.show(conn, id)")
    println("")
  end
  "create" -> do
    println("  -- ROUTE: POST /" ++ plural)
    println("  (:post, Cons(\"" ++ plural ++ "\", Nil)) ->")
    println("    " ++ app_name ++ ".Controllers." ++ pascal ++ "Controller.create(conn)")
    println("")
  end
  "edit" -> do
    println("  -- ROUTE: GET /" ++ plural ++ "/:id/edit")
    println("  (:get, Cons(\"" ++ plural ++ "\", Cons(id, Cons(\"edit\", Nil)))) ->")
    println("    " ++ app_name ++ ".Controllers." ++ pascal ++ "Controller.edit(conn, id)")
    println("")
  end
  "update" -> do
    println("  -- ROUTE: PUT /" ++ plural ++ "/:id")
    println("  (:put, Cons(\"" ++ plural ++ "\", Cons(id, Nil))) ->")
    println("    " ++ app_name ++ ".Controllers." ++ pascal ++ "Controller.update(conn, id)")
    println("")
  end
  "delete" -> do
    println("  -- ROUTE: DELETE /" ++ plural ++ "/:id")
    println("  (:delete, Cons(\"" ++ plural ++ "\", Cons(id, Nil))) ->")
    println("    " ++ app_name ++ ".Controllers." ++ pascal ++ "Controller.delete(conn, id)")
    println("")
  end
  _ -> ()
  end
end

pfn print_route_snippet(app_name, pascal, snake, actions) do
  let plural    = snake ++ "s"
  let lower_app = String.to_lowercase(app_name)
  println("")
  println("Add to your router (lib/" ++ lower_app ++ "/router.march):")
  println("")
  let _ = List.map(actions, fn a -> print_route_for(app_name, pascal, a, plural))
  ()
end

-- ── Entry point ───────────────────────────────────────────────────────────────

fn run(args) do
  match args do
  Nil -> do
    println("Usage: forge bastion.gen.handler <Name> [action ...]")
    println("  <Name>     PascalCase resource name (e.g. Users, Post)")
    println("  [action]   one or more of: index show new create edit update delete")
    println("")
    println("Without explicit actions, all seven CRUD actions are generated.")
    println("")
    println("Examples:")
    println("  forge bastion.gen.handler Users")
    println("  forge bastion.gen.handler Post index show")
  end
  Cons(name, rest) -> do
    let actions = match rest do
      Nil -> ["index", "show", "new", "create", "edit", "update", "delete"]
      _   -> rest
    end
    let snake     = pascal_to_snake(name)
    let app_name  = detect_app_name()
    let lower_app = String.to_lowercase(app_name)
    let ctrl_dir  = "lib/" ++ lower_app ++ "/controllers"
    let test_dir  = "test/controllers"
    let ctrl_file = ctrl_dir ++ "/" ++ snake ++ "_controller.march"
    let test_file = test_dir ++ "/test_" ++ snake ++ "_controller.march"
    let _ = Dir.mkdir_p(ctrl_dir)
    let _ = Dir.mkdir_p(test_dir)
    match File.exists(ctrl_file) do
    true  -> println("  Skipping " ++ ctrl_file ++ " (already exists)")
    false -> do
      let _ = File.write(ctrl_file, controller_source(app_name, name, snake, actions))
      println("  Created  " ++ ctrl_file)
    end
    end
    match File.exists(test_file) do
    true  -> println("  Skipping " ++ test_file ++ " (already exists)")
    false -> do
      let _ = File.write(test_file, test_source(app_name, name, actions))
      println("  Created  " ++ test_file)
    end
    end
    print_route_snippet(app_name, name, snake, actions)
  end
  end
end

fn main() do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  run(args)
end

end
