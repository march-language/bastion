-- Forge.GenMigration — forge bastion.gen.migration <name>
--
-- Generates a blank Depot migration file in priv/depot/migrations/.
--
-- Usage:
--   forge bastion.gen.migration create_users
--   forge bastion.gen.migration add_email_to_users
--
-- The generated file contains empty up/down stubs and a version timestamp.
-- Edit the up() function to define schema changes using Depot.Migration helpers.

mod Forge.GenMigration do

  needs IO.Console
  needs IO.Clock
  needs IO.FileWrite
  needs IO.Process

-- ── Name helpers ─────────────────────────────────────────────────────────────

pfn capitalize(s) do
  if String.is_empty(s) do s
  else String.to_uppercase(String.slice_bytes(s, 0, 1)) ++ String.slice_bytes(s, 1, String.byte_size(s) - 1)
  end
end

pfn snake_to_pascal(s) do
  let parts     = String.split(s, "_")
  let non_empty = List.filter(parts, fn p -> !String.is_empty(p))
  List.map(non_empty, fn p -> capitalize(p))
    |> String.join("")
end

-- ── Migration template ────────────────────────────────────────────────────────

pfn migration_source(pascal_name, ts_str) do
  "-- Auto-generated by forge bastion.gen.migration\n\n" ++
  "mod Migrations." ++ pascal_name ++ " do\n\n" ++
  "fn up() do\n" ++
  "  -- TODO: implement migration\n" ++
  "  -- Example:\n" ++
  "  -- Depot.Migration.create_table(\"table_name\", {\n" ++
  "  --   id         = (\"UUID\",        { primary_key: true }),\n" ++
  "  --   name       = (\"String\",      { null: false }),\n" ++
  "  --   inserted_at = (\"UtcDatetime\", { null: false }),\n" ++
  "  --   updated_at  = (\"UtcDatetime\", { null: false })\n" ++
  "  -- })\n" ++
  "  ()\n" ++
  "end\n\n" ++
  "fn down() do\n" ++
  "  -- TODO: implement rollback\n" ++
  "  -- Example: Depot.Migration.drop_table(\"table_name\")\n" ++
  "  ()\n" ++
  "end\n\n" ++
  "fn version() do\n" ++
  "  " ++ ts_str ++ "\n" ++
  "end\n\n" ++
  "end\n"
end

-- ── Entry point ───────────────────────────────────────────────────────────────

fn run(args) do
  match args do
  Nil -> do
    println("Usage: forge bastion.gen.migration <name>")
    println("  <name>  snake_case migration name")
    println("")
    println("Examples:")
    println("  forge bastion.gen.migration create_users")
    println("  forge bastion.gen.migration add_email_to_users")
    println("  forge bastion.gen.migration create_posts_table")
  end
  Cons(name, _) -> do
    let pascal   = snake_to_pascal(name)
    let ts       = DateTime.now()
    let ts_str   = String.from_int(ts)
    let mig_dir  = "priv/depot/migrations"
    let mig_file = mig_dir ++ "/" ++ ts_str ++ "_" ++ name ++ ".march"
    let _ = Dir.mkdir_p(mig_dir)
    let _ = File.write(mig_file, migration_source(pascal, ts_str))
    println("  Created  " ++ mig_file)
    println("")
    println("Run pending migrations with:")
    println("  forge bastion.depot.migrate")
    println("")
  end
  end
end

fn main(_cap_console : Cap(IO.Console), _cap_clock : Cap(IO.Clock), _cap_filewrite : Cap(IO.FileWrite), _cap_process : Cap(IO.Process)) do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  run(args)
end

end
