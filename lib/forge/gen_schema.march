-- Forge.GenSchema — forge bastion gen schema/json/context
--
-- Generates Depot schema modules, migration files, context modules,
-- and JSON API handlers from CLI arguments.
--
-- Subcommands:
--   forge bastion gen schema <Module> <table> field:type ...
--   forge bastion gen json   <Context> <Module> field:type ...
--   forge bastion gen context <Context> <Module>
--
-- Ported from cmd_bastion_gen.ml.

mod Forge.GenSchema do

needs IO.File, IO.FS

-- ── Type mapping ─────────────────────────────────────────────────────────────

pfn march_type_of(t) do
  match t do
  "string"             -> "String"
  "integer"            -> "Int"
  "int"                -> "Int"
  "float"              -> "Float"
  "bool"               -> "Bool"
  "boolean"            -> "Bool"
  "uuid"               -> "UUID"
  "datetime"           -> "UtcDatetime"
  "date"               -> "Date"
  "time"               -> "Time"
  "map"                -> "Map"
  "json"               -> "Map"
  "binary"             -> "Binary"
  other                -> other
  end
end

-- ── Field spec parsing ───────────────────────────────────────────────────────

-- Parse a "name:type" field specification.
pfn parse_field(spec) do
  match String.split(spec, ":") do
  [name, typ] -> Ok((name, typ))
  _           -> Err("invalid field spec: " ++ spec ++ " (expected name:type)")
  end
end

pfn collect_fields(specs) do
  List.map(specs, fn s -> parse_field(s))
end

pfn all_ok(results) do
  let errs = List.filter_map(results, fn r ->
    match r do
    Err(e) -> Some(e)
    Ok(_)  -> None
    end
  )
  if List.is_empty(errs) do
    let fields = List.filter_map(results, fn r ->
      match r do
      Ok(f)  -> Some(f)
      Err(_) -> None
      end
    )
    Ok(fields)
  else
    Err(String.join(errs, "\n"))
  end
end

-- ── App name detection ───────────────────────────────────────────────────────

pfn detect_app_name() do
  let name = Path.basename(FS.cwd())
  let parts = String.split(name, "_")
  let non_empty = List.filter(parts, fn p -> !String.is_empty(p))
  List.map(non_empty, fn p -> String.capitalize(p))
    |> String.join("")
end

-- ── Schema template ──────────────────────────────────────────────────────────

pfn schema_source(app_name, module_name, table_name, fields) do
  let field_defs = fields
    |> List.map(fn (name, typ) -> "      " ++ name ++ " = \"" ++ march_type_of(typ) ++ "\"")
    |> String.join(",\n")
  let field_names = fields
    |> List.map(fn (name, _) -> "\"" ++ name ++ "\"")
    |> String.join(", ")
  """-- Auto-generated by forge bastion gen schema

mod """ ++ app_name ++ """.""" ++ module_name ++ """ do

fn schema() do
  Depot.Schema.define("""" ++ table_name ++ """", {
    fields = {
""" ++ field_defs ++ """,
      inserted_at = "UtcDatetime",
      updated_at = "UtcDatetime"
    }
  })
end

fn gate(params) do
  Depot.Gate.cast_record(Depot.Schema.blank(schema()), params, [""" ++ field_names ++ """])
    |> Depot.Gate.validate_required([""" ++ field_names ++ """])
end

fn update_gate(base, params) do
  Depot.Gate.cast_record(base, params, [""" ++ field_names ++ """])
end

end
"""
end

-- ── Migration template ───────────────────────────────────────────────────────

pfn migration_source(module_name, table_name, fields) do
  let col_defs = fields
    |> List.map(fn (name, typ) ->
        "    " ++ name ++ " = (\"" ++ march_type_of(typ) ++ "\", { null = false })")
    |> String.join(",\n")
  let timestamp = Time.unix_seconds()
  let migration_mod = "Create" ++ module_name
  """-- Auto-generated by forge bastion gen schema

mod Migrations.""" ++ migration_mod ++ """ do

fn up() do
  Depot.Migration.create_table("""" ++ table_name ++ """", {
    id = ("UUID", { primary_key = true }),
""" ++ col_defs ++ """,
    inserted_at = ("UtcDatetime", { null = false }),
    updated_at = ("UtcDatetime", { null = false })
  })
end

fn down() do
  Depot.Migration.drop_table("""" ++ table_name ++ """")
end

fn version() do
  """ ++ Int.to_string(timestamp) ++ """
end

end
"""
end

-- ── Context template ─────────────────────────────────────────────────────────

pfn context_source(app_name, context_name, module_name) do
  let lmod = String.downcase(module_name)
  """-- Auto-generated by forge bastion gen json

mod """ ++ app_name ++ "." ++ context_name ++ """ do

fn list_""" ++ lmod ++ """s() do
  """ ++ app_name ++ """.Repo.all(""" ++ app_name ++ "." ++ module_name ++ """.schema())
end

fn get_""" ++ lmod ++ """(id) do
  """ ++ app_name ++ """.Repo.get(""" ++ app_name ++ "." ++ module_name ++ """.schema(), id)
end

fn get_""" ++ lmod ++ """!(id) do
  """ ++ app_name ++ """.Repo.get!(""" ++ app_name ++ "." ++ module_name ++ """.schema(), id)
end

fn create_""" ++ lmod ++ """(params) do
  let gate = """ ++ app_name ++ "." ++ module_name ++ """.gate(params)
  match Depot.Gate.is_valid(gate) do
    true  -> """ ++ app_name ++ """.Repo.insert(gate)
    false -> Err(gate)
  end
end

fn update_""" ++ lmod ++ "(" ++ lmod ++ """, params) do
  let gate = """ ++ app_name ++ "." ++ module_name ++ ".update_gate(" ++ lmod ++ """, params)
  match Depot.Gate.is_valid(gate) do
    true  -> """ ++ app_name ++ """.Repo.update(gate)
    false -> Err(gate)
  end
end

fn delete_""" ++ lmod ++ "(" ++ lmod ++ """) do
  """ ++ app_name ++ ".Repo.delete(" ++ lmod ++ """)
end

end
"""
end

-- ── JSON handler template ────────────────────────────────────────────────────

pfn handler_source(app_name, context_name, module_name) do
  let lmod = String.downcase(module_name)
  let lctx = String.downcase(context_name)
  let plural = lctx ++ "s"
  """-- Auto-generated by forge bastion gen json

mod """ ++ app_name ++ ".Handlers." ++ module_name ++ """Handler do

alias Bastion.Conn as Conn

-- GET /api/""" ++ plural ++ """
fn index(conn) do
  let items = """ ++ app_name ++ "." ++ context_name ++ ".list_" ++ lmod ++ """s()
  Conn.json(conn, 200, items)
end

-- GET /api/""" ++ plural ++ """/:id
fn show(conn, id) do
  match """ ++ app_name ++ "." ++ context_name ++ ".get_" ++ lmod ++ """(id) do
    Some(item) ->
      Conn.json(conn, 200, item)
    None ->
      Conn.json(conn, 404, { error = "not found" })
  end
end

-- POST /api/""" ++ plural ++ """
fn create(conn) do
  let params = Conn.json_params(conn)
  match """ ++ app_name ++ "." ++ context_name ++ ".create_" ++ lmod ++ """(params) do
    Ok(item) ->
      Conn.json(conn, 201, item)
    Err(gate) ->
      Conn.json(conn, 422, { errors = Depot.Gate.errors(gate) })
  end
end

-- PUT /api/""" ++ plural ++ """/:id
fn update(conn, id) do
  match """ ++ app_name ++ "." ++ context_name ++ ".get_" ++ lmod ++ """(id) do
    None ->
      Conn.json(conn, 404, { error = "not found" })
    Some(item) ->
      let params = Conn.json_params(conn)
      match """ ++ app_name ++ "." ++ context_name ++ ".update_" ++ lmod ++ """(item, params) do
        Ok(updated) ->
          Conn.json(conn, 200, updated)
        Err(gate) ->
          Conn.json(conn, 422, { errors = Depot.Gate.errors(gate) })
      end
  end
end

-- DELETE /api/""" ++ plural ++ """/:id
fn delete(conn, id) do
  match """ ++ app_name ++ "." ++ context_name ++ ".get_" ++ lmod ++ """(id) do
    None ->
      Conn.json(conn, 404, { error = "not found" })
    Some(item) ->
      """ ++ app_name ++ "." ++ context_name ++ ".delete_" ++ lmod ++ """(item)
      Conn.json(conn, 204, {})
  end
end

fn not_found(conn) do
  Conn.json(conn, 404, { error = "not found" })
end

end
"""
end

-- ── Handler test template ────────────────────────────────────────────────────

pfn handler_test_source(app_name, module_name) do
  let lmod = String.downcase(module_name)
  """-- Auto-generated by forge bastion gen json

mod """ ++ app_name ++ ".Handlers.Test" ++ module_name ++ """Handler do

describe """" ++ module_name ++ """Handler" do

  test "index returns list of """ ++ lmod ++ """s" do
    assert true
  end

  test "show returns a single """ ++ lmod ++ """" do
    assert true
  end

  test "show returns 404 for missing """ ++ lmod ++ """" do
    assert true
  end

  test "create with valid params returns 201" do
    assert true
  end

  test "create with invalid params returns 422" do
    assert true
  end

  test "update with valid params returns 200" do
    assert true
  end

  test "update with invalid params returns 422" do
    assert true
  end

  test "delete removes """ ++ lmod ++ """ and returns 204" do
    assert true
  end

end

end
"""
end

-- ── Route snippet printer ────────────────────────────────────────────────────

pfn print_route_snippet(app_name, module_name, lower_ctx) do
  let lower_app = String.downcase(app_name)
  let plural    = lower_ctx ++ "s"
  IO.println("")
  IO.println("Add to your router (lib/" ++ lower_app ++ "/router.march):")
  IO.println("")
  IO.println("  -- ROUTE: GET /api/" ++ plural)
  IO.println("  (:get,    Cons(\"api\", Cons(\"" ++ plural ++ "\", Nil))) ->")
  IO.println("    " ++ app_name ++ ".Handlers." ++ module_name ++ "Handler.index(conn)")
  IO.println("")
  IO.println("  -- ROUTE: GET /api/" ++ plural ++ "/:id")
  IO.println("  (:get,    Cons(\"api\", Cons(\"" ++ plural ++ "\", Cons(id, Nil)))) ->")
  IO.println("    " ++ app_name ++ ".Handlers." ++ module_name ++ "Handler.show(conn, id)")
  IO.println("")
  IO.println("  -- ROUTE: POST /api/" ++ plural)
  IO.println("  (:post,   Cons(\"api\", Cons(\"" ++ plural ++ "\", Nil))) ->")
  IO.println("    " ++ app_name ++ ".Handlers." ++ module_name ++ "Handler.create(conn)")
  IO.println("")
  IO.println("  -- ROUTE: PUT /api/" ++ plural ++ "/:id")
  IO.println("  (:put,    Cons(\"api\", Cons(\"" ++ plural ++ "\", Cons(id, Nil)))) ->")
  IO.println("    " ++ app_name ++ ".Handlers." ++ module_name ++ "Handler.update(conn, id)")
  IO.println("")
  IO.println("  -- ROUTE: DELETE /api/" ++ plural ++ "/:id")
  IO.println("  (:delete, Cons(\"api\", Cons(\"" ++ plural ++ "\", Cons(id, Nil)))) ->")
  IO.println("    " ++ app_name ++ ".Handlers." ++ module_name ++ "Handler.delete(conn, id)")
  IO.println("")
end

-- ── Public entry points ───────────────────────────────────────────────────────

doc """
Generate a Depot schema module and migration from a list of field:type specs.

  forge bastion gen schema <Module> <table> field:type ...
"""
fn run_schema(module_name, table_name, field_specs) do
  match all_ok(collect_fields(field_specs)) do
  Err(msg) -> Err(msg)
  Ok(fields) ->
    let app_name = detect_app_name()
    let schema_dir = "lib/" ++ String.downcase(app_name)
    Dir.make_all(schema_dir)
    let schema_file = schema_dir ++ "/" ++ String.downcase(module_name) ++ ".march"
    File.write(schema_file, schema_source(app_name, module_name, table_name, fields))
    IO.println("* creating " ++ schema_file)
    let mig_dir = "priv/depot/migrations"
    Dir.make_all(mig_dir)
    let ts = Time.unix_seconds()
    let mig_file = mig_dir ++ "/" ++ Int.to_string(ts) ++ "_create_" ++ table_name ++ ".march"
    File.write(mig_file, migration_source(module_name, table_name, fields))
    IO.println("* creating " ++ mig_file)
    Ok(())
  end
end

doc """
Generate a JSON API scaffold: schema, migration, context, handler, and test.

  forge bastion gen json <Context> <Module> field:type ...
"""
fn run_json(context_name, module_name, field_specs) do
  match all_ok(collect_fields(field_specs)) do
  Err(msg) -> Err(msg)
  Ok(fields) ->
    let app_name  = detect_app_name()
    let lmod      = String.downcase(module_name)
    let lctx      = String.downcase(context_name)
    let table_name = lmod ++ "s"
    let ts = Time.unix_seconds()

    -- 1. Schema
    let schema_dir = "src/app/schemas"
    Dir.make_all(schema_dir)
    let schema_file = schema_dir ++ "/" ++ lmod ++ ".march"
    File.write(schema_file, schema_source(app_name, module_name, table_name, fields))
    IO.println("* creating " ++ schema_file)

    -- 2. Migration
    let mig_dir = "priv/depot/migrations"
    Dir.make_all(mig_dir)
    let mig_file = mig_dir ++ "/" ++ Int.to_string(ts) ++ "_create_" ++ table_name ++ ".march"
    File.write(mig_file, migration_source(module_name, table_name, fields))
    IO.println("* creating " ++ mig_file)

    -- 3. Context
    let ctx_dir = "src/app/contexts"
    Dir.make_all(ctx_dir)
    let ctx_file = ctx_dir ++ "/" ++ lctx ++ ".march"
    File.write(ctx_file, context_source(app_name, context_name, module_name))
    IO.println("* creating " ++ ctx_file)

    -- 4. Handler
    let handler_dir = "src/app/handlers"
    Dir.make_all(handler_dir)
    let handler_file = handler_dir ++ "/" ++ lmod ++ "_handler.march"
    File.write(handler_file, handler_source(app_name, context_name, module_name))
    IO.println("* creating " ++ handler_file)

    -- 5. Test
    let test_dir = "test/handlers"
    Dir.make_all(test_dir)
    let test_file = test_dir ++ "/" ++ lmod ++ "_handler_test.march"
    File.write(test_file, handler_test_source(app_name, module_name))
    IO.println("* creating " ++ test_file)

    -- 6. Route snippet
    print_route_snippet(app_name, module_name, lctx)

    Ok(())
  end
end

doc """
Generate a context module only.

  forge bastion gen context <Context> <Module>
"""
fn run_context(context_name, module_name) do
  let app_name = detect_app_name()
  let lctx = String.downcase(context_name)
  let ctx_dir = "lib/" ++ String.downcase(app_name)
  Dir.make_all(ctx_dir)
  let ctx_file = ctx_dir ++ "/" ++ lctx ++ ".march"
  File.write(ctx_file, context_source(app_name, context_name, module_name))
  IO.println("* creating " ++ ctx_file)
  Ok(())
end

end
