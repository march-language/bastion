-- Forge.New — forge bastion new <name>
--
-- Scaffolds a new Bastion web application.
-- Thin wrapper around Forge.Scaffold.scaffold/1.
-- Ported from cmd_bastion_new.ml.

mod Forge.New do

doc "Run `forge bastion new <name>` — scaffold a new Bastion app."
fn run(name) do
  match Forge.Scaffold.scaffold(name) do
  Ok(_) ->
    println("created Bastion app '" ++ name ++ "'")
    println("  next steps:")
    println("    cd " ++ name)
    println("    forge bastion server")
    Ok(())
  Err(msg) -> Err(msg)
  end
end

fn main() do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  match args do
  Nil          -> println("Usage: forge bastion.new <name>")
  Cons(n, _)   -> let _ = run(n)
                  ()
  end
end

end
