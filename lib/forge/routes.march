-- Forge.Routes — forge bastion routes
--
-- Reads the project's router.march file(s) and prints all registered routes
-- in a formatted table.
--
-- Route detection: scans for the comment convention:
--   -- ROUTE: GET /path
-- and also for bare match-arm patterns of the form:
--   (:get,  [...])  ->
--   (:post, [...])  ->
-- The two strategies are combined and de-duplicated.
--
-- Ported from cmd_bastion_routes.ml.

mod Forge.Routes do

  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process

-- A single recognised route (named ParsedRoute to avoid collision with Router.Route).
type ParsedRoute = { method_str: String, path: String, handler: String }

-- ── String helpers ───────────────────────────────────────────────────────────

pfn trim_left(s) do
  String.trim_start(s)
end

-- ── Comment-style route parser ───────────────────────────────────────────────
-- Parses "-- ROUTE: GET /path" comments followed by a handler expression.

pfn extract_handler_from_line(line) do
  -- handler is the text before "(" or "->"
  let trimmed = trim_left(line)
  if String.is_empty(trimmed) || String.starts_with(trimmed, "--") do
    None
  else
    let h = match String.index_of(trimmed, "(") do
      Some(k) -> String.slice_bytes(trimmed, 0, k) |> String.trim()
      None    ->
        match String.index_of(trimmed, "->") do
        Some(k) when k > 0 -> String.slice_bytes(trimmed, 0, k) |> String.trim()
        _                  -> String.trim(trimmed)
        end
    end
    if String.is_empty(h) do None else Some(h) end
  end
end

pfn find_handler(lines, from_idx) do
  let n = List.length(lines)
  find_handler_loop(lines, from_idx, n)
end

pfn find_handler_loop(lines, idx, n) do
  if idx >= n do ""
  else
    let line = trim_left(List.nth(lines, idx))
    if String.is_empty(line) || String.starts_with(line, "--") do
      find_handler_loop(lines, idx + 1, n)
    else
      match extract_handler_from_line(line) do
      Some(h) -> h
      None    -> find_handler_loop(lines, idx + 1, n)
      end
    end
  end
end

pfn parse_comment_routes(lines) do
  let indexed = List.zip(List.range(0, List.length(lines)), lines)
  List.filter_map(indexed, fn pair -> do
    let (i, line) = pair
    let trimmed = trim_left(line)
    if String.starts_with(trimmed, "-- ROUTE: ") do
      let rest = String.slice_bytes(trimmed, 10, String.byte_size(trimmed) - 10)
      match String.split_first(rest, " ") do
      Some((meth, path)) ->
        let handler = find_handler(lines, i + 1)
        Some({ method_str: String.to_uppercase(meth), path: path, handler: handler })
      None -> None
      end
    else
      None
    end
  end)
end

-- ── Arm-style route parser ───────────────────────────────────────────────────
-- Recognises match arms like (:get, Cons("a", Nil)) ->

pfn method_of_token(s) do
  match String.to_lowercase(String.trim(s)) do
  ":get"    -> Some("GET")
  "get"     -> Some("GET")
  ":post"   -> Some("POST")
  "post"    -> Some("POST")
  ":put"    -> Some("PUT")
  "put"     -> Some("PUT")
  ":patch"  -> Some("PATCH")
  "patch"   -> Some("PATCH")
  ":delete" -> Some("DELETE")
  "delete"  -> Some("DELETE")
  ":head"   -> Some("HEAD")
  "head"    -> Some("HEAD")
  _         -> None
  end
end

pfn segment_of_token(p) do
  let p2 = String.trim(p)
  let len = String.byte_size(p2)
  if len >= 2 && String.starts_with(p2, "\"") && String.ends_with(p2, "\"") do
    String.slice_bytes(p2, 1, len - 2)
  else
    ":" ++ p2
  end
end

-- Parse a Cons-chain string like Cons("a", Cons("b", Nil)) into segments.
pfn segments_of_cons(s) do
  List.reverse(segments_of_cons_loop(s, []))
end

pfn segments_of_cons_loop(s, acc) do
  let s2 = String.trim(s)
  if s2 == "Nil" || String.is_empty(s2) do
    acc
  else
    if String.starts_with(s2, "Cons(") do
      let inner = String.slice_bytes(s2, 5, String.byte_size(s2) - 5)
      match find_balanced_comma(inner, 0, 0) do
      None -> acc
      Some(comma_idx) ->
        let head = String.trim(String.slice_bytes(inner, 0, comma_idx))
        let tail_raw = String.trim(String.slice_bytes(inner, comma_idx + 1, String.byte_size(inner) - comma_idx - 1))
        -- strip trailing ")" from tail
        let tail = if String.ends_with(tail_raw, ")") do
          String.slice_bytes(tail_raw, 0, String.byte_size(tail_raw) - 1)
        else
          tail_raw
        end
        segments_of_cons_loop(tail, Cons(segment_of_token(head), acc))
      end
    else
      acc
    end
  end
end

-- Find the index of the first comma at depth 0 in string s starting from pos.
pfn find_balanced_comma(s, pos, depth) do
  let n = String.byte_size(s)
  if pos >= n do None
  else
    let c = String.slice_bytes(s, pos, 1)
    if c == "(" || c == "[" do
      find_balanced_comma(s, pos + 1, depth + 1)
    else
      if c == ")" || c == "]" do
        find_balanced_comma(s, pos + 1, depth - 1)
      else
        if c == "," && depth == 0 do
          Some(pos)
        else
          find_balanced_comma(s, pos + 1, depth)
        end
      end
    end
  end
end

pfn path_of_list_literal(s) do
  let s2 = String.trim(s)
  if s2 == "Nil" do
    "/"
  else
    if String.starts_with(s2, "Cons(") do
    "/" ++ String.join(segments_of_cons(s2), "/")
    else
    -- bracket form [...]
    let inner = if String.byte_size(s2) >= 2
                   && String.starts_with(s2, "[")
                   && String.ends_with(s2, "]") do
      String.trim(String.slice_bytes(s2, 1, String.byte_size(s2) - 2))
    else
      s2
    end
    if String.is_empty(inner) do "/"
    else
      let parts = String.split(inner, ",")
      let segs = List.map(parts, fn p -> do
        let p2 = String.trim(p)
        let len = String.byte_size(p2)
        if len >= 2
           && String.starts_with(p2, "\"")
           && String.ends_with(p2, "\"") do
          String.slice_bytes(p2, 1, len - 2)
        else
          ":" ++ p2
        end
      end)
      "/" ++ String.join(segs, "/")
    end
    end
  end
end

pfn is_arm_line(line) do
  let trimmed = trim_left(line)
  let rest1 = String.slice_bytes(trimmed, 1, String.byte_size(trimmed) - 1)
  String.starts_with(trimmed, "(:") ||
  (String.byte_size(trimmed) > 1
   && String.starts_with(trimmed, "(")
   && (
     String.starts_with(rest1, "Get,")  ||
     String.starts_with(rest1, "Post,") ||
     String.starts_with(rest1, "Put,")  ||
     String.starts_with(rest1, "Patch,") ||
     String.starts_with(rest1, "Delete,") ||
     String.starts_with(rest1, "Head,")
   ))
end

pfn parse_arm_line(line, lines, line_idx) do
  let trimmed = trim_left(line)
  -- extract up to "->"
  let s = match String.index_of(trimmed, "->") do
    Some(k) when k > 0 -> String.trim(String.slice_bytes(trimmed, 0, k - 1))
    _                  -> trimmed
  end
  -- parse (:method, path_list)
  match String.index_of(s, ",") do
  None -> None
  Some(comma) ->
    let atom_part = String.trim(String.slice_bytes(s, 1, comma - 1))
    let rest_raw  = String.trim(String.slice_bytes(s, comma + 1, String.byte_size(s) - comma - 1))
    -- strip trailing ")"
    let rest = if String.ends_with(rest_raw, ")") do
      String.slice_bytes(rest_raw, 0, String.byte_size(rest_raw) - 1)
    else
      rest_raw
    end
    match method_of_token(atom_part) do
    None -> None
    Some(meth) ->
      let path = path_of_list_literal(rest)
      -- skip internal bastion routes
      if String.starts_with(path, "/_bastion") do
        None
      else
        -- handler: look for text after "->" on same line, else next non-blank line
        let handler = match String.index_of(line, "->") do
          Some(k) ->
            let after = String.trim(String.slice_bytes(line, k + 2, String.byte_size(line) - k - 2))
            match String.index_of(after, "(") do
            Some(p) -> String.trim(String.slice_bytes(after, 0, p))
            None    -> String.trim(after)
            end
          None -> find_handler(lines, line_idx + 1)
        end
        Some({ method_str: meth, path: path, handler: handler })
      end
    end
  end
end

pfn parse_arm_routes(lines) do
  let indexed = List.zip(List.range(0, List.length(lines)), lines)
  List.filter_map(indexed, fn pair -> do
    let (i, line) = pair
    if is_arm_line(line) do
      parse_arm_line(line, lines, i)
    else
      None
    end
  end)
end

-- ── De-duplication ───────────────────────────────────────────────────────────

pfn route_key(r) do
  r.method_str ++ " " ++ r.path
end

pfn dedup(routes) do
  List.reverse(dedup_loop(routes, [], []))
end

pfn dedup_loop(routes, seen, acc) do
  match routes do
  Nil -> acc
  Cons(r, rest) ->
    let k = route_key(r)
    if List.any(seen, fn s -> s == k) do
      dedup_loop(rest, seen, acc)
    else
      dedup_loop(rest, Cons(k, seen), Cons(r, acc))
    end
  end
end

-- ── Printer ──────────────────────────────────────────────────────────────────

pfn pad(s, n) do
  let len = String.byte_size(s)
  if len >= n do s
  else s ++ String.repeat(" ", n - len) end
end

-- Locally-defined max folds.  The stdlib `List.fold_left` currently has a
-- type-inference quirk with user-supplied callbacks (see march stdlib issue),
-- so we use explicit recursion here.
pfn max_method_width(routes, acc) do
  match routes do
  Nil        -> acc
  Cons(r, t) ->
    let w = String.byte_size(r.method_str)
    if w > acc do max_method_width(t, w) else max_method_width(t, acc) end
  end
end

pfn max_path_width(routes, acc) do
  match routes do
  Nil        -> acc
  Cons(r, t) ->
    let w = String.byte_size(r.path)
    if w > acc do max_path_width(t, w) else max_path_width(t, acc) end
  end
end

pfn print_routes(routes) do
  if List.is_empty(routes) do
    println("No routes found.")
  else
    let col1 = max_method_width(routes, 6)
    let col2 = max_path_width(routes, 4)
    let sep_len = col1 + col2 + String.byte_size("  CONTROLLER") + 6
    let sep = String.repeat("-", sep_len)
    println(pad("METHOD", col1) ++ "  " ++ pad("PATH", col2) ++ "  CONTROLLER")
    println(sep)
    let _ = List.map(routes, fn r ->
      println(pad(r.method_str, col1) ++ "  " ++ pad(r.path, col2) ++ "  " ++ r.handler)
    )
  end
end

-- ── Router file discovery ────────────────────────────────────────────────────

pfn find_router_files(proj) do
  let root    = proj.root
  let lib_dir = root ++ "/lib"
  let primary = lib_dir ++ "/" ++ proj.name ++ "/router.march"
  if File.exists(primary) do
    [primary]
  else
    let sub = lib_dir ++ "/" ++ proj.name
    if Dir.exists(sub) do
      match Dir.list(sub) do
      Err(_) -> []
      Ok(entries) ->
        List.filter_map(entries, fn name -> do
          if String.ends_with(name, "router.march")
             || (String.starts_with(name, "router") && String.ends_with(name, ".march")) do
            Some(sub ++ "/" ++ name)
          else
            None
          end
        end)
      end
    else
      []
    end
  end
end

-- ── Route helper generator ───────────────────────────────────────────────────
--
-- Generates a `<AppPascalCase>.Routes` March module with typed path helpers.
-- Invoked via `forge bastion.routes --gen`.

-- Convert a snake_case string to PascalCase.
pfn snake_to_pascal(s) do
  let parts = String.split(s, "_")
  String.join(List.map(parts, fn p ->
    if String.is_empty(p) do p
    else
      String.to_uppercase(String.slice_bytes(p, 0, 1))
        ++ String.slice_bytes(p, 1, String.byte_size(p) - 1)
    end
  ), "")
end

-- Simple singularizer: remove trailing 's' unless word ends in 'ss'.
pfn singularize(s) do
  let n = String.byte_size(s)
  if n > 2 && String.ends_with(s, "s") && !String.ends_with(s, "ss") do
    String.slice_bytes(s, 0, n - 1)
  else s end
end

-- Derive a March function name from a path:
--   /              → "root_path"
--   /users         → "users_path"
--   /users/:id     → "user_path"     (singularize last literal before a param)
--   /posts/:p/comments/:c  → "post_comment_path"
pfn path_to_helper_name(path) do
  let all  = String.split(path, "/")
  let segs = List.filter(all, fn s -> !String.is_empty(s))
  let literals = List.filter_map(segs, fn s ->
    if String.starts_with(s, ":") do None else Some(s) end)
  let params = List.filter(segs, fn s -> String.starts_with(s, ":"))
  match literals do
  Nil -> "root_path"
  _   ->
    let has_params = !List.is_empty(params)
    let fn_segs = if has_params do
      -- singularize the last literal segment (nearest to params)
      match List.reverse(literals) do
      Nil            -> literals
      Cons(last, rest) -> List.reverse(Cons(singularize(last), rest))
      end
    else literals end
    String.join(fn_segs, "_") ++ "_path"
  end
end

-- Extract param names (without ':') from a path.
pfn path_param_names(path) do
  let all  = String.split(path, "/")
  List.filter_map(all, fn s ->
    if String.starts_with(s, ":") do
      Some(String.slice_bytes(s, 1, String.byte_size(s) - 1))
    else None end)
end

-- Build the March expression that constructs the path.
--   /users      → "\"/users\""
--   /users/:id  → "\"/users/\" ++ id"
--   /posts/:p/comments/:c → "\"/posts/\" ++ p ++ \"/comments/\" ++ c"
pfn path_to_expr(path) do
  let all  = String.split(path, "/")
  let segs = List.filter(all, fn s -> !String.is_empty(s))
  match segs do
  Nil -> "\"/\""
  _   ->
    let pieces = List.map(segs, fn s ->
      if String.starts_with(s, ":") do
        let param = String.slice_bytes(s, 1, String.byte_size(s) - 1)
        "\"/\" ++ " ++ param
      else
        "\"/" ++ s ++ "\""
      end)
    String.join(pieces, " ++ ")
  end
end

-- Build the full function signature and body for one route helper.
pfn helper_fn(path) do
  let name   = path_to_helper_name(path)
  let params = path_param_names(path)
  let body   = path_to_expr(path)
  let fn_sig = match params do
    Nil -> "  fn " ++ name ++ "() : String do"
    _   ->
      let args = String.join(List.map(params, fn p -> p ++ " : String"), ", ")
      "  fn " ++ name ++ "(" ++ args ++ ") : String do"
    end
  fn_sig ++ "\n    " ++ body ++ "\n  end\n"
end

-- Deduplicate routes by path (method is irrelevant for URL generators).
pfn dedup_by_path(routes) do
  List.reverse(dedup_path_loop(routes, [], []))
end

pfn dedup_path_loop(routes, seen, acc) do
  match routes do
  Nil -> acc
  Cons(r, rest) ->
    if List.any(seen, fn p -> p == r.path) do
      dedup_path_loop(rest, seen, acc)
    else
      dedup_path_loop(rest, Cons(r.path, seen), Cons(r, acc))
    end
  end
end

-- Sort routes: root first, then alphabetical by path.
pfn sort_routes_for_gen(routes) do
  let (roots, others) = List.partition(routes, fn r -> r.path == "/")
  List.append(roots, others)
end

-- Emit the full generated module source.
pfn gen_module(mod_name : String, routes : List(ParsedRoute)) : String do
  let deduped = dedup_by_path(routes)
  let sorted  = sort_routes_for_gen(deduped)
  let fns     = List.map(sorted, fn r -> helper_fn(r.path))
  let body    = String.join(fns, "")
  "-- AUTO-GENERATED — do not edit.\n" ++
  "-- Re-run `forge bastion.routes --gen` to regenerate.\n\n" ++
  "mod " ++ mod_name ++ ".Routes do\n\n" ++
  body ++
  "end\n"
end

pfn load_all_routes(proj) do
  let files = find_router_files(proj)
  List.flat_map(files, fn path -> do
    match File.read(path) do
    Err(_) -> []
    Ok(src) ->
      let lines = String.split(src, "\n")
      let comment_routes = parse_comment_routes(lines)
      let arm_routes     = parse_arm_routes(lines)
      let known = List.map(comment_routes, fn r -> route_key(r))
      let extra = List.filter(arm_routes, fn r ->
        !List.any(known, fn k -> k == route_key(r))
      )
      List.append(comment_routes, extra)
    end
  end)
end

-- ── Run ──────────────────────────────────────────────────────────────────────

doc "List all routes in the current Bastion project."
fn run() do
  match Forge.Project.load() do
  Err(msg) -> Err(msg)
  Ok(proj) ->
    let files = find_router_files(proj)
    if List.is_empty(files) do
      println("No router file found (expected lib/" ++ proj.name ++ "/router.march).")
      Ok(())
    else
      let all_routes = load_all_routes(proj)
      print_routes(dedup(all_routes))
      Ok(())
    end
  end
end

doc """
Generate a Routes module with typed path helpers.

Writes `lib/<app>_routes.march` with one helper function per unique path.

    forge bastion.routes --gen
"""
fn run_gen() do
  match Forge.Project.load() do
  Err(msg) -> Err(msg)
  Ok(proj) ->
    let files = find_router_files(proj)
    if List.is_empty(files) do
      println("No router file found — cannot generate Routes module.")
      Err("no router found")
    else
      let all_routes = load_all_routes(proj)
      let routes     = dedup(all_routes)
      if List.is_empty(routes) do
        println("No routes found in " ++ String.join(files, ", "))
        Ok(())
      else
        let mod_name  = snake_to_pascal(proj.name)
        let src       = gen_module(mod_name, routes)
        let out_path  = proj.root ++ "/lib/" ++ proj.name ++ "_routes.march"
        match File.write(out_path, src) do
        Err(msg) ->
          println("Error writing " ++ out_path ++ ": " ++ to_string(msg))
          Err(to_string(msg))
        Ok(_) -> do
          println("Generated " ++ out_path ++ " (" ++ String.from_int(List.length(routes)) ++ " routes)")
          println("")
          println("Add to your app's module imports:")
          println("  import " ++ mod_name ++ ".Routes")
          println("")
          println("Then use helpers like:")
          match routes do
          Nil -> ()
          Cons(r, _) ->
            let name   = path_to_helper_name(r.path)
            let params = path_param_names(r.path)
            let call   = match params do
              Nil -> name ++ "()"
              _   -> name ++ "(" ++ String.join(params, ", ") ++ ")"
              end
            println("  " ++ mod_name ++ ".Routes." ++ call)
          end
          Ok(())
        end
        end
      end
    end
  end
end

fn main(_cap_console : Cap(IO.Console), _cap_fileread : Cap(IO.FileRead), _cap_filewrite : Cap(IO.FileWrite), _cap_process : Cap(IO.Process)) do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  let gen  = List.any(args, fn a -> a == "--gen")
  if gen do
    let _ = run_gen()
    ()
  else
    let _ = run()
    ()
  end
end

end
