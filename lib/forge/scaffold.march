  "mod Config.Dev do\n"
  ++ "  let port         : Int    = 4000\n"
  ++ "  let debug        : Bool   = true\n"
  ++ "  let log_level    : String = \"debug\"\n"
  ++ "  let log_format   : String = \"text\"\n"
  ++ "  let database_url : String = \"\"\n"
  ++ "  let db_host      : String = \"localhost\"\n"
  ++ "  let db_port      : Int    = 5432\n"
  ++ "  let db_name      : String = \"" ++ name ++ "_dev\"\n"
  ++ "  let db_user      : String = \"postgres\"\n"
  ++ "  let db_password  : String = \"\"\n"
  ++ "  let db_pool_min  : Int    = 2\n"
  ++ "  let db_pool_max  : Int    = 10\n"
  ++ "end\n"
end

