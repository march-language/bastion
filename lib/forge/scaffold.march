end

pfn config_prod() do
  "mod Config.Prod do\n"
  ++ "  let port         : Int    = match Process.env(\"PORT\") do Some(p) -> string_to_int(p) | None -> 4000 end\n"
  ++ "  let debug        : Bool   = false\n"
  ++ "  let log_level    : String = Env.get(\"LOG_LEVEL\", \"info\")\n"
  ++ "  let log_format   : String = \"json\"\n"
  ++ "  let database_url : String = Env.get(\"DATABASE_URL\", \"\")\n"
  ++ "  let db_host      : String = Env.get(\"DB_HOST\", \"localhost\")\n"
  ++ "  let db_port      : Int    = match Process.env(\"DB_PORT\") do Some(p) -> string_to_int(p) | None -> 5432 end\n"
  ++ "  let db_name      : String = Env.get(\"DB_NAME\", \"\")\n"
  ++ "  let db_user      : String = Env.get(\"DB_USER\", \"postgres\")\n"
  ++ "  let db_password  : String = Env.get(\"DB_PASSWORD\", \"\")\n"
  ++ "  let db_pool_min  : Int    = match Process.env(\"DB_POOL_MIN\") do Some(p) -> string_to_int(p) | None -> 5 end\n"
  ++ "  let db_pool_max  : Int    = match Process.env(\"DB_POOL_MAX\") do Some(p) -> string_to_int(p) | None -> 20 end\n"
  ++ "end\n"
end

pfn application_source(pascal) do
  "mod " ++ pascal ++ ".Application do\n"
  ++ "\n"
  ++ "  -- Application supervision tree.\n"
  ++ "  -- Configures logging, starts the Depot connection pool, and registers\n"
  ++ "  -- it in the Registry so " ++ pascal ++ ".Repo can find it.\n"
  ++ "  --\n"
  ++ "  -- Logging uses the March stdlib Logger directly (pluggable appenders,\n"
  ++ "  -- structured fields, tracing).  Bastion.Logger wraps it with the\n"
  ++ "  -- two-arg info/warn/error(msg, meta) convention used in handlers.\n"
  ++ "  --\n"
  ++ "  -- Entry point: call " ++ pascal ++ ".Application.start() from main().\n"
  ++ "\n"
  ++ "  actor Supervisor do\n"
  ++ "    state { db : Int }\n"
  ++ "    init  { db = 0 }\n"
  ++ "\n"
  ++ "    -- Sent by start() after spawn.  Configures the stdlib Logger and\n"
  ++ "    -- starts the Depot pool, then registers it in the Registry.\n"
  ++ "    on Boot() do\n"
  ++ "      -- Configure stdlib Logger: level + appender from Config\n"
  ++ "      Bastion.Logger.configure(Config.log_level(), Config.log_format())\n"
  ++ "      -- Start the Depot connection pool\n"
  ++ "      let conn_cfg = {\n"
  ++ "        host     = Config.db_host(),\n"
  ++ "        port     = Config.db_port(),\n"
  ++ "        user     = Config.db_user(),\n"
  ++ "        database = Config.db_name(),\n"
  ++ "        password = Config.db_password()\n"
  ++ "      }\n"
  ++ "      let pool_cfg = {\n"
  ++ "        min_size = Config.db_pool_min(),\n"
  ++ "        max_size = Config.db_pool_max(),\n"
  ++ "        conn_cfg = conn_cfg\n"
  ++ "      }\n"
  ++ "      let db_ref = Depot.Pool.start(pool_cfg)\n"
  ++ "      Registry.register(\"bastion:db_pool\", db_ref)\n"
  ++ "      Bastion.Logger.info(\"" ++ pascal ++ " started\", [])\n"
  ++ "      { db = db_ref }\n"
  ++ "    end\n"
  ++ "  end\n"
  ++ "\n"
  ++ "  doc \"Start the application supervision tree. Returns the supervisor actor ref.\"\n"
  ++ "  fn start() do\n"
  ++ "    let sup = spawn(Supervisor)\n"
  ++ "    Actor.cast(sup, Boot())\n"
  ++ "    sup\n"
  ++ "  end\n"
  ++ "\n"
  ++ "end\n"
end

pfn repo_source(pascal, name) do
  "mod " ++ pascal ++ ".Repo do\n"
  ++ "\n"
  ++ "  -- Thin wrapper over the application's Depot connection pool.\n"
  ++ "  -- Use this module for all database access in " ++ pascal ++ ".\n"
  ++ "  --\n"
  ++ "  --   import " ++ pascal ++ ".Repo\n"
  ++ "  --\n"
  ++ "  --   Repo.with_conn(fn conn -> do\n"
  ++ "  --     Depot.Query.from(User.schema())\n"
  ++ "  --     |> Depot.Query.where_eq(\"email\", email)\n"
  ++ "  --     |> Depot.Query.exec_sql(conn)\n"
  ++ "  --   end)\n"
  ++ "\n"
  ++ "  let _pool_key = \"bastion:db_pool\"\n"
  ++ "\n"
  ++ "  pfn pool() do\n"
  ++ "    match Registry.whereis(_pool_key) do\n"
  ++ "    Some(pid) -> pid\n"
  ++ "    None      -> panic(\"" ++ pascal ++ ".Repo: db pool not started — call " ++ pascal ++ ".Application.start() first\")\n"
  ++ "    end\n"
  ++ "  end\n"
  ++ "\n"
  ++ "  doc \"Borrow a connection, run f(conn), and return the connection automatically.\"\n"
  ++ "  fn with_conn(f) do\n"
  ++ "    Depot.Pool.with_conn(pool(), f)\n"
  ++ "  end\n"
  ++ "\n"
  ++ "  doc \"Borrow a pinned connection and run f(conn) inside a transaction.\"\n"
  ++ "  fn transaction(f) do\n"
  ++ "    Depot.Transaction.run_pool(pool(), f)\n"
  ++ "  end\n"
  ++ "\n"
  ++ "end\n"
end

pfn env_example(name) do
  "# " ++ name ++ " environment variables\n"
  ++ "# Copy to .env and fill in your values.  Never commit .env.\n"
  ++ "\n"
  ++ "MARCH_ENV=dev\n"
  ++ "PORT=4000\n"
  ++ "\n"
  ++ "# Logging\n"
  ++ "LOG_LEVEL=debug\n"
  ++ "\n"
  ++ "# Database — use DATABASE_URL for a connection string,\n"
  ++ "# or set individual DB_* vars (individual vars take effect when DATABASE_URL is empty).\n"
  ++ "DATABASE_URL=\n"
  ++ "DB_HOST=localhost\n"
  ++ "DB_PORT=5432\n"
  ++ "DB_NAME=" ++ name ++ "_dev\n"
  ++ "DB_USER=postgres\n"
  ++ "DB_PASSWORD=\n"
  ++ "DB_POOL_MIN=2\n"
  ++ "DB_POOL_MAX=10\n"
end

pfn app_css() do
  "*, *::before, *::after { box-sizing: border-box; }\n\n" ++
  "body {\n" ++
  "  font-family: system-ui, sans-serif;\n" ++
  "  max-width: 800px;\n" ++
  "  margin: 0 auto;\n" ++
  "  padding: 1rem;\n" ++
  "  color: #1a1a1a;\n" ++
  "}\n\n" ++
  "nav { margin-bottom: 2rem; }\n" ++
  "nav a { margin-right: 1rem; color: #0070f3; text-decoration: none; }\n" ++
  "nav a:hover { text-decoration: underline; }\n\n" ++
  ".counter {\n" ++
  "  display: inline-flex;\n" ++
  "  align-items: center;\n" ++
  "  gap: 0.75rem;\n" ++
  "  font-size: 1.5rem;\n" ++
  "}\n\n" ++
  ".counter button {\n" ++
  "  font-size: 1.5rem;\n" ++
  "  width: 2.5rem;\n" ++
  "  height: 2.5rem;\n" ++
  "  border: 1px solid #ccc;\n" ++
  "  border-radius: 6px;\n" ++
  "  cursor: pointer;\n" ++
  "  background: white;\n" ++
  "}\n\n" ++
  ".counter button:hover { background: #f0f0f0; }\n"
end

pfn test_source(_name, pascal) do
  "mod " ++ pascal ++ "Test do\n\n" ++
  "  import Counter\n\n" ++
  "  describe \"Counter island\" do\n\n" ++
  "    test \"render_json shows initial count\" do\n" ++
  "      let html = Counter.render_json(\"{\\\"count\\\":0}\")\n" ++
  "      assert (String.contains(html, \"0\"))\n" ++
  "    end\n\n" ++
  "    test \"update_json increment increases count\" do\n" ++
  "      let next = Counter.update_json(\"{\\\"count\\\":5}\", \"{\\\"tag\\\":\\\"Increment\\\"}\")\n" ++
  "      assert (String.contains(next, \"6\"))\n" ++
  "    end\n\n" ++
  "    test \"update_json decrement decreases count\" do\n" ++
  "      let next = Counter.update_json(\"{\\\"count\\\":5}\", \"{\\\"tag\\\":\\\"Decrement\\\"}\")\n" ++
  "      assert (String.contains(next, \"4\"))\n" ++
  "    end\n\n" ++
  "    test \"render_json produces correct HTML\" do\n" ++
  "      let html = Counter.render_json(\"{\\\"count\\\":42}\")\n" ++
  "      assert (String.contains(html, \"42\"))\n" ++
  "      assert (String.contains(html, \"data-msg\"))\n" ++
  "      assert (String.contains(html, \"Increment\"))\n" ++
  "      assert (String.contains(html, \"Decrement\"))\n" ++
  "    end\n\n" ++
  "    test \"update_json then render_json round-trip\" do\n" ++
  "      let next = Counter.update_json(\"{\\\"count\\\":0}\", \"{\\\"tag\\\":\\\"Increment\\\"}\")\n" ++
  "      let html = Counter.render_json(next)\n" ++
  "      assert (String.contains(html, \"1\"))\n" ++
  "    end\n\n" ++
  "  end\n\n" ++
  "end\n"
end

pfn editorconfig() do
  "root = true\n\n[*]\nindent_style = space\nindent_size = 2\ncharset = utf-8\nend_of_line = lf\ntrim_trailing_whitespace = true\ninsert_final_newline = true\n\n[*.march]\nindent_style = space\nindent_size = 2\n"
end

pfn gitignore() do
  "/.march/\n/islands/*.wasm\n/islands/*.glue.js\n/.env\n"
end

pfn readme(name, pascal) do
  "# " ++ pascal ++ "\n\n" ++
  "A [Bastion](https://github.com/march-lang/bastion) web application.\n\n" ++
  "## Getting started\n\n" ++
  "```bash\n" ++
  "forge deps\n" ++
  "forge run\n" ++
  "```\n\n" ++
  "Visit http://localhost:4000\n\n" ++
  "## Structure\n\n" ++
  "```\n" ++
  "lib/\n" ++
  "  " ++ name ++ ".march          # Router and server entry point\n" ++
  "  page_controller.march  # Page handlers\n" ++
  "  counter.march          # Example island component\n" ++
  "public/                  # Static assets (CSS, JS, images)\n" ++
  "islands/                 # Compiled .wasm island modules\n" ++
  "test/                    # Tests\n" ++
  "```\n\n" ++
  "## Islands\n\n" ++
  "Compile an island to WASM:\n\n" ++
  "```bash\n" ++
  "march --compile --target wasm32-unknown-unknown lib/counter.march -o islands/Counter.wasm\n" ++
  "```\n"
end

-- ── Scaffold ─────────────────────────────────────────────────────────────────

doc """
Scaffold a new Bastion application named `name` in a new directory.
Returns Ok(()) on success or Err(msg) on failure.
"""
fn scaffold(name) do
  if Dir.exists(name) do
    Err("directory '" ++ name ++ "' already exists")
  else
    let pascal = snake_to_pascal(name)
    let _ = Dir.mkdir_p(name ++ "/lib/" ++ name)
    let _ = Dir.mkdir_p(name ++ "/config")
    let _ = Dir.mkdir_p(name ++ "/public/css")
    let _ = Dir.mkdir_p(name ++ "/public/js")
    let _ = Dir.mkdir_p(name ++ "/islands")
    let _ = Dir.mkdir_p(name ++ "/test")
    let _ = Dir.mkdir_p(name ++ "/priv/depot/migrations")
    let write = fn path -> fn content -> do
      let _ = File.write(name ++ "/" ++ path, content)
      println("* creating " ++ name ++ "/" ++ path)
    end
    write("forge.toml")(forge_toml(name))
    write(".editorconfig")(editorconfig())
    write(".gitignore")(gitignore())
    write(".env.example")(env_example(name))
    write("README.md")(readme(name, pascal))
    write("lib/" ++ name ++ ".march")(main_source(pascal))
    write("lib/" ++ name ++ "/application.march")(application_source(pascal))
    write("lib/" ++ name ++ "/repo.march")(repo_source(pascal, name))
    write("lib/page_controller.march")(page_controller_source(pascal))
    write("lib/counter.march")(counter_island_source())
    write("config/config.march")(config_main())
    write("config/dev.march")(config_dev(name))
    write("config/test.march")(config_test(name))
    write("config/prod.march")(config_prod())
    write("public/css/app.css")(app_css())
    write("public/js/.gitkeep")("")
    write("islands/.gitkeep")("")
    write("priv/depot/migrations/.gitkeep")("")
    write("test/" ++ name ++ "_test.march")(test_source(name, pascal))
    let _ = Process.run("sh", ["-c", "git init " ++ name ++ " > /dev/null 2>&1"])
    Ok(())
  end
end

end
