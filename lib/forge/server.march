-- Forge.Server — forge bastion server
--
-- Starts the Bastion dev server with file-watching and auto-restart.
--
-- Behaviour:
-- - Builds a shell watch-loop script that restarts `march <entry>` on crash.
-- - Optionally starts esbuild --watch for the assets pipeline (in background).
-- - Watches lib/ and config/ for .march file changes via a polling shell loop.
-- - On SIGINT: shell trap handler kills child processes and exits.
--
-- Ported from cmd_bastion_server.ml.
-- Note: the March stdlib does not expose async process management primitives;
-- file-watching and process supervision are delegated to a shell script.

mod Forge.Server do

needs IO.File, IO.FS, IO.Process

-- ── Helpers ──────────────────────────────────────────────────────────────────

-- Locate the `march` binary in PATH.
pfn find_march_exe() do
  let path_dirs = match Process.env("PATH") do
    None    -> ["/usr/local/bin", "/usr/bin", "/bin"]
    Some(p) -> String.split(p, ":")
  end
  match List.filter_map(path_dirs, fn d -> do
    let candidate = d ++ "/march"
    if File.exists(candidate) do Some(candidate) else None end
  end) do
  Cons(exe, _) -> exe
  Nil          -> "march"   -- will fail at exec, but let the OS report it
  end
end

pfn find_esbuild() do
  let path_dirs = match Process.env("PATH") do
    None    -> ["/usr/local/bin", "/usr/bin", "/bin"]
    Some(p) -> String.split(p, ":")
  end
  List.filter_map(path_dirs, fn d -> do
    let candidate = d ++ "/esbuild"
    if File.exists(candidate) do Some(candidate) else None end
  end)
end

-- ── Banner ───────────────────────────────────────────────────────────────────

pfn print_banner(app_name, port, has_assets) do
  println("")
  println("==> Bastion dev server starting")
  println("    App:       " ++ app_name)
  println("    URL:       http://localhost:" ++ String.from_int(port))
  println("    Dashboard: http://localhost:" ++ String.from_int(port) ++ "/_bastion")
  println("    Env:       dev")
  println("    Watching:  lib/  config/")
  if has_assets do
    println("    Assets:    assets/ -> priv/static/assets/ (esbuild)")
  else
    ()
  end
  println("    Press Ctrl+C to stop.")
  println("")
end

-- ── Build lib path ────────────────────────────────────────────────────────────

pfn build_lib_path(proj) do
  let root       = proj.root
  let lib_dir    = root ++ "/lib"
  let config_dir = root ++ "/config"
  let dep_paths = List.filter_map(proj.deps, fn pair -> do
    let (_, dep) = pair
    match dep do
    PathDep(rel) ->
      let abs = if Path.is_absolute(rel) do rel else root ++ "/" ++ rel end
      let d = abs ++ "/lib"
      if Dir.exists(d) do Some(d) else None end
    _ -> None
    end
  end)
  let all_paths = List.concat([
    dep_paths,
    [lib_dir],
    if Dir.exists(config_dir) do [config_dir] else [] end
  ])
  String.join(all_paths, ":")
end

-- ── Watch script ──────────────────────────────────────────────────────────────
--
-- Builds a shell script that:
--   1. Starts esbuild --watch in the background (if assets/ exists)
--   2. Runs a file-watching loop that restarts `march` on .march changes
--   3. Cleans up child processes on SIGINT/SIGTERM

pfn build_watch_script(march_exe, entry, lib_path_str, port_str, esbuild_cmd_opt, lib_dir, config_dir) do
  let env_prefix = "MARCH_ENV=dev MARCH_LIB_PATH=\"" ++ lib_path_str ++ "\" BASTION_PORT=" ++ port_str
  let server_cmd = env_prefix ++ " " ++ march_exe ++ " \"" ++ entry ++ "\""

  let esbuild_start = match esbuild_cmd_opt do
    None -> ""
    Some(cmd) -> cmd ++ " &\nESBUILD_PID=$!\n"
  end

  let esbuild_kill = match esbuild_cmd_opt do
    None -> ""
    Some(_) -> "[ -n \"$ESBUILD_PID\" ] && kill \"$ESBUILD_PID\" 2>/dev/null\n"
  end

  "#!/bin/sh\nset -e\n\n" ++
  esbuild_start ++
  "\nSERVER_PID=''\n\n" ++
  "cleanup() {\n" ++
  "  [ -n \"$SERVER_PID\" ] && kill \"$SERVER_PID\" 2>/dev/null\n" ++
  esbuild_kill ++
  "  echo ''\n  echo '--> Stopped.'\n  exit 0\n}\n\n" ++
  "trap cleanup INT TERM\n\n" ++
  "# Collect initial mtimes\nget_mtimes() {\n" ++
  "  find \"" ++ lib_dir ++ "\" \"" ++ config_dir ++ "\" -name '*.march' -newer /tmp/.forge_mtimes 2>/dev/null | head -1\n" ++
  "}\n\ntouch /tmp/.forge_mtimes\n\n" ++
  "start_server() {\n  " ++ server_cmd ++ " &\n  SERVER_PID=$!\n}\n\n" ++
  "start_server\n\n" ++
  "while true; do\n" ++
  "  sleep 1\n" ++
  "  # Check if server is still running\n" ++
  "  if ! kill -0 \"$SERVER_PID\" 2>/dev/null; then\n" ++
  "    echo '--> Server exited unexpectedly. Restarting in 1s...'\n" ++
  "    sleep 1\n" ++
  "    start_server\n" ++
  "  fi\n" ++
  "  # Check for file changes\n" ++
  "  CHANGED=$(get_mtimes)\n" ++
  "  if [ -n \"$CHANGED\" ]; then\n" ++
  "    echo \"--> change detected, restarting...\"\n" ++
  "    kill \"$SERVER_PID\" 2>/dev/null\n" ++
  "    wait \"$SERVER_PID\" 2>/dev/null\n" ++
  "    touch /tmp/.forge_mtimes\n" ++
  "    start_server\n" ++
  "  fi\n" ++
  "done\n"
end

-- ── Run ──────────────────────────────────────────────────────────────────────

doc """
Start the Bastion dev server.

`port_override` is Some(port) to use a specific port, or None for the default (4000).
"""
fn run(port_override) do
  match Forge.Project.load() do
  Err(msg) -> Err(msg)
  Ok(proj) ->
    let root       = proj.root
    let lib_dir    = root ++ "/lib"
    let config_dir = root ++ "/config"
    let entry      = lib_dir ++ "/" ++ proj.name ++ ".march"
    if !File.exists(entry) do
      Err("entry point not found: " ++ entry)
    else
      let port        = match port_override do Some(p) -> p | None -> 4000 end
      let port_str    = String.from_int(port)
      let lib_path    = build_lib_path(proj)
      let march_exe   = find_march_exe()
      let has_assets  = Dir.exists(root ++ "/assets")

      -- Build optional esbuild watch command
      let js_entry    = root ++ "/assets/js/app.js"
      let css_entry   = root ++ "/assets/css/app.css"
      let esbuild_cmd_opt = if !has_assets do
        None
      else
        match find_esbuild() do
        Nil ->
          println("    Assets:    esbuild not found — run `forge assets build` manually")
          None
        Cons(esbuild, _) ->
          let out_dir = root ++ "/priv/static/assets"
          let _ = Dir.mkdir_p(out_dir)
          let entries = List.filter_map([js_entry, css_entry], fn p -> do
            if File.exists(p) do Some(p) else None end
          end)
          let args_str = String.join(entries, " ")
          Some(esbuild ++ " " ++ args_str ++ " --bundle --outdir=\"" ++ out_dir ++ "\" --sourcemap --watch")
        end
      end

      print_banner(proj.name, port, has_assets)

      let script = build_watch_script(march_exe, entry, lib_path, port_str, esbuild_cmd_opt, lib_dir, config_dir)
      match Process.run("sh", ["-c", script]) do
      Ok(_) -> Ok(())
      Err(e) -> Err("server failed: " ++ e)
      end
    end
  end
end

fn main() do
  let raw  = Env.get("FORGE_TASK_ARGS", "")
  let args = if String.is_empty(raw) do Nil else String.split(raw, "\n") end
  let port_override = match args do
    Cons(p, _) ->
      match string_to_int(p) do
      Some(n) -> Some(n)
      None    -> None
      end
    Nil -> None
    end
  let _ = run(port_override)
  ()
end

end
