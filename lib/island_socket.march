-- IslandSocket — WebSocket transport for server-side island state management.
--
-- Each island instance is registered with an update, render, and optional
-- handle_child_event function. The socket routes messages between the browser
-- and the registered handlers.
--
-- Client messages (JSON):
--
--   {"island":"Counter-1","type":"init","module":"Counter","payload":{...}}
--     Register a new island instance with initial state.
--
--   {"island":"Counter-1","type":"msg","payload":"Increment"}
--     Forward a message to an existing island instance.
--
--   {"island":"Counter-1","type":"child_event","event":"item_toggled","payload":{...}}
--     A child island dispatched an event upward. Route to the parent island's
--     handle_child_event function. The "island" field here is the PARENT's ID.
--
--   {"island":"Counter-1","type":"optimistic","payload":{...}}
--     Client sends locally-computed state for CRDT reconciliation.
--
--   {"island":"Counter-1","type":"destroy"}
--     Remove an island instance.
--
-- Server responses (JSON):
--
--   {"island":"Counter-1","type":"render","payload":"<html>..."}
--     Server-rendered HTML after a state change.
--
--   {"island":"Counter-1","type":"state","payload":{...}}
--     State update (sent alongside render for client-side state tracking).
--
--   {"island":"Counter-1","type":"merge","payload":{...}}
--     Merged state (CRDT reconciliation response).
--
--   {"island":"child-id","type":"props","payload":{...}}
--     Parent pushes new props to a child island after its own state changed.
--
-- Usage:
--
--   let registry = IslandSocket.new_registry()
--                  |> IslandSocket.register("Counter", counter_update, counter_render)
--
--   HttpServer.new(4000)
--   |> HttpServer.plug(IslandSocket.plug(IslandSocket.default_config(), registry))
--   |> HttpServer.listen()
--
-- See also: island_view.march, island_assets.march, islands.march.

mod IslandSocket do

  import HttpServer
  import WebSocket
  import Json
  import Islands

  -- ── Configuration ──────────────────────────────────────────────────────

  -- Configuration for the island socket endpoint.
  --   path            — URL path to match for WebSocket upgrade
  --   allowed_origins — cross-origin WebSocket clients whose Origin header
  --                     is on this list are allowed to connect.  Same-origin
  --                     requests (Origin matches Host scheme://authority) are
  --                     always allowed.  A WebSocket handshake with no Origin
  --                     header, or one whose Origin is not on the list and
  --                     does not match the Host, is rejected with 403.
  type Config = Config(String, List(String))

  doc "Create a default config listening on /_bastion/ws with same-origin only."
  fn default_config() : Config do
    Config("/_bastion/ws", Nil)
  end

  doc "Create a config with a custom WebSocket path (same-origin only)."
  fn make_config(path : String) : Config do
    Config(path, Nil)
  end

  doc """
  Create a config that allows WebSocket upgrades from an explicit list of
  cross-origin clients (in addition to same-origin).

  Example:
    IslandSocket.make_config_with_origins("/_bastion/ws", ["https://admin.example.com"])
  """
  fn make_config_with_origins(path : String, origins : List(String)) : Config do
    Config(path, origins)
  end

  doc "Return the path from a config."
  fn config_path(cfg : Config) : String do
    match cfg do
    Config(p, _) -> p
    end
  end

  doc "Return the allowed cross-origin list from a config."
  fn config_allowed_origins(cfg : Config) : List(String) do
    match cfg do
    Config(_, os) -> os
    end
  end

  -- ── Island Registry ───────────────────────────────────────────────────
  --
  -- The registry maps module names to handler functions:
  --
  --   dataflow      : Islands.DataflowMode (Client | Server)
  --   update_fn     : (state_json, msg_json) -> state_json
  --   render_fn     : state_json -> html_string
  --   merge_fn_opt  : Option((local_json, remote_json) -> state_json)
  --   child_fn_opt  : Option((state_json, event_name, payload_json) -> state_json)
  --
  -- child_fn implements handle_child_event: called when a child island
  -- dispatches an event upward to this parent module. Returns the new
  -- parent state JSON.

  type IslandHandler = IslandHandler(
    String,                                    -- module name
    String,                                    -- dataflow mode string ("client" | "server")
    (String, String) -> String,                -- update_fn(state, msg) -> state
    String -> String,                          -- render_fn(state) -> html
    Option((String, String) -> String),        -- merge_fn_opt
    Option((String, String, String) -> String) -- child_fn_opt(state, event, payload) -> state
  )

  type Registry = Registry(List(IslandHandler))

  doc "Create an empty island registry."
  fn new_registry() : Registry do
    Registry(Nil)
  end

  doc """
  Register an island module with its update and render functions.

  Defaults to Client dataflow mode.

  update_fn takes (state_json, msg_json) and returns new state_json.
  render_fn takes state_json and returns an HTML string.

  Example:
    IslandSocket.register(registry, "Counter", counter_update, counter_render)
  """
  fn register(reg : Registry, name : String, update_fn : (String, String) -> String, render_fn : String -> String) : Registry do
    match reg do
    Registry(handlers) ->
      Registry(Cons(IslandHandler(name, "client", update_fn, render_fn, None, None), handlers))
    end
  end

  doc """
  Register an island module with an explicit DataflowMode.

  Use Islands.Server for display-only islands that receive state exclusively
  via the channel. Use "client" (the default) for interactive islands.
  """
  fn register_with_dataflow(reg : Registry, name : String, update_fn : (String, String) -> String, render_fn : String -> String, mode) : Registry do
    match reg do
    Registry(handlers) ->
      Registry(Cons(IslandHandler(name, mode, update_fn, render_fn, None, None), handlers))
    end
  end

  doc """
  Register an island module with a custom merge function for CRDT reconciliation.

  merge_fn takes (local_state_json, remote_state_json) and returns merged state_json.
  """
  fn register_with_merge(reg : Registry, name : String, update_fn : (String, String) -> String, render_fn : String -> String, merge_fn : (String, String) -> String) : Registry do
    match reg do
    Registry(handlers) ->
      Registry(Cons(IslandHandler(name, "client", update_fn, render_fn, Some(merge_fn), None), handlers))
    end
  end

  doc """
  Register an island module with a handle_child_event function.

  child_fn receives (state_json, event_name, payload_json) and returns the new
  parent state_json. This is called when a child island dispatches an event
  upward via the runtime's parent-child tree-walk.
  """
  fn register_with_child_handler(reg : Registry, name : String, update_fn : (String, String) -> String, render_fn : String -> String, child_fn : (String, String, String) -> String) : Registry do
    match reg do
    Registry(handlers) ->
      Registry(Cons(IslandHandler(name, "client", update_fn, render_fn, None, Some(child_fn)), handlers))
    end
  end

  doc """
  Register an island module with a handle_child_event function (alias for register_with_child_handler).

  Used when the parent island needs to receive events dispatched upward by
  child islands. child_fn receives (state_json, event_name, payload_json).
  """
  fn register_with_event_handler(reg : Registry, name : String, update_fn : (String, String) -> String, render_fn : String -> String, child_fn : (String, String, String) -> String) : Registry do
    match reg do
    Registry(handlers) ->
      Registry(Cons(IslandHandler(name, "client", update_fn, render_fn, None, Some(child_fn)), handlers))
    end
  end

  doc """
  Register an island module with both a merge function and a handle_child_event function.
  """
  fn register_full(reg : Registry, name : String, update_fn : (String, String) -> String, render_fn : String -> String, merge_fn : (String, String) -> String, child_fn : (String, String, String) -> String) : Registry do
    match reg do
    Registry(handlers) ->
      Registry(Cons(IslandHandler(name, "client", update_fn, render_fn, Some(merge_fn), Some(child_fn)), handlers))
    end
  end

  doc "Look up a handler by module name. Returns Some(handler) or None."
  fn find_handler(reg : Registry, name : String) : Option(IslandHandler) do
    match reg do
    Registry(handlers) -> find_in_list(handlers, name)
    end
  end

  doc "Return the DataflowMode from an island handler."
  fn handler_dataflow(h : IslandHandler) do
    match h do
    IslandHandler(_, mode, _, _, _, _) -> mode
    end
  end

  doc "Return true if the registry has a child event handler registered for the given island."
  fn has_event_handler(reg : Registry, name : String) : Bool do
    match find_handler(reg, name) do
    Some(h) ->
      match h do
      IslandHandler(_, _, _, _, _, child_fn_opt) ->
        match child_fn_opt do
        Some(_) -> true
        None    -> false
        end
      end
    None -> false
    end
  end

  pfn find_in_list(handlers : List(IslandHandler), name : String) : Option(IslandHandler) do
    match handlers do
    Nil -> None
    Cons(h, rest) ->
      match h do
      IslandHandler(n, _, _, _, _, _) ->
        if n == name do Some(h) else find_in_list(rest, name) end
      end
    end
  end

  -- ── Island State Store ─────────────────────────────────────────────────
  --
  -- Per-connection state: maps island instance IDs to their current state
  -- (as JSON strings) and module name.

  type IslandEntry = IslandEntry(String, String)
  -- IslandEntry(module_name, state_json)

  type IslandState = IslandState(List((String, IslandEntry)))
  -- List of (instance_id, entry) pairs

  pfn empty_state() : IslandState do
    IslandState(Nil)
  end

  doc "Create an empty island state store. Used to initialise a fresh connection."
  fn empty_store() : IslandState do
    IslandState(Nil)
  end

  doc "Return true if the store has an island registered with the given instance ID."
  fn has_island(store : IslandState, id : String) : Bool do
    match get_island(store, id) do
    Some(_) -> true
    None    -> false
    end
  end

  pfn put_island(store : IslandState, id : String, entry : IslandEntry) : IslandState do
    match store do
    IslandState(entries) ->
      IslandState(put_entry(entries, id, entry))
    end
  end

  pfn put_entry(entries : List((String, IslandEntry)), id : String, entry : IslandEntry) : List((String, IslandEntry)) do
    match entries do
    Nil -> Cons((id, entry), Nil)
    Cons((k, v), rest) ->
      if k == id do Cons((id, entry), rest) else Cons((k, v), put_entry(rest, id, entry)) end
    end
  end

  pfn get_island(store : IslandState, id : String) : Option(IslandEntry) do
    match store do
    IslandState(entries) -> get_entry(entries, id)
    end
  end

  pfn get_entry(entries : List((String, IslandEntry)), id : String) : Option(IslandEntry) do
    match entries do
    Nil -> None
    Cons((k, v), rest) ->
      if k == id do Some(v) else get_entry(rest, id) end
    end
  end

  pfn remove_island(store : IslandState, id : String) : IslandState do
    match store do
    IslandState(entries) ->
      IslandState(remove_entry(entries, id))
    end
  end

  pfn remove_entry(entries : List((String, IslandEntry)), id : String) : List((String, IslandEntry)) do
    match entries do
    Nil -> Nil
    Cons((k, v), rest) ->
      if k == id do rest else Cons((k, v), remove_entry(rest, id)) end
    end
  end

  -- ── Plug ────────────────────────────────────────────────────────────────

  doc """
  Build a Conn -> Conn plug that upgrades matching requests to an island
  WebSocket with server-side rendering.

  Rejects WebSocket handshakes with a missing Origin header, or an Origin
  that does not match the request Host and is not on the config's
  allowed-origin list.  This defends against cross-site WebSocket hijacking:
  browsers do not enforce the same-origin policy on WebSocket connections,
  so the server must validate the Origin itself.
  """
  fn plug(cfg : Config, registry : Registry) : Conn -> Conn do
    let socket_path = config_path(cfg)
    let allowed     = config_allowed_origins(cfg)
    fn conn -> do
      let req_path = HttpServer.path(conn)
      if req_path == socket_path do
        match origin_allowed(conn, allowed) do
        true  -> WebSocket.upgrade(conn, fn ws_sock -> ws_loop(ws_sock, empty_state(), registry))
        false -> HttpServer.send_resp(conn, 403, "origin not allowed")
        end
      else
        conn
      end
    end
  end

  -- Decide whether a request's Origin header permits a WebSocket upgrade.
  -- Returns true only when the Origin is present AND either:
  --   - matches the Host header (same-origin), or
  --   - is on the configured allowed-origin list.
  pfn origin_allowed(conn : Conn, allowed : List(String)) : Bool do
    match HttpServer.get_req_header(conn, "origin") do
    None -> false
    Some(origin) ->
      if List.any(allowed, fn o -> o == origin) do
        true
      else
        match HttpServer.get_req_header(conn, "host") do
        None       -> false
        Some(host) -> origin_matches_host(origin, host)
        end
      end
    end
  end

  -- Check if Origin "scheme://host[:port]" refers to the same authority as
  -- the Host header.  We accept both http:// and https:// schemes because the
  -- server doesn't know from the Conn alone whether it's behind TLS.
  pfn origin_matches_host(origin : String, host : String) : Bool do
    origin == "http://" ++ host || origin == "https://" ++ host
  end

  -- ── WebSocket loop ──────────────────────────────────────────────────────

  pfn ws_loop(ws_sock : WsSocket, store : IslandState, registry : Registry) : Unit do
    match WebSocket.recv(ws_sock) do
    TextFrame(text) -> do
      let new_store = handle_text(ws_sock, text, store, registry)
      ws_loop(ws_sock, new_store, registry)
    end
    Close(_, _) -> ()
    Ping -> do
      WebSocket.send_frame(ws_sock, Pong)
      ws_loop(ws_sock, store, registry)
    end
    _ -> ws_loop(ws_sock, store, registry)
    end
  end

  -- ── Message dispatch ────────────────────────────────────────────────────

  pfn handle_text(ws_sock : WsSocket, text : String, store : IslandState, registry : Registry) : IslandState do
    let (new_store, responses) = dispatch_text(text, store, registry)
    send_all(ws_sock, responses)
    new_store
  end

  pfn send_all(ws_sock : WsSocket, msgs : List(String)) : Unit do
    match msgs do
    Nil -> ()
    Cons(m, rest) -> do
      WebSocket.send_frame(ws_sock, TextFrame(m))
      send_all(ws_sock, rest)
    end
    end
  end

  pfn dispatch_text(text : String, store : IslandState, registry : Registry) : (IslandState, List(String)) do
    match Json.parse(text) do
    Ok(msg) -> do
      let island_id = json_string_field(msg, "island")
      let msg_type  = json_string_field(msg, "type")
      let payload   = extract_payload(msg)
      match msg_type do
      "init"        -> handle_init_pure(msg, payload, island_id, store, registry)
      "msg"         -> handle_msg_pure(payload, island_id, store, registry)
      "child_event" -> handle_child_event_pure(msg, payload, island_id, store, registry)
      "optimistic"  -> handle_optimistic_pure(payload, island_id, store, registry)
      "destroy"     -> (handle_destroy(island_id, store), [])
      _             -> (store, [])
      end
    end
    Err(_) -> (store, [])
    end
  end

  -- ── Pure message handlers ───────────────────────────────────────────────
  --
  -- These return (new_state, response_messages) without performing I/O.
  -- Used both by the live WebSocket loop (via dispatch_text) and by
  -- process_msg_for_test for deterministic testing.

  pfn handle_init_pure(msg : JsonValue, payload : String, island_id : String, store : IslandState, registry : Registry) : (IslandState, List(String)) do
    let module_name = json_string_field(msg, "module")
    let entry = IslandEntry(module_name, payload)
    let new_store = put_island(store, island_id, entry)
    match find_handler(registry, module_name) do
    Some(handler) -> do
      match handler do
      IslandHandler(_, dataflow, _, render_fn, _, _) -> do
        let html = render_fn(payload)
        -- Client-mode islands: include handoff:true so the JS runtime loads
        -- the island's WASM module and handles subsequent events locally.
        let render_msg = if dataflow == "client" do
          make_render_handoff_json(island_id, html)
        else
          make_render_json(island_id, html)
        end
        (new_store, [render_msg, make_state_json(island_id, payload)])
      end
      end
    end
    None -> (new_store, [make_state_json(island_id, payload)])
    end
  end

  pfn handle_msg_pure(msg_payload : String, island_id : String, store : IslandState, registry : Registry) : (IslandState, List(String)) do
    match get_island(store, island_id) do
    Some(entry) -> do
      match entry do
      IslandEntry(module_name, current_state) -> do
        match find_handler(registry, module_name) do
        Some(handler) -> do
          match handler do
          IslandHandler(_, _, update_fn, render_fn, _, _) -> do
            let new_state = update_fn((current_state, msg_payload))
            let new_store = put_island(store, island_id, IslandEntry(module_name, new_state))
            let html = render_fn(new_state)
            (new_store, [make_render_json(island_id, html), make_state_json(island_id, new_state)])
          end
          end
        end
        -- Handler not registered for this module (e.g. the island was
        -- unregistered between init and msg).  Previously we echoed the
        -- *incoming* msg_payload back as state, which both mis-represented
        -- authoritative state and gave clients a state-injection surface.
        -- Keep state unchanged and send an error message instead.
        None -> (store, [make_error_json(island_id, "handler_not_registered")])
        end
      end
      end
    end
    None -> (store, [])
    end
  end

  pfn handle_child_event_pure(msg : JsonValue, event_payload_ : String, parent_id : String, store : IslandState, registry : Registry) : (IslandState, List(String)) do
    let event_name_ = json_string_field(msg, "event")
    match get_island(store, parent_id) do
    Some(entry) -> do
      match entry do
      IslandEntry(module_name, current_state) -> do
        match find_handler(registry, module_name) do
        Some(handler) -> do
          match handler do
          IslandHandler(_, _, _, render_fn, _, child_fn_opt) -> do
            let new_state = match child_fn_opt do
              Some(child_fn) -> child_fn((current_state, event_name_, event_payload_))
              None           -> current_state
              end
            let new_store = put_island(store, parent_id, IslandEntry(module_name, new_state))
            let html = render_fn(new_state)
            (new_store, [make_render_json(parent_id, html), make_state_json(parent_id, new_state)])
          end
          end
        end
        None -> (store, [])
        end
      end
      end
    end
    None -> (store, [])
    end
  end

  pfn handle_optimistic_pure(client_state : String, island_id : String, store : IslandState, registry : Registry) : (IslandState, List(String)) do
    match get_island(store, island_id) do
    Some(entry) -> do
      match entry do
      IslandEntry(module_name, server_state) -> do
        match find_handler(registry, module_name) do
        Some(handler) -> do
          match handler do
          IslandHandler(_, _, _, render_fn, merge_opt, _) -> do
            let merged_state = match merge_opt do
              Some(merge_fn) -> merge_fn((client_state, server_state))
              None           -> server_state
              end
            let new_store = put_island(store, island_id, IslandEntry(module_name, merged_state))
            let html = render_fn(merged_state)
            (new_store, [make_render_json(island_id, html), make_merge_json(island_id, merged_state)])
          end
          end
        end
        None -> (store, [make_merge_json(island_id, client_state)])
        end
      end
      end
    end
    None -> (store, [])
    end
  end

  pfn handle_destroy(island_id : String, store : IslandState) : IslandState do
    remove_island(store, island_id)
  end

  -- ── Test helper ─────────────────────────────────────────────────────────

  doc """
  Process a single JSON message against the given store and registry,
  returning the new store and a list of JSON response strings.

  This is the pure, side-effect-free equivalent of the live WebSocket loop.
  Use it in tests to exercise the full bidirectional message protocol without
  a live WebSocket connection.

  Example:
    let reg = IslandSocket.new_registry()
              |> IslandSocket.register("Counter", counter_update, counter_render)
    let store = IslandSocket.empty_store()
    let init = "{\"island\":\"c-1\",\"type\":\"init\",\"module\":\"Counter\",\"payload\":{\"count\":0}}"
    let (store2, responses) = IslandSocket.process_msg_for_test(init, store, reg)
    -- responses contains render + state JSON strings
  """
  fn process_msg_for_test(text : String, store : IslandState, registry : Registry) : (IslandState, List(String)) do
    dispatch_text(text, store, registry)
  end

  -- ── JSON response builders ───────────────────────────────────────────────

  pfn make_render_json(island_id : String, html : String) : String do
    "{\"island\":\"" ++ json_escape(island_id) ++ "\",\"type\":\"render\",\"payload\":\"" ++ json_escape(html) ++ "\"}"
  end

  -- Like make_render_json but adds "handoff":true, telling the JS runtime to
  -- load the island's WASM module and take over subsequent updates locally.
  pfn make_render_handoff_json(island_id : String, html : String) : String do
    "{\"island\":\"" ++ json_escape(island_id) ++ "\",\"type\":\"render\",\"payload\":\"" ++ json_escape(html) ++ "\",\"handoff\":true}"
  end

  pfn make_state_json(island_id : String, state_json : String) : String do
    "{\"island\":\"" ++ json_escape(island_id) ++ "\",\"type\":\"state\",\"payload\":" ++ state_json ++ "}"
  end

  pfn make_merge_json(island_id : String, state_json : String) : String do
    "{\"island\":\"" ++ json_escape(island_id) ++ "\",\"type\":\"merge\",\"payload\":" ++ state_json ++ "}"
  end

  -- Error frame for client diagnostics.  The "code" field is a short
  -- machine-readable identifier (e.g. "handler_not_registered"); front-end
  -- code can surface it without having to parse human prose.
  pfn make_error_json(island_id : String, code : String) : String do
    "{\"island\":\"" ++ json_escape(island_id) ++ "\",\"type\":\"error\",\"payload\":{\"code\":\"" ++ json_escape(code) ++ "\"}}"
  end

  -- ── Response helpers ──────────────────────────────────────────────────

  pfn send_render(ws_sock : WsSocket, island_id : String, html : String) : Unit do
    WebSocket.send_frame(ws_sock, TextFrame(make_render_json(island_id, html)))
  end

  pfn send_state(ws_sock : WsSocket, island_id : String, state_json : String) : Unit do
    WebSocket.send_frame(ws_sock, TextFrame(make_state_json(island_id, state_json)))
  end

  pfn send_merge(ws_sock : WsSocket, island_id : String, state_json : String) : Unit do
    WebSocket.send_frame(ws_sock, TextFrame(make_merge_json(island_id, state_json)))
  end

  -- send_props pushes updated props from a parent to a specific child instance.
  pfn send_props(ws_sock : WsSocket, child_id : String, props_json : String) : Unit do
    let response = "{\"island\":\"" ++ json_escape(child_id) ++ "\",\"type\":\"props\",\"payload\":" ++ props_json ++ "}"
    WebSocket.send_frame(ws_sock, TextFrame(response))
  end

  -- ── JSON helpers ────────────────────────────────────────────────────────

  pfn json_string_field(obj : JsonValue, key : String) : String do
    match Json.get(obj, key) do
    Some(Str(s)) -> s
    _            -> ""
    end
  end

  -- Extract the "payload" field from an already-parsed JsonValue and
  -- serialise it back to JSON text.  Using Json.get + Json.to_string avoids
  -- the old substring-based extraction which assumed the payload key was
  -- always last and trimmed exactly one byte from the end — a fragile
  -- assumption that broke whenever the payload was a nested object or the
  -- message had trailing whitespace.
  pfn extract_payload(msg : JsonValue) : String do
    match Json.get(msg, "payload") do
    Some(v) -> Json.to_string(v)
    None    -> "null"
    end
  end

  pfn json_escape(s : String) : String do
    let s1 = String.replace_all(s, "\\", "\\\\")
    String.replace_all(s1, "\"", "\\\"")
  end

end
