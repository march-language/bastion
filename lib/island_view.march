-- IslandView — template helpers for embedding islands in server-rendered HTML.
--
-- Use these functions in controller templates to render island wrappers and
-- include the client runtime scripts.
--
-- Dataflow modes:
--   island_server/2       — Server-mode island (read-only, no event listeners)
--   island/2              — Client-mode island (owns its state, handles events)
--   island_ssr/3          — Client-mode with server-rendered inner HTML
--
-- Channel sync (Client mode only):
--   island_with_channel/3   — wire up a channel topic; state syncs after each update
--
-- Parent-child binding:
--   island_child/4      — child island slotted inside a parent
--   island_child_ssr/5  — child island with server-rendered initial HTML
--
-- Dataflow helpers (for template use):
--   island_with_dataflow/3    — island with explicit dataflow string
--   island_ssr_with_dataflow/4 — island with SSR content and explicit dataflow string
--   child_island/4            — child island with SSR content
--
-- Hydration strategy variants:
--   island_with_strategy/3   — specify eager/lazy/on-visible/on-idle
--   island_ssr_with_strategy/4
--
-- Example (in a controller template):
--
--   let counter_html = IslandView.island_ssr("Counter", "{\"count\":0}", Counter.render("{\"count\":0}"))
--   let scripts      = IslandView.scripts()
--   "<html><body>" ++ counter_html ++ scripts ++ "</body></html>"
--
-- See also: island_socket.march, island_assets.march, islands.march.

mod IslandView do

  -- ── Server-mode islands ──────────────────────────────────────────────────
  --
  -- Server-mode islands are read-only projections. The JS runtime does NOT
  -- attach event listeners. State arrives only via the wired channel.

  doc """
  Render a Server-mode island placeholder.

  The JS runtime will not attach any event listeners to this island.
  Use Server mode for display-only islands like live feeds, scoreboards, etc.
  """
  fn island_server(name : String, state_json : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"server\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "'></div>"
  end

  doc """
  Render a Server-mode island with server-rendered inner HTML.

  The inner_html is shown immediately; the JS runtime takes over on hydration
  and patches the DOM as the server pushes new state.
  """
  fn island_server_ssr(name : String, state_json : String, inner_html : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"server\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "'>" ++ inner_html ++ "</div>"
  end

  -- ── Client-mode islands ──────────────────────────────────────────────────
  --
  -- Client-mode islands own their state. Events are handled locally.
  -- Optional: wire up a channel topic to sync state after each update.

  doc """
  Render a Client-mode island placeholder with initial state.

  The JS runtime attaches event listeners and routes data-on-* events
  to the island's local update function.
  """
  fn island(name : String, state_json : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "'></div>"
  end

  doc """
  Render a Client-mode island with server-rendered initial HTML.

  The inner_html is displayed immediately while the WASM module loads.
  On hydration the runtime takes over and patches the DOM as state changes.
  """
  fn island_ssr(name : String, state_json : String, inner_html : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "'>" ++ inner_html ++ "</div>"
  end

  doc """
  Render a Client-mode island wired to a channel for state sync.

  After each local update, the JS runtime pushes the new state JSON to the
  channel topic. The channel can push state down at any time (last-write-wins).

  Without a channel, use island/2 for purely local state.

  Example:
    IslandView.island_with_channel("Counter", state_json, "counter:#{user_id}")
  """
  fn island_with_channel(name : String, state_json : String, channel_topic : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "' data-march-channel=\"" ++ escape_attr(channel_topic) ++ "\"></div>"
  end

  doc """
  Render a Client-mode island with SSR content wired to a channel.
  """
  fn island_ssr_with_channel(name : String, state_json : String, channel_topic : String, inner_html : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "' data-march-channel=\"" ++ escape_attr(channel_topic) ++ "\">" ++ inner_html ++ "</div>"
  end

  -- ── Child islands ────────────────────────────────────────────────────────
  --
  -- Child islands are slotted inside a parent island. The parent is the source
  -- of truth for the child's props. Children dispatch events upward via the
  -- runtime's internal tree-walk (not the old global send bus).
  --
  -- The parent must implement handle_child_event to receive dispatched events.
  -- The on_event name here must match the name the parent registered.

  doc """
  Render a child island placeholder slotted inside a parent.

  The JS runtime uses data-march-parent to walk up the tree when the child
  dispatches an event. The parent's handle_child_event is called with the
  event name and payload JSON.

  Parameters:
    name      — child island module name
    parent_id — parent's data-march-instance-id value
    on_event  — event handler name registered on the parent
    state_json — initial state JSON (derived from parent state)
  """
  fn island_child(name : String, parent_id : String, on_event : String, state_json : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "' data-march-parent=\"" ++ escape_attr(parent_id) ++ "\" data-march-on-event=\"" ++ escape_attr(on_event) ++ "\"></div>"
  end

  doc """
  Render a child island with server-rendered initial HTML.
  """
  fn island_child_ssr(name : String, parent_id : String, on_event : String, state_json : String, inner_html : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "' data-march-parent=\"" ++ escape_attr(parent_id) ++ "\" data-march-on-event=\"" ++ escape_attr(on_event) ++ "\">" ++ inner_html ++ "</div>"
  end

  -- ── Dataflow helpers ──────────────────────────────────────────────────────
  --
  -- These take dataflow as a plain string ("client" | "server") so they can be
  -- called from generated or dynamic code without importing Islands.DataflowMode.

  doc """
  Render an island placeholder with an explicit dataflow string.

  dataflow should be "client" or "server".
  """
  fn island_with_dataflow(name : String, state_json : String, dataflow : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"" ++ dataflow ++ "\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "'></div>"
  end

  doc """
  Render an island with SSR content and an explicit dataflow string.

  dataflow should be "client" or "server".
  """
  fn island_ssr_with_dataflow(name : String, state_json : String, dataflow : String, inner_html : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"" ++ dataflow ++ "\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "'>" ++ inner_html ++ "</div>"
  end

  doc """
  Render a child island with SSR content and a parent reference.

  A convenience wrapper for the common case of a child island with initial
  server-rendered HTML and a parent binding. Uses Server dataflow (children
  are always Server-dataflow relative to their parent).

  Parameters:
    name      — child island module name
    parent_id — parent island instance ID
    state_json — initial state JSON (derived from parent state)
    inner_html — server-rendered inner HTML
  """
  fn child_island(name : String, parent_id : String, state_json : String, inner_html : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"server\" data-march-hydrate=\"eager\" data-march-state='" ++ escape_attr(state_json) ++ "' data-march-parent=\"" ++ escape_attr(parent_id) ++ "\">" ++ inner_html ++ "</div>"
  end

  -- ── Hydration strategy variants ──────────────────────────────────────────

  doc """
  Render a Client-mode island placeholder with a hydration strategy.

  strategy is one of: "eager", "lazy", "on-visible", "on-idle".
  """
  fn island_with_strategy(name : String, state_json : String, strat : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"" ++ strat ++ "\" data-march-state='" ++ escape_attr(state_json) ++ "'></div>"
  end

  doc """
  Render a Client-mode island with SSR content and a hydration strategy.
  """
  fn island_ssr_with_strategy(name : String, state_json : String, strat : String, inner_html : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"" ++ strat ++ "\" data-march-state='" ++ escape_attr(state_json) ++ "'>" ++ inner_html ++ "</div>"
  end

  -- ── Script tags ─────────────────────────────────────────────────────────

  doc """
  Generate the script tag that loads the island client runtime.

  Include this in your layout <head> or before </body>.
  Uses the default Bastion assets path.
  """
  fn scripts() : String do
    "<script src=\"/_bastion/islands.js\"></script>"
  end

  doc """
  Generate the island runtime script tag with a custom base URL.

  Example:
    IslandView.scripts_with_base("/assets")
    -- produces: <script src="/assets/islands.js"></script>
  """
  fn scripts_with_base(base_url : String) : String do
    "<script src=\"" ++ base_url ++ "/islands.js\"></script>"
  end

  doc """
  Generate the WebSocket connection script tag.

  This script connects to the island WebSocket endpoint and wires up
  the bidirectional message loop. Include after scripts().
  """
  fn ws_scripts() : String do
    "<script src=\"/_bastion/islands-ws.js\"></script>"
  end

  doc """
  Generate the WebSocket script tag with a custom base URL.
  """
  fn ws_scripts_with_base(base_url : String) : String do
    "<script src=\"" ++ base_url ++ "/islands-ws.js\"></script>"
  end

  -- ── Internal helpers ────────────────────────────────────────────────────

  -- Escape characters that would break a single-quoted HTML attribute.
  pfn escape_attr(s : String) : String do
    let s1 = String.replace_all(s, "&", "&amp;")
    let s2 = String.replace_all(s1, "'", "&#39;")
    s2
  end

end
