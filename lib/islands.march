-- Islands — hydration wrappers, registry, and dataflow helpers for Bastion WASM islands.
--
-- Islands are interactive WASM components hydrated on the client. Each island
-- wrapper div carries:
--   data-march-island     — module name
--   data-march-hydrate    — when to load the WASM module (see HydrateOn)
--   data-march-dataflow   — "client" | "server" (see DataflowMode)
--   data-march-state      — initial state JSON
--   data-march-island-css — optional scoped CSS (injected into <head> on hydration)
--   data-march-channel    — optional channel topic (Client mode, last-write-wins sync)
--   data-march-parent     — parent island instance ID (child islands only)
--   data-march-on-event   — event handler name on parent (child islands only)
--
-- Dataflow modes (spec: specs/islands-data-flow.md):
--
--   Client — island owns its own state, handles events locally via WASM.
--            Optionally syncs to a channel topic (last-write-wins).
--            No channel = purely local state.
--
--   Server — server owns state, client is a read-only projection.
--            The JS runtime does NOT attach event listeners.
--            State arrives only via the wired channel.
--
-- Parent-child binding:
--
--   Child islands carry data-march-parent (parent instance ID) and
--   data-march-on-event (handler name). Children dispatch events upward
--   through the JS runtime's tree-walk. There is no global send bus.
--   Parents implement handle_child_event to receive dispatched events.

mod Islands do

  -- Hydration strategy — when the WASM module is loaded and the island activated.
  type HydrateOn =
    Eager          -- load immediately on page load
    | Lazy         -- load after DOMContentLoaded
    | OnIdle       -- load during requestIdleCallback
    | OnInteraction -- load on first user interaction (click, focus, etc.)
    | OnVisible    -- load when scrolled into view (IntersectionObserver)

  -- Dataflow mode — describes who owns the island's state.
  -- Constructors are ServerOwned/ClientOwned rather than Server/Client because
  -- the unqualified names collide with HttpServer.Server and HttpClient.Client
  -- from the stdlib.
  type DataflowMode = ServerOwned | ClientOwned

  -- DataFlow is an alias type for use with the dataflow spec helpers below.
  -- Server and Client map to the same semantics as ServerOwned and ClientOwned.
  type DataFlow = Server | Client

  -- Event — a named event with a JSON payload, dispatched from a child island upward.
  type Event = Event(String, String)
  -- Event(event_name, payload_json)

  -- FormConfig — channel and redirect configuration for form islands.
  type FormConfig = FormConfig(String, String)
  -- FormConfig(channel_topic, redirect_path)

  -- ── Constructor accessor functions ──────────────────────────────────────
  -- Use these instead of direct constructor access from outside this module,
  -- because direct constructor access (e.g. Islands.Eager) does not carry the
  -- fully qualified type across module boundaries in March.

  doc "Return the Eager hydration strategy."
  fn eager()          do Eager end
  doc "Return the Lazy hydration strategy."
  fn lazy_hydrate()   do Lazy end
  doc "Return the OnIdle hydration strategy."
  fn on_idle()        do OnIdle end
  doc "Return the OnInteraction hydration strategy."
  fn on_interaction() do OnInteraction end
  doc "Return the OnVisible hydration strategy."
  fn on_visible()     do OnVisible end
  doc "Return the Client dataflow mode."
  fn client_mode()    do ClientOwned end
  doc "Return the Server dataflow mode."
  fn server_mode()    do ServerOwned end
  doc "Construct an Event value."
  fn new_event(name : String, payload : String) do Event(name, payload) end
  doc "Construct a FormConfig value."
  fn new_form_config(channel : String, redirect : String) do FormConfig(channel, redirect) end

  -- ── Island interface ────────────────────────────────────────────────────
  --
  -- Implement Island(s) for any module that serves as a WASM island.  The type
  -- parameter s is the island's state type.
  --
  -- Required methods:
  --   render(state : s) : String
  --       Server-side HTML from state; also called after every client update.
  --
  --   update(state : s, msg : String) : s
  --       Apply a JSON-encoded event message, return next state.  The JS
  --       runtime calls this with serialized user events.
  --
  -- Example:
  --   impl Island(Counter.State) do
  --     fn render(state) do Counter.render(state) end
  --     fn update(state, msg_json) do
  --       Counter.update(state, Counter.decode_msg(msg_json))
  --     end
  --   end
  --
  -- TODO: When WASM codegen (Tier 4) lands, the compiler will verify
  -- impl Island(T) exports match the expected WASM function signatures.
  interface Island(s) do
    fn render : s -> String
    fn update : s -> String -> s
  end

  -- ── Hydration strategy helpers ──────────────────────────────────────────

  doc "Convert a HydrateOn strategy to the data-march-hydrate attribute string."
  fn hydrate_attr(strat) : String do
    match strat do
    Eager         -> "eager"
    Lazy          -> "lazy"
    OnIdle        -> "idle"
    OnInteraction -> "interaction"
    OnVisible     -> "on-visible"
    end
  end

  -- strategy_str is an alias for hydrate_attr for compatibility.
  pfn strategy_str(strat : HydrateOn) : String do
    hydrate_attr(strat)
  end

  doc """
  Convert a dataflow mode value to the data-march-dataflow attribute string.

  Accepts either DataflowMode (ServerOwned/ClientOwned) or DataFlow (Server/Client).
  """
  fn dataflow_str(mode : DataflowMode) : String do
    match mode do
    ServerOwned -> "server"
    ClientOwned -> "client"
    end
  end

  doc "Convert a DataFlow value to the data-march-dataflow attribute string."
  fn dataflow_mode_str(df : DataFlow) : String do
    match df do
    Server -> "server"
    Client -> "client"
    end
  end

  -- ── DataFlow helpers (spec-aligned) ────────────────────────────────────

  doc "Get the event name from an Event."
  fn event_name(evt : Event) : String do
    match evt do
    Event(name, _payload) -> name
    end
  end

  doc "Get the JSON payload from an Event."
  fn event_payload(evt : Event) : String do
    match evt do
    Event(_name, payload) -> payload
    end
  end

  doc "Encode an Event as a JSON string."
  fn event_to_json(evt : Event) : String do
    match evt do
    Event(name, payload) ->
      "{\"event\":\"" ++ json_esc(name) ++ "\",\"payload\":" ++ payload ++ "}"
    end
  end

  doc "Build a dispatch JSON message with source island info."
  fn dispatch_json(source_id : String, event : String, payload : String) : String do
    "{\"source\":\"" ++ json_esc(source_id)
    ++ "\",\"event\":\"" ++ json_esc(event)
    ++ "\",\"payload\":" ++ payload ++ "}"
  end

  -- ── FormConfig helpers ─────────────────────────────────────────────────

  doc "Return the channel topic from a FormConfig."
  fn form_channel(cfg : FormConfig) : String do
    match cfg do
    FormConfig(channel, _) -> channel
    end
  end

  doc "Return the redirect path from a FormConfig."
  fn form_redirect(cfg : FormConfig) : String do
    match cfg do
    FormConfig(_, redirect) -> redirect
    end
  end

  -- ── Core wrap helpers ───────────────────────────────────────────────────
  --
  -- The primary `wrap` function is the 4-arg form that takes only a strategy.
  -- It defaults to Client dataflow mode (the common case).
  --
  -- Use wrap_with_dataflow/6 to specify an explicit DataflowMode and optional CSS.
  -- Use wrap_with_channel/7 for Client islands with channel sync.
  -- Use wrap_child/6 for islands nested inside a parent island.

  doc """
  Wrap server-rendered HTML with island metadata for client hydration.

  Defaults to Client dataflow mode. No channel wired (purely local state).

  Parameters:
    name       — island module name (e.g. "Counter")
    strat      — when to load the WASM module (HydrateOn)
    state_json — initial state as JSON string
    ssr_html   — server-rendered inner HTML (shown before WASM loads)
  """
  fn wrap(name : String, strat, state_json : String, ssr_html : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"" ++ hydrate_attr(strat) ++ "\" data-march-state='" ++ escape_sq(state_json) ++ "'>" ++ ssr_html ++ "</div>"
  end

  doc "Convenience: Client-mode eager wrap."
  fn wrap_eager(name : String, state_json : String, ssr_html : String) : String do
    wrap(name, Eager, state_json, ssr_html)
  end

  doc """
  Wrap with an explicit DataflowMode and optional scoped CSS.

  Parameters:
    name       — island module name
    strat      — hydration strategy
    mode       — Client or Server dataflow mode (DataflowMode or DataFlow)
    state_json — initial state as JSON string
    css        — scoped CSS string (empty string = omit the attribute)
    ssr_html   — server-rendered inner HTML
  """
  fn wrap_with_dataflow(name : String, strat, mode, state_json : String, css : String, ssr_html : String) : String do
    let base = "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"" ++ dataflow_str(mode) ++ "\" data-march-hydrate=\"" ++ hydrate_attr(strat) ++ "\" data-march-state='" ++ escape_sq(state_json) ++ "'"
    let with_css = if css == "" do base else base ++ " data-march-island-css=\"" ++ escape_dq(css) ++ "\"" end
    with_css ++ ">" ++ ssr_html ++ "</div>"
  end

  doc """
  Client-only island placeholder: no server-rendered inner HTML.

  The island div is present in the DOM for hydration, but the visible content
  is entirely produced by the client-side WASM render function.
  """
  fn client_only(name : String, strat, state_json : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"" ++ hydrate_attr(strat) ++ "\" data-march-state='" ++ escape_sq(state_json) ++ "'></div>"
  end

  -- ── CSS helpers ─────────────────────────────────────────────────────────
  --
  -- These variants embed scoped CSS in data-march-island-css so the JS runtime
  -- injects it into <head> on first hydration (one <style> per module).

  doc """
  Wrap with island metadata including scoped CSS.

  The CSS string is HTML-escaped and embedded in the data-march-island-css
  attribute. The JS runtime creates a <style> tag in <head> on first hydration.

  Parameters:
    name       — island module name
    strat      — hydration strategy
    state_json — initial state as JSON string
    css        — scoped CSS (will be escaped for use in HTML attribute)
    ssr_html   — server-rendered inner HTML
  """
  fn wrap_with_css(name : String, strat, state_json : String, css : String, ssr_html : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"" ++ hydrate_attr(strat) ++ "\" data-march-state='" ++ escape_sq(state_json) ++ "' data-march-island-css=\"" ++ escape_dq(css) ++ "\">" ++ ssr_html ++ "</div>"
  end

  doc "Convenience: Client-mode eager wrap with scoped CSS."
  fn wrap_eager_with_css(name : String, state_json : String, css : String, ssr_html : String) : String do
    wrap_with_css(name, Eager, state_json, css, ssr_html)
  end

  -- ── Channel sync ─────────────────────────────────────────────────────────

  doc """
  Wrap an island with a channel topic for state sync and an explicit dataflow mode.

  When a channel is wired, the JS runtime pushes new state to the channel
  topic after each local update (last-write-wins) for Client islands.
  Server islands use the channel to receive server-pushed state.

  Parameters:
    name          — island module name
    strat         — hydration strategy
    mode          — Client or Server dataflow mode
    state_json    — initial state as JSON string
    css           — scoped CSS (empty string = omit)
    ssr_html      — server-rendered inner HTML
    channel_topic — topic string (e.g. "counter:#{user_id}")
  """
  fn wrap_with_channel(name : String, strat, mode, state_json : String, css : String, ssr_html : String, channel_topic : String) : String do
    let base = "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"" ++ dataflow_str(mode) ++ "\" data-march-hydrate=\"" ++ hydrate_attr(strat) ++ "\" data-march-state='" ++ escape_sq(state_json) ++ "' data-march-channel=\"" ++ escape_dq(channel_topic) ++ "\""
    let with_css = if css == "" do base else base ++ " data-march-island-css=\"" ++ escape_dq(css) ++ "\"" end
    with_css ++ ">" ++ ssr_html ++ "</div>"
  end

  -- ── Parent-child binding ──────────────────────────────────────────────────

  doc """
  Wrap a child island slotted inside a parent island.

  Children always have Server dataflow relative to their parent — they receive
  props from the parent and dispatch events upward. The parent must implement
  handle_child_event to receive those events.

  Parameters:
    name       — child island module name
    parent_id  — parent island's instance ID
    strat      — hydration strategy
    state_json — initial state JSON (derived from parent state)
    css        — scoped CSS (empty string = omit)
    ssr_html   — server-rendered inner HTML
  """
  fn wrap_child(name : String, parent_id : String, strat, state_json : String, css : String, ssr_html : String) : String do
    let base = "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"server\" data-march-hydrate=\"" ++ hydrate_attr(strat) ++ "\" data-march-state='" ++ escape_sq(state_json) ++ "' data-march-parent=\"" ++ escape_dq(parent_id) ++ "\""
    let with_css = if css == "" do base else base ++ " data-march-island-css=\"" ++ escape_dq(css) ++ "\"" end
    with_css ++ ">" ++ ssr_html ++ "</div>"
  end

  doc """
  Wrap a child island with an explicit on_event handler name.

  Use this when the parent registers a named event handler via on_event= in
  its template. The on_event name must match what the parent's handle_child_event
  is registered under.

  Parameters:
    name      — child island module name
    parent_id — parent island's instance ID
    strat     — hydration strategy
    state_json — initial state JSON
    css       — scoped CSS (empty string = omit)
    ssr_html  — server-rendered inner HTML
    on_event  — event handler name registered on the parent
  """
  fn wrap_child_with_event(name : String, parent_id : String, strat, state_json : String, css : String, ssr_html : String, on_event : String) : String do
    let base = "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"server\" data-march-hydrate=\"" ++ hydrate_attr(strat) ++ "\" data-march-state='" ++ escape_sq(state_json) ++ "' data-march-parent=\"" ++ escape_dq(parent_id) ++ "\" data-march-on-event=\"" ++ escape_dq(on_event) ++ "\""
    let with_css = if css == "" do base else base ++ " data-march-island-css=\"" ++ escape_dq(css) ++ "\"" end
    with_css ++ ">" ++ ssr_html ++ "</div>"
  end

  doc """
  Wrap a child island with an explicit instance ID for unique identification.

  Parameters:
    name      — child island module name
    parent_id — parent island's instance ID
    child_id  — explicit instance ID for this child island
    strat     — hydration strategy
    state_json — initial state JSON
    css       — scoped CSS (empty string = omit)
    ssr_html  — server-rendered inner HTML
  """
  fn wrap_child_with_id(name : String, parent_id : String, child_id : String, strat, state_json : String, css : String, ssr_html : String) : String do
    let base = "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"server\" data-march-hydrate=\"" ++ hydrate_attr(strat) ++ "\" data-march-state='" ++ escape_sq(state_json) ++ "' data-march-parent=\"" ++ escape_dq(parent_id) ++ "\" data-march-id=\"" ++ escape_dq(child_id) ++ "\""
    let with_css = if css == "" do base else base ++ " data-march-island-css=\"" ++ escape_dq(css) ++ "\"" end
    with_css ++ ">" ++ ssr_html ++ "</div>"
  end

  doc "Convenience: Server-mode eager wrap (display-only island, no event listeners)."
  fn wrap_server(name : String, state_json : String, ssr_html : String) : String do
    wrap_with_dataflow(name, Eager, ServerOwned, state_json, "", ssr_html)
  end

  -- ── Form islands ─────────────────────────────────────────────────────────

  doc """
  Wrap a form island with channel and redirect configuration.

  Form islands have a built-in submit lifecycle:
    1. User fills fields → UpdateField msgs update local state.
    2. User submits → validate runs client-side.
    3. If valid → push to channel topic.
    4. Server responds → drive state to Success or show validation errors.

  Parameters:
    name          — island module name
    strat         — hydration strategy
    state_json    — initial state as JSON string
    form_html     — server-rendered form HTML
    channel_topic — channel topic for form submission (e.g. "contact:submit")
    redirect      — path to redirect to on success (e.g. "/thank-you")
  """
  fn wrap_form(name : String, strat, state_json : String, form_html : String, channel_topic : String, redirect : String) : String do
    "<div data-march-island=\"" ++ name ++ "\" data-march-dataflow=\"client\" data-march-hydrate=\"" ++ hydrate_attr(strat) ++ "\" data-march-state='" ++ escape_sq(state_json) ++ "' data-march-form=\"true\" data-march-channel=\"" ++ escape_dq(channel_topic) ++ "\" data-march-redirect=\"" ++ escape_dq(redirect) ++ "\">" ++ form_html ++ "</div>"
  end

  -- ── Server-mode validation ────────────────────────────────────────────────

  doc """
  Validate that server-rendered HTML does not contain client event attributes.

  Server islands are read-only projections. The compiler enforces this at
  compile time, but this function provides a runtime check for tests and
  dynamic render functions.

  Returns Ok(html) if the HTML is clean, Err(message) if a forbidden attribute
  is found. Forbidden attributes: data-on-click, data-on-input, data-on-change,
  data-on-submit, data-on-keydown, data-msg.
  """
  fn validate_server_html(html : String) : Result(String, String) do
    let forbidden = ["data-on-click", "data-on-input", "data-on-change", "data-on-submit", "data-on-keydown", "data-msg"]
    find_forbidden_attr(html, forbidden)
  end

  doc """
  Validate that a render function's output for a given state does not contain
  client event attributes.

  Calls render_fn(state_json) and runs validate_server_html on the result.
  Returns Ok(html) or Err(message).
  """
  fn validate_server_island(render_fn : String -> String, state_json : String) : Result(String, String) do
    let html = render_fn(state_json)
    validate_server_html(html)
  end

  pfn find_forbidden_attr(html : String, attrs : List(String)) : Result(String, String) do
    match attrs do
    Nil -> Ok(html)
    Cons(attr, rest) ->
      let found = match String.index_of(html, attr) do
        Some(_) -> true
        None    -> false
        end
      if found do
        Err("Server island render output contains forbidden attribute: " ++ attr)
      else
        find_forbidden_attr(html, rest)
      end
    end
  end

  -- ── Bootstrap & preload ─────────────────────────────────────────────────

  doc """
  Generate the <script type="module"> tag that loads the island client runtime.

  The runtime discovers data-march-island elements, opens the WebSocket, and
  manages island lifecycle (hydration, event dispatch, DOM morphing).

  Parameters:
    base_url — URL prefix where island JS assets are served (e.g. "/_march/islands")
  """
  fn bootstrap_script(base_url : String) : String do
    "<script type=\"module\" src=\"" ++ base_url ++ "/march-islands.js\"></script>"
  end

  doc """
  Generate the <script type="module"> tag for the island runtime, with a
  CSP nonce attribute.  Use this overload when Bastion.CSP is in the pipeline.

  Parameters:
    base_url — URL prefix for island JS assets
    nonce    — CSP nonce from BastionCSP.nonce(conn)

  Example:
    Islands.bootstrap_script_with_nonce("/_march/islands", BastionCSP.nonce(conn))
  """
  fn bootstrap_script_with_nonce(base_url : String, nonce : String) : String do
    if nonce == "" do
      bootstrap_script(base_url)
    else
      "<script type=\"module\" nonce=\"" ++ escape_dq(nonce) ++ "\" src=\"" ++ base_url ++ "/march-islands.js\"></script>"
    end
  end

  doc """
  Generate a <link rel="modulepreload"> hint for a specific island's WASM file.

  Tells the browser to start fetching the WASM file early, before the runtime
  requests it. Include one per island that appears above the fold.

  Parameters:
    base_url    — URL prefix for island assets
    module_name — island module name (e.g. "Counter")
  """
  fn preload_hint(base_url : String, module_name : String) : String do
    "<link rel=\"modulepreload\" href=\"" ++ base_url ++ "/" ++ module_name ++ ".wasm\">"
  end

  -- ── Island Registry ──────────────────────────────────────────────────────
  --
  -- The registry maps island module names to their WASM file paths and
  -- hydration strategies. Typically built at app startup and used to
  -- generate preload hints and drive the client-side WASM loader.

  -- Descriptor for a registered island module.
  --   Descriptor(name, strat, wasm_path)
  type Descriptor = Descriptor(String, HydrateOn, String)

  -- Registry is a list of Descriptors.
  type Registry = Registry(List(Descriptor))

  doc "Create an empty island registry."
  fn empty_registry() : Registry do
    Registry(Nil)
  end

  doc """
  Register an island descriptor in the registry.

  Example:
    Islands.empty_registry()
    |> Islands.register(Descriptor("Counter", Eager, "/_bastion/islands/counter.wasm"))
    |> Islands.register(Descriptor("TodoList", Lazy, "/_bastion/islands/todo_list.wasm"))
  """
  fn register(reg : Registry, d : Descriptor) : Registry do
    match reg do
    Registry(ds) -> Registry(Cons(d, ds))
    end
  end

  doc "Return the list of all registered island descriptors."
  fn registry_descriptors(reg : Registry) : List(Descriptor) do
    match reg do
    Registry(ds) -> ds
    end
  end

  doc """
  Look up a registered island by module name.

  Returns Some(Descriptor) if found, None otherwise.
  """
  fn find_island(reg : Registry, name : String) : Option(Descriptor) do
    match reg do
    Registry(ds) -> find_descriptor(ds, name)
    end
  end

  pfn find_descriptor(ds : List(Descriptor), name : String) : Option(Descriptor) do
    match ds do
    Nil -> None
    Cons(d, rest) ->
      match d do
      Descriptor(n, _, _) ->
        if n == name do Some(d) else find_descriptor(rest, name) end
      end
    end
  end

  doc "Return the module name from a descriptor."
  fn descriptor_name(d : Descriptor) : String do
    match d do
    Descriptor(name, _, _) -> name
    end
  end

  doc "Return the hydration strategy from a descriptor."
  fn descriptor_hydrate(d : Descriptor) : HydrateOn do
    match d do
    Descriptor(_, strat, _) -> strat
    end
  end

  doc "Return the WASM file path from a descriptor."
  fn descriptor_wasm_path(d : Descriptor) : String do
    match d do
    Descriptor(_, _, path) -> path
    end
  end

  doc """
  Generate a string of <link rel="modulepreload"> hints for all registered islands.

  Returns an empty string if the registry is empty.
  """
  fn registry_preload_hints(reg : Registry, base_url : String) : String do
    match reg do
    Registry(ds) -> build_hints(ds, base_url, "")
    end
  end

  pfn build_hints(ds : List(Descriptor), base_url : String, acc : String) : String do
    match ds do
    Nil -> acc
    Cons(d, rest) ->
      let hint = preload_hint(base_url, descriptor_name(d))
      build_hints(rest, base_url, acc ++ hint)
    end
  end

  -- ── Private helpers ─────────────────────────────────────────────────────

  -- escape_sq: for single-quoted HTML attributes (used for state JSON).
  -- Only escapes & and ' since double quotes are safe inside single-quote delimiters.
  pfn escape_sq(s : String) : String do
    let s1 = String.replace_all(s, "&", "&amp;")
    String.replace_all(s1, "'", "&#39;")
  end

  -- escape_dq: for double-quoted HTML attributes (CSS, channel, parent IDs, etc.).
  -- Escapes &, ", < and >.
  pfn escape_dq(s : String) : String do
    let s1 = String.replace_all(s, "&",  "&amp;")
    let s2 = String.replace_all(s1, "\"", "&quot;")
    let s3 = String.replace_all(s2, "<",  "&lt;")
    String.replace_all(s3, ">", "&gt;")
  end

  -- escape_attr is the legacy alias used in older call sites (double-quote escaping).
  pfn escape_attr(s : String) : String do
    escape_dq(s)
  end

  -- json_esc: escape a string for embedding in JSON string values.
  pfn json_esc(s : String) : String do
    let s1 = String.replace_all(s, "\\", "\\\\")
    String.replace_all(s1, "\"", "\\\"")
  end

end
