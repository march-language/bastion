-- lib/logger.march — Bastion.Logger
--
-- Thin wrapper over the March stdlib Logger.
--
-- The stdlib Logger handles level filtering, structured fields, and
-- pluggable appenders.  This module adds:
--
--   1. Bastion's two-argument call convention: info(msg, meta)
--      where meta : List((String, String)) maps naturally to logfmt/json fields.
--
--   2. A configure/2 helper called by the Application supervisor to
--      wire up the appender and level from Config on startup.
--
--   3. _conn helpers that pull request_id from the Conn automatically.
--
-- The stdlib Logger is always available as `Logger`; use it directly
-- for advanced use cases (with_scope, with_span, add_appender, etc.).

mod Bastion.Logger do

  -- ── Public API ────────────────────────────────────────────────────────────────

  doc "Log at DEBUG level with optional key-value metadata."
  fn debug(msg : String, meta : List((String, String))) do
    Logger.log_with(Logger.Debug, msg, meta)
  end

  doc "Log at INFO level with optional key-value metadata."
  fn info(msg : String, meta : List((String, String))) do
    Logger.log_with(Logger.Info, msg, meta)
  end

  doc "Log at WARN level with optional key-value metadata."
  fn warn(msg : String, meta : List((String, String))) do
    Logger.log_with(Logger.Warn, msg, meta)
  end

  doc "Log at ERROR level with optional key-value metadata."
  fn error(msg : String, meta : List((String, String))) do
    Logger.log_with(Logger.Error, msg, meta)
  end

  doc "Parse a level string (case-insensitive). Defaults to Info on unknown input."
  fn parse_level(s : String) do
    match Logger.level_from_string(s) do
    Some(l) -> l
    None    -> Logger.Info
    end
  end

  doc """
  Configure the stdlib Logger from application config.
  Call this once from Application.start() before any logging.

    Bastion.Logger.configure(Config.log_level(), Config.log_format())
  """
  fn configure(level_str : String, format_str : String) do
    Logger.set_level(parse_level(level_str))
    Logger.clear_appenders()
    let _ = if format_str == "json" do
      Logger.add_appender(Logger.appender_stdout(Logger.format_json))
    else if format_str == "logfmt" do
      Logger.add_appender(Logger.appender_stdout(Logger.format_logfmt))
    else
      Logger.add_appender(Logger.appender_stdout(Logger.format_text))
    end end
    ()
  end

  -- ── Conn helpers ──────────────────────────────────────────────────────────────

  fn info_conn(conn, msg : String, meta : List((String, String))) do
    Logger.log_with(Logger.Info, msg, with_rid(conn, meta))
  end

  fn warn_conn(conn, msg : String, meta : List((String, String))) do
    Logger.log_with(Logger.Warn, msg, with_rid(conn, meta))
  end

  fn error_conn(conn, msg : String, meta : List((String, String))) do
    Logger.log_with(Logger.Error, msg, with_rid(conn, meta))
  end

  -- ── Internals ─────────────────────────────────────────────────────────────────

  pfn with_rid(conn, meta) do
    match HttpServer.get_assign(conn, "request_id") do
    Some(rid) -> Cons(("request_id", rid), meta)
    None      -> meta
    end
  end

end
