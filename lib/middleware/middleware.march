-- Bastion.Middleware — plug-style middleware pipeline composition.
--
-- Middleware in Bastion is a plain function:  Conn -> Conn
--
-- A pipeline is an ordered list of such functions.  Each function receives
-- the conn returned by the previous one.  Processing stops early if any
-- plug marks the conn as halted (via HttpServer.halt or HttpServer.send_resp).

mod Middleware do

  doc """
  Execute a list of plugs in order, stopping when the conn is halted.

  Example:
    let conn = Middleware.pipeline([logger, auth, my_handler], conn)
  """
  fn pipeline(plugs : List(Conn -> Conn), conn : Conn) : Conn do
    HttpServer.run_pipeline(conn, plugs)
  end

  doc """
  Compose two plugs left-to-right into a single plug.

  Calls a(conn), then b on the result only if the conn is not halted.
  """
  fn compose(a : Conn -> Conn, b : Conn -> Conn) : Conn -> Conn do
    fn conn -> do
      let c = a(conn)
      match HttpServer.halted(c) do
      true  -> c
      false -> b(c)
      end
    end
  end

  -- ── Built-in middleware ───────────────────────────────────────────

  doc """
  Logging middleware.

  Logs the request method, path, and request_id on every request using
  Logger.info. Call this after request_id/1 in your pipeline so the
  request_id is available.

  Note: response status and timing are not logged here because they are
  not yet known when this middleware runs. For full request/response logging
  use the Logger.info_conn helper in your handler or after-send hook.
  """
  fn logger(conn : Conn) : Conn do
    let method_str = HttpServer.method_to_string(HttpServer.method(conn))
    let path_str   = HttpServer.path(conn)
    let rid        = match HttpServer.get_assign(conn, "request_id") do
      Some(id) -> id
      None     -> ""
      end
    let meta = if rid == "" do [("path", path_str)]
               else [("path", path_str), ("request_id", rid)]
               end
    Logger.log_with(Logger.Info, method_str ++ " " ++ path_str, meta)
    conn
  end

  doc """
  Request ID middleware.

  Reads the incoming x-request-id header if present; otherwise generates a
  fresh cryptographically random 16-byte hex ID.  Assigns the ID under the
  "request_id" key and echoes it back as an x-request-id response header so
  clients and proxies can correlate log entries.
  """
  fn request_id(conn : Conn) : Conn do
    let existing = HttpServer.get_req_header(conn, "x-request-id")
    let id = match existing do
      Some(v) -> v
      None    -> Crypto.random_hex(16)
      end
    conn
    |> HttpServer.assign("request_id", id)
    |> HttpServer.put_resp_header("x-request-id", id)
  end

  doc "Sets a default content-type response header of text/html if none has been set."
  fn default_content_type(conn : Conn) : Conn do
    HttpServer.put_resp_header(conn, "content-type", "text/html; charset=utf-8")
  end

  doc """
  CORS middleware builder.  Takes an explicit list of allowed origins and
  returns a plug that echoes the request's Origin header back if — and only
  if — it is on the allowlist.  Unlisted origins receive no
  Access-Control-Allow-Origin header, which browsers interpret as a block.

  There is deliberately no wildcard helper:  `*` with credentials-bearing
  requests is the classic CORS misconfiguration that leaks authenticated
  responses to any site.  If you truly need a public API with no cookies,
  pass a single-element list containing the literal origin, or write your
  own plug.

  Example:
    let cors = Middleware.cors(["https://app.example.com", "https://admin.example.com"])
  """
  fn cors(allowed_origins : List(String)) : Conn -> Conn do
    fn conn -> do
      let with_common = conn
        |> HttpServer.put_resp_header("access-control-allow-methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS")
        |> HttpServer.put_resp_header("access-control-allow-headers", "content-type, authorization")
        |> HttpServer.put_resp_header("vary", "Origin")
      match HttpServer.get_req_header(conn, "origin") do
      Some(origin) ->
        match List.any(allowed_origins, fn o -> o == origin) do
        true  -> HttpServer.put_resp_header(with_common, "access-control-allow-origin", origin)
        false -> with_common
        end
      None -> with_common
      end
    end
  end

  doc """
  Returns a plug that halts with 405 Method Not Allowed if the request method
  is not in the allowed list.

  Example:
    let only_get = Middleware.allow_methods([Get])
  """
  fn allow_methods(allowed : List(Atom)) : Conn -> Conn do
    fn conn -> do
      let m = HttpServer.method(conn)
      match List.any(allowed, fn a -> a == m) do
      true  -> conn
      false -> HttpServer.text(conn, 405, "Method Not Allowed")
      end
    end
  end

  actor IdCounter do
    state { n : Int }
    init  { n: 0 }
    on Call(ref, msg) do
      let _ = Actor.reply(ref, state.n)
      { state with n: state.n + 1 }
    end
  end

  doc "Spawn a sequential ID counter actor. Pass the returned handle to request_id_counter/1."
  fn start_id_counter() do
    spawn(IdCounter)
  end

  doc """
  Returns a plug that assigns a unique sequential request ID to each conn.

  Prefers an incoming x-request-id header if present; otherwise calls the
  IdCounter actor for a monotonically increasing integer ID.

  Spawn the counter once at startup with Middleware.start_id_counter/0:

    let counter = Middleware.start_id_counter()
    let pipe = Middleware.pipeline([Middleware.request_id_counter(counter), ...], conn)
  """
  fn request_id_counter(counter) : Conn -> Conn do
    fn conn -> do
      let existing = HttpServer.get_req_header(conn, "x-request-id")
      let id = match existing do
        Some(v) -> v
        None    -> next_counter_id(counter)
        end
      HttpServer.assign(conn, "request_id", id)
    end
  end

  pfn next_counter_id(counter) : String do
    match Actor.call(counter, 0, 1000) do
    Ok(n)  -> "req-" ++ int_to_string(n)
    Err(_) -> "req-unknown"
    end
  end

  -- ── Internal helpers ──────────────────────────────────────────────

end
