-- lib/telemetry.march — Bastion.Telemetry: structured event hooks.
--
-- A lightweight telemetry bus that lets the framework emit named events and
-- user code attach handlers to them.  The pattern mirrors :telemetry in the
-- Erlang/Elixir ecosystem, adapted to March's type system.
--
-- Events are hierarchical string lists such as:
--   ["bastion", "request", "start"]
--   ["bastion", "request", "stop"]
--   ["bastion", "depot", "query", "stop"]
--   ["bastion", "channel", "message", "stop"]
--
-- ── Usage ──────────────────────────────────────────────────────────────────────
--
--   -- Attach a handler at application startup:
--   Bastion.Telemetry.attach(
--     "my_logger",
--     [["bastion", "request", "stop"]],
--     fn event measurements metadata ->
--       Logger.info("request completed", [
--         ("path",     Conn.path(metadata.conn)),
--         ("status",   String.from_int(measurements.status)),
--         ("duration", String.from_int(measurements.duration_ms) ++ "ms")
--       ])
--     end
--   )
--
--   -- Emit an event from framework or application code:
--   Bastion.Telemetry.execute(
--     ["bastion", "request", "stop"],
--     { status: 200, duration_ms: 42 },
--     { conn: conn }
--   )
--
--   -- Detach when no longer needed:
--   Bastion.Telemetry.detach("my_logger")

mod Bastion.Telemetry do

  needs IO.Clock

  -- Vault table storing registered handlers
  let table_name = "_bastion_telemetry"

  -- ── Attach / detach ───────────────────────────────────────────────────────

  doc """
  Attach a handler function to one or more event names.

  handler_id    — unique string identifier for this handler (used to detach)
  event_names   — list of event name lists to subscribe to
  handler_fn    — fn(event_name, measurements, metadata) called on each event

  If handler_id is already attached, the old handler is replaced.

      Bastion.Telemetry.attach("my_metrics", [["bastion", "request", "stop"]], fn ev m d ->
        update_counter(m.status)
      end)
  """
  fn attach(handler_id : String, event_names : List(List(String)), handler_fn) do
    let fn_table   = Vault.new(table_name ++ "_fn")
    let subs_table = Vault.new(table_name ++ "_subs")
    Vault.set(fn_table, handler_id, handler_fn)
    Vault.set(subs_table, handler_id, event_names)
  end

  doc """
  Detach a previously attached handler.

      Bastion.Telemetry.detach("my_metrics")
  """
  fn detach(handler_id : String) do
    let fn_table   = Vault.new(table_name ++ "_fn")
    let subs_table = Vault.new(table_name ++ "_subs")
    Vault.drop(fn_table, handler_id)
    Vault.drop(subs_table, handler_id)
  end

  doc "Return the list of all attached handler IDs."
  fn attached_handlers() : List(String) do
    let fn_table = Vault.new(table_name ++ "_fn")
    Vault.keys(fn_table)
  end

  -- ── Emit ──────────────────────────────────────────────────────────────────

  doc """
  Emit a telemetry event.

  Iterates all attached handlers.  Handlers whose subscription list includes
  this event name (or a prefix of it) are called inline.  Handler errors
  are isolated: one failing handler does not prevent others from running.

  event_name   — list of string segments, e.g. ["bastion", "request", "stop"]
  measurements — record with numeric measurements (any shape)
  metadata     — record with contextual data (any shape)

      Bastion.Telemetry.execute(["bastion", "request", "stop"],
        { status: 200, duration_ms: 42 },
        { conn: conn })
  """
  fn execute(event_name : List(String), measurements, metadata) do
    let fn_table   = Vault.new(table_name ++ "_fn")
    let subs_table = Vault.new(table_name ++ "_subs")
    let ids = Vault.keys(fn_table)
    List.each(ids, fn handler_id ->
      match Vault.get(fn_table, handler_id) do
      None -> ()
      Some(handler_fn) ->
        let subscriptions = Vault.get_or(subs_table, handler_id, [])
        let subscribed = List.any(subscriptions, fn sub_event ->
          events_match(sub_event, event_name)
        )
        if subscribed do handler_fn(event_name, measurements, metadata) else () end
      end
    )
  end

  -- ── Span helpers ──────────────────────────────────────────────────────────

  doc """
  Execute a function while emitting start and stop telemetry events.

  Emits `event_prefix ++ ["start"]` before calling fn, and
  `event_prefix ++ ["stop"]` after.  The stop event includes a
  `duration_ms` measurement.

      Bastion.Telemetry.span(["bastion", "depot", "query"], metadata, fn () ->
        Depot.exec(query)
      end)
  """
  fn span(event_prefix : List(String), metadata, fn_) do
    let start_event = List.append(event_prefix, ["start"])
    let stop_event  = List.append(event_prefix, ["stop"])
    execute(start_event, { duration_ms: 0 }, metadata)
    let start_ms = float_to_int(unix_time(()) *. 1000.0)
    let result   = fn_()
    let elapsed  = float_to_int(unix_time(()) *. 1000.0) - start_ms
    execute(stop_event, { duration_ms: elapsed }, metadata)
    result
  end

  -- ── Framework event helpers ───────────────────────────────────────────────

  doc """
  Emit the standard request start event.  Call at the beginning of your pipeline.

      Bastion.Telemetry.request_start(conn)
  """
  fn request_start(conn) do
    execute(
      ["bastion", "request", "start"],
      { timestamp_ms: float_to_int(unix_time(()) *. 1000.0) },
      { conn: conn }
    )
  end

  doc """
  Emit the standard request stop event.  Call after the handler returns.

  duration_ms — wall clock time from request_start to now
  """
  fn request_stop(conn, duration_ms : Int) do
    execute(
      ["bastion", "request", "stop"],
      { duration_ms: duration_ms, status: HttpServer.status(conn) },
      { conn: conn }
    )
  end

  -- ── Event matching ────────────────────────────────────────────────────────
  --
  -- A handler subscribed to ["bastion", "request"] also receives
  -- ["bastion", "request", "start"] and ["bastion", "request", "stop"].
  -- An exact match ("bastion", "request", "stop") only matches that event.

  pfn events_match(subscribed : List(String), event : List(String)) : Bool do
    is_prefix_of(subscribed, event)
  end

  pfn is_prefix_of(prefix : List(String), target : List(String)) : Bool do
    match prefix do
    []              -> true
    Cons(p, rest_p) ->
      match target do
      []              -> false
      Cons(t, rest_t) ->
        if p == t do is_prefix_of(rest_p, rest_t) else false end
      end
    end
  end

end
