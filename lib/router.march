-- Bastion.Router — declarative, pattern-matched HTTP routing.
--
-- Routes are registered with method-specific helpers (get, post, put, patch,
-- delete) and dispatched via Router.to_plug/1, which converts the Router into
-- a plain HttpServer plug (Conn -> Conn).
--
-- Path parameter syntax: a segment starting with ":" is a wildcard that
-- matches any single path segment and stores the captured value in conn
-- assigns under the segment name (without the ":").
--
-- Handlers can return either Conn directly (plug-style) or
-- Controller.ActionResult (controller-style). For ActionResult handlers,
-- the router applies the fallback on Error automatically.
--
-- Use Router.get/post/... for plain Conn -> Conn handlers (plugs),
-- and Router.action for handlers that return Controller.ActionResult.
-- The router's fallback handles ActionResult errors and unmatched routes.
--
-- Example:
--
--   let router =
--     Router.new()
--     |> Router.fallback(fn conn -> fn result ->
--       match result do
--       Controller.Ok(c) -> c
--       Controller.Error(status, msg) ->
--         HttpServer.json(conn, status, "{\"error\":\"" ++ msg ++ "\"}")
--       end
--     )
--     |> Router.action(Get, "/",          fn conn -> PageController.home(conn))
--     |> Router.action(Get, "/users/:id", fn conn -> UserController.show(conn))
--     |> Router.get("/health",            fn conn -> health_check(conn))
--
-- Inside show, retrieve :id with HttpServer.get_assign(conn, "id").

mod Router do

  import HttpServer
  import Controller
  import ErrorView

  -- A single registered route.
  type Route = Route(Atom, List(String), Conn -> Conn)

  -- Fallback handler: receives conn + ActionResult, returns Conn.
  -- Default renders ErrorView HTML pages.
  type Fallback = Fallback(Conn -> ActionResult -> Conn)

  -- A Router is an ordered list of routes plus a fallback handler.
  type Router = Router(List(Route), Fallback)

  -- Default fallback: render ErrorView HTML error pages.
  pfn default_fallback() : Fallback do
    Fallback(fn conn -> fn result ->
      match result do
      ActionOk(c) -> c
      ActionError(status, message) ->
        HttpServer.html(conn, status, ErrorView.render(status, message))
      end
    )
  end

  doc "Create a new empty router with the default HTML error fallback."
  fn new() : Router do
    Router(Nil, default_fallback())
  end

  doc """
  Set the fallback handler for this router.

  The fallback is called when a controller action returns Controller.Error,
  and also when no route matches (as a 404 error).

  Example:
    -- For an API router that returns JSON errors:
    Router.new()
    |> Router.fallback(fn conn -> fn result ->
      match result do
      Controller.ActionOk(c) -> c
      Controller.ActionError(status, msg) ->
        HttpServer.json(conn, status, "{\"error\":\"" ++ msg ++ "\"}")
      end
    )
  """
  fn fallback(router : Router, handler : Conn -> ActionResult -> Conn) : Router do
    match router do
    Router(routes, _) -> Router(routes, Fallback(handler))
    end
  end

  -- ── Route registration ────────────────────────────────────────────

  doc """
  Register a GET handler for the given path pattern.

  Segments starting with ":" are captured as path parameters.

  Example:
    Router.get(router, "/users/:id", show_user)
  """
  fn get(router : Router, pattern : String, handler : Conn -> Conn) : Router do
    add_route(router, :get, pattern, handler)
  end

  doc "Register a POST handler for the given path pattern."
  fn post(router : Router, pattern : String, handler : Conn -> Conn) : Router do
    add_route(router, :post, pattern, handler)
  end

  doc "Register a PUT handler for the given path pattern."
  fn put(router : Router, pattern : String, handler : Conn -> Conn) : Router do
    add_route(router, :put, pattern, handler)
  end

  doc "Register a PATCH handler for the given path pattern."
  fn patch(router : Router, pattern : String, handler : Conn -> Conn) : Router do
    add_route(router, :patch, pattern, handler)
  end

  doc "Register a DELETE handler for the given path pattern."
  fn delete(router : Router, pattern : String, handler : Conn -> Conn) : Router do
    add_route(router, :delete, pattern, handler)
  end

  doc """
  Register a route whose handler returns Controller.ActionResult.

  On Ok(conn), the conn is returned as-is.  On Error(status, message),
  the router's fallback handler renders the error response.  This is the
  recommended way to wire controller actions — the fallback is applied
  once at the router level rather than repeated in every handler.

  Example:
    Router.action(router, Get, "/users/:id", fn conn -> UserController.show(conn))
  """
  fn action(router : Router, method : Atom, pattern : String, handler : Conn -> ActionResult) : Router do
    match router do
    Router(routes, fb) -> do
      let segs = split_path(pattern)
      let wrapped = wrap_action(fb, handler)
      Router(List.append(routes, Cons(Route(method, segs, wrapped), Nil)), fb)
    end
    end
  end

  doc """
  Mount a sub-router under a path prefix.

  All routes in sub_router have the prefix prepended to their patterns.

  Example:
    Router.scope(router, "/api", api_sub_router)
  """
  fn scope(router : Router, prefix : String, sub_router : Router) : Router do
    let prefix_segs = split_path(prefix)
    match sub_router do
    Router(sub_routes, _) -> do
      let prefixed = prefix_routes(sub_routes, prefix_segs)
      match router do
      Router(existing, fb) ->
        Router(List.append(existing, prefixed), fb)
      end
    end
    end
  end

  -- ── Dispatch ──────────────────────────────────────────────────────

  doc """
  Dispatch an incoming conn to the first matching route.

  Extracts path parameters and stores them in conn assigns before calling
  the handler. If no route matches, the router's fallback is invoked with
  a 404 error — so the fallback acts as the last arm of the match.
  """
  fn dispatch(router : Router, conn : Conn) : Conn do
    match router do
    Router(routes, fb) -> do
      let meth      = HttpServer.method(conn)
      let path_segs = HttpServer.path_info(conn)
      find_and_call(routes, meth, path_segs, conn, fb)
    end
    end
  end

  doc """
  Convert a Router into a plug function (Conn -> Conn).
  Pass the result to HttpServer.plug/2 or Bastion.start/2.
  """
  fn to_plug(router : Router) : Conn -> Conn do
    fn conn -> dispatch(router, conn)
  end

  -- ── Internal helpers ──────────────────────────────────────────────

  pfn add_route(router : Router, method : Atom, pattern : String, handler : Conn -> Conn) : Router do
    let segs = split_path(pattern)
    match router do
    Router(routes, fb) ->
      Router(List.append(routes, Cons(Route(method, segs, handler), Nil)), fb)
    end
  end

  -- Wrap an ActionResult-returning handler by applying the fallback.
  pfn wrap_action(fb : Fallback, handler : Conn -> ActionResult) : Conn -> Conn do
    match fb do
    Fallback(apply_fb) ->
      fn conn -> do
        let f = apply_fb(conn)
        f(handler(conn))
      end
    end
  end

  pfn split_path(path : String) : List(String) do
    let parts = String.split(path, "/")
    List.filter(parts, fn s -> !String.is_empty(s))
  end

  pfn prefix_routes(routes : List(Route), prefix : List(String)) : List(Route) do
    prefix_routes_loop(routes, prefix, Nil)
  end

  pfn prefix_routes_loop(routes : List(Route), prefix : List(String), acc : List(Route)) : List(Route) do
    match routes do
    Nil -> List.reverse(acc)
    Cons(Route(m, segs, h), rest) ->
      prefix_routes_loop(rest, prefix, Cons(Route(m, List.append(prefix, segs), h), acc))
    end
  end

  -- Walk the route list and dispatch to the first match.
  -- On no match, apply the fallback with a 404 error — the fallback is
  -- the last arm of the match.
  pfn find_and_call(routes : List(Route), method : Atom, path_segs : List(String), conn : Conn, fb : Fallback) : Conn do
    match routes do
    Nil ->
      apply_fallback(fb, conn, ActionError(404, "Not Found"))
    Cons(Route(m, pattern, handler), rest) ->
      try_route(m, pattern, handler, rest, method, path_segs, conn, fb)
    end
  end

  -- Apply the fallback handler to an ActionResult.
  pfn apply_fallback(fb : Fallback, conn : Conn, result : ActionResult) : Conn do
    match fb do
    Fallback(handler) -> do
      let f = handler(conn)
      f(result)
    end
    end
  end

  -- Check if this route's method matches, then try its path pattern.
  pfn try_route(m : Atom, pattern : List(String), handler : Conn -> Conn, rest : List(Route), method : Atom, path_segs : List(String), conn : Conn, fb : Fallback) : Conn do
    match m == method do
    true ->
      dispatch_result(match_path(pattern, path_segs), handler, rest, method, path_segs, conn, fb)
    false ->
      find_and_call(rest, method, path_segs, conn, fb)
    end
  end

  -- Handle the result of path matching: bind params and call handler, or try next route.
  pfn dispatch_result(result : Option(List((String, String))), handler : Conn -> Conn, rest : List(Route), method : Atom, path_segs : List(String), conn : Conn, fb : Fallback) : Conn do
    match result do
    Some(params) -> do
      let bound = bind_params(conn, params)
      handler(bound)
    end
    None ->
      find_and_call(rest, method, path_segs, conn, fb)
    end
  end

  -- Try to match a path against a pattern, collecting param bindings.
  pfn match_path(pattern : List(String), path : List(String)) : Option(List((String, String))) do
    match_path_acc(pattern, path, Nil)
  end

  pfn match_path_acc(pattern : List(String), path : List(String), acc : List((String, String))) : Option(List((String, String))) do
    match (pattern, path) do
    (Nil, Nil) ->
      Some(List.reverse(acc))
    (Cons(seg, prest), Cons(part, rest)) ->
      match_segment(seg, part, prest, rest, acc)
    (_, _) ->
      None
    end
  end

  -- Match a single path segment: wildcard param or literal equality.
  pfn match_segment(seg : String, part : String, prest : List(String), rest : List(String), acc : List((String, String))) : Option(List((String, String))) do
    match String.starts_with(seg, ":") do
    true -> do
      let name = String.slice_bytes(seg, 1, String.byte_size(seg) - 1)
      match_path_acc(prest, rest, Cons((name, part), acc))
    end
    false ->
      match seg == part do
      true  -> match_path_acc(prest, rest, acc)
      false -> None
      end
    end
  end

  pfn bind_params(conn : Conn, params : List((String, String))) : Conn do
    match params do
    Nil -> conn
    Cons((k, v), rest) ->
      bind_params(HttpServer.assign(conn, k, v), rest)
    end
  end

end
