-- lib/pool.march — Bastion stub for Pool (actor-based DB connection pool)
--
-- This stub satisfies the compile-time dependency of depot_middleware.march
-- and application modules during `forge check` and `forge test`.
-- The real Pool implementation is provided by the `depot` library dependency
-- and is used at runtime.
--
-- Do not use this module directly — use Depot.Middleware or your Repo module.

mod Pool do

  -- Connection configuration (mirrors depot/lib/connection.march ConnConfig)
  type ConnConfig = {
    host     : String,
    port     : Int,
    user     : String,
    database : String,
    password : Option(String)
  }

  -- Opaque pool handle
  type Pool = Pool(Int)

  -- Opaque DB connection handle
  type DbConn = DbConn(Int)

  -- Pool configuration (mirrors depot/lib/pool.march PoolConfig)
  type PoolConfig = {
    min_size           : Int,
    max_size           : Int,
    idle_timeout_ms    : Int,
    connect_timeout_ms : Int,
    conn_config        : ConnConfig
  }

  doc "Start a connection pool from a PoolConfig. Returns the pool handle."
  fn start(_config : PoolConfig) : Pool do
    todo("Pool.start: not available in test stub — use the depot library at runtime")
  end

  doc "Return a default PoolConfig (5 min / 20 max) for a given connection config."
  fn default_pool_config(conn_cfg : ConnConfig) : PoolConfig do
    { min_size = 5, max_size = 20, idle_timeout_ms = 300000,
      connect_timeout_ms = 5000, conn_config = conn_cfg }
  end

  doc "Borrow a connection, run f(conn), return it automatically."
  fn with_conn(_pool : Pool, _f) do
    todo("Pool.with_conn: not available in test stub — use the depot library at runtime")
  end

  doc "Borrow a connection for a transaction (pinned to one connection)."
  fn with_conn_pinned(_pool : Pool, _f) do
    todo("Pool.with_conn_pinned: not available in test stub — use the depot library at runtime")
  end

  doc "Check out a connection from the pool."
  fn checkout(_pool : Pool) : Result(DbConn, String) do
    todo("Pool.checkout: not available in test stub")
  end

  doc "Return a connection to the pool."
  fn checkin(_pool : Pool, _db_conn : DbConn) do
    todo("Pool.checkin: not available in test stub")
  end

end
