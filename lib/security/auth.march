-- lib/auth_middleware.march — Session-based authentication for Bastion.
--
-- Provides the four core auth operations on typed conns:
--
--   load_current_user   — soft check, never halts; reads user from session
--   require_auth        — hard gate; redirects to /login when unauthenticated
--   log_in              — session fixation rotation + set user ID
--   log_out             — clear session (+ optional remember-me cookie cleanup)
--
-- All functions operate on the conn-level session managed by Session.march.
-- No database access is needed by the framework itself — the application
-- injects a `loader` function (and optionally a `remember_verifier`) so that
-- Bastion stays decoupled from the ORM.
--
-- The remember-me token is an opaque string generated by the application
-- (e.g. via `Accounts.create_remember_token`).  The framework stores it in
-- a long-lived `_remember_me` cookie and delegates verification back to the
-- app.  The actual token creation and storage in `user_tokens` is wired up
-- by `forge gen.auth session`.
--
-- Typical pipeline usage:
--
--   conn
--   |> Session.load(secret_key_base)
--   |> Auth.load_current_user(fn conn id -> MyApp.Accounts.get_user(conn, id) end)
--   |> MyApp.Router.route()
--
-- In a handler requiring authentication:
--
--   with Ok(tc) <- Auth.require_auth(tc) do
--     render(tc, "dashboard.html", assigns)
--   else
--     Error(conn) -> conn
--   end
--
-- Login:
--
--   conn |> Auth.log_in(user.id)
--   conn |> Auth.log_in(user.id, remember_token: token)
--
-- Logout:
--
--   conn |> Auth.log_out()

mod Auth do

  import Conn
  alias Bastion.Session as Session

  -- ── Session keys / cookie names ───────────────────────────────────────────

  let user_id_session_key  = "current_user_id"
  let current_user_assign  = "current_user"
  let return_to_session_key = "return_to"
  let remember_me_cookie   = "_remember_me"

  -- ── load_current_user ─────────────────────────────────────────────────────

  doc """
  Load the current user from the session into conn assigns.

  Reads `current_user_id` from the session, converts it to an Int, and
  calls `loader(conn, user_id)`.  The result is stored in `current_user`
  assigns as `Some(user)` on success or `None` if:
    - no user ID is in the session
    - the ID cannot be parsed as an Int
    - the loader returns `Error(_)` (e.g. user was deleted)

  This middleware is **soft** — it never halts.  Use `require_auth/1` inside
  route handlers to enforce authentication.

  `loader` receives the unwrapped conn so it can access `TypedMiddleware.get_db`
  for database-backed lookups.

      conn |> Auth.load_current_user(fn conn id ->
        MyApp.Accounts.get_user(conn, id)
      end)
  """
  fn load_current_user(conn, loader) do
    match Session.get(conn, user_id_session_key) do
    None -> conn
    Some(id_str) ->
      match string_to_int(id_str) do
      None ->
        -- Malformed session value: the session is HMAC-signed, so a
        -- non-integer user ID means an application bug or a signing-key
        -- mix-up — surface it instead of silently treating the request
        -- as anonymous.
        let _ = Logger.log_with(Logger.Warn,
          "Auth.load_current_user: session " ++ user_id_session_key ++
          " is not an integer; treating request as unauthenticated",
          [("value", id_str)])
        conn
      Some(id) ->
        match loader(conn, id) do
        Ok(u)  -> HttpServer.assign(conn, current_user_assign, u)
        Err(_) -> conn   -- user deleted or invalid; leave assign absent
        end
      end
    end
  end

  doc """
  Load the current user, falling back to a remember-me cookie when the
  session is empty.

  Identical to `load_current_user/2` but also checks the `_remember_me`
  cookie when there is no session user ID.  If the cookie is present,
  calls `remember_verifier(conn, token)` which should return
  `Ok(user_id_int)` for a valid token or `Error(_)` for an expired/invalid
  one.  On success a fresh session is written (clear + set user ID — the
  same rotation `log_in` performs), so subsequent requests authenticate via
  the short-lived session cookie instead of re-verifying the long-lived
  remember token on every request.

      conn |> Auth.load_current_user_with_remember(
        fn conn id -> MyApp.Accounts.get_user(conn, id) end,
        fn conn token -> MyApp.Accounts.verify_remember_token(conn, token) end
      )
  """
  fn load_current_user_with_remember(conn, loader, remember_verifier) do
    let has_session_user = match Session.get(conn, user_id_session_key) do
      Some(_) -> true
      None    -> false
      end
    if has_session_user do
      load_current_user(conn, loader)
    else
      -- Try the remember-me cookie
      match Conn.get_req_cookie(conn, remember_me_cookie) do
      None -> conn
      Some(token) ->
        match remember_verifier(conn, token) do
        Err(_) ->
          -- Expired or invalid token — clear the stale cookie
          Conn.delete_resp_cookie(conn, remember_me_cookie)
        Ok(user_id) ->
          -- Re-establish a FRESH session from the remember-me token.
          -- Clearing first mirrors log_in's fixation defense: any data an
          -- attacker planted in the (user-less) session is discarded, and
          -- the cleared+rewritten session is guaranteed dirty so a new
          -- session cookie is committed with the response.
          let conn2 =
            Session.clear(conn)
            |> Session.put(user_id_session_key, int_to_string(user_id))
          load_current_user(conn2, loader)
        end
      end
    end
  end

  -- ── get_current_user ─────────────────────────────────────────────────────

  doc """
  Get the current user from conn assigns.

  Returns `Some(user)` if `load_current_user` was called and found a user,
  or `None` if not authenticated.  Callable at any point after the pipeline.

      match Auth.current_user(conn) do
      Some(u) -> "Hello, " ++ u.name
      None    -> "Guest"
      end
  """
  fn current_user(conn) do
    HttpServer.get_assign(conn, current_user_assign)
  end

  -- ── require_auth ──────────────────────────────────────────────────────────

  doc """
  Require an authenticated user.  Call inside route handlers.

  Returns `Ok(conn)` when `current_user` is `Some(user)`.
  Returns `Error(conn)` with a halted 302 redirect to `/login` when not.

  Before redirecting, stores the current request path in the session under
  `return_to` so the login handler can redirect back after authentication.

      with Ok(conn) <- Auth.require_auth(conn) do
        render(conn, "dashboard.html", assigns)
      else
        Error(conn) -> conn
      end
  """
  fn require_auth(conn) do
    match HttpServer.get_assign(conn, current_user_assign) do
    Some(_) -> Ok(conn)
    None    ->
      let return_path = HttpServer.path(conn)
      let halted =
        Session.put(conn, return_to_session_key, return_path)
        |> HttpServer.put_resp_header("location", "/login")
        |> HttpServer.send_resp(302, "")
        |> HttpServer.halt()
      Err(halted)
    end
  end

  doc """
  Sugar for the common `require_auth` pattern.

  Calls `handler` with the conn if authenticated; otherwise returns the
  halted redirect conn directly.

      Auth.authenticated(conn, fn conn ->
        render(conn, "dashboard.html", assigns)
      end)
  """
  fn authenticated(conn, handler) do
    match require_auth(conn) do
    Ok(authed)   -> handler(authed)
    Err(halted) -> halted
    end
  end

  -- ── log_in ────────────────────────────────────────────────────────────────

  doc """
  Log in a user by setting their ID in the session.

  Clears the session first (session fixation protection) then sets
  `current_user_id` to `user_id`.  If `remember_token` is `Some(token)`,
  also writes a persistent `_remember_me` cookie that lasts 60 days.

  The `remember_token` should be generated and persisted to `user_tokens`
  by the application before calling `log_in`:

      let token = Accounts.create_remember_token(conn, user.id)
      conn |> Auth.log_in(user.id, Some(token))

  Pass `None` (or omit) for browser-session-only login:

      conn |> Auth.log_in(user.id, None)
  """
  fn log_in(conn, user_id, remember_token) do
    let conn2 =
      Session.clear(conn)
      |> Session.put(user_id_session_key, int_to_string(user_id))
    match remember_token do
    None -> conn2
    Some(token) ->
      let cookie_opts = [
        ("Max-Age", int_to_string(60 * 60 * 24 * 60)),   -- 60 days
        ("Path", "/"),
        ("HttpOnly", ""),
        ("Secure", ""),
        ("SameSite", "Lax")
      ]
      Conn.put_resp_cookie(conn2, remember_me_cookie, token, cookie_opts)
    end
  end

  -- ── log_out ───────────────────────────────────────────────────────────────

  doc """
  Log out the current user by clearing the session.

  Always clears the `_remember_me` cookie regardless of whether it was set.
  If `token_deleter` is `Some(fn)`, calls `token_deleter(conn, token)` to
  delete the token from the database before clearing the cookie.

  Typical usage without remember-me:

      conn |> Auth.log_out(None)

  With remember-me cleanup (generated by `forge gen.auth session`):

      conn |> Auth.log_out(Some(fn conn token ->
        Accounts.delete_remember_token(conn, token)
      end))
  """
  fn log_out(conn, token_deleter) do
    let conn2 = match token_deleter do
      None -> conn
      Some(deleter) ->
        match Conn.get_req_cookie(conn, remember_me_cookie) do
        None        -> conn
        Some(token) -> deleter(conn, token)
        end
      end
    Session.clear(conn2)
    |> Conn.delete_resp_cookie(remember_me_cookie)
  end

  -- ── Return-to redirect ────────────────────────────────────────────────────

  doc """
  Redirect to the stored `return_to` path after a successful login, or fall
  back to `default_path` if no return path was stored.

  Call this at the end of a successful login handler:

      conn
      |> Auth.log_in(user.id)
      |> Auth.redirect_after_login("/dashboard")
  """
  fn redirect_after_login(conn, default_path) do
    let path = match Session.get(conn, return_to_session_key) do
      Some(p) -> p
      None    -> default_path
      end
    Session.delete(conn, return_to_session_key)
    |> HttpServer.put_resp_header("location", path)
    |> HttpServer.send_resp(302, "")
  end

end
