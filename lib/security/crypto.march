-- lib/crypto.march — Cryptographic primitives for Bastion.
--
-- Calls stdlib builtins (stdlib_random_bytes, stdlib_sha256, etc.) directly
-- rather than aliasing the stdlib Crypto module.  This avoids the fragile
-- `alias Crypto as StdCrypto` dance that caused a Heisenbug at runtime.
--
-- Public API summary:
--
--   Random
--     random_bytes(n)              → Bytes   (CSPRNG, suitable for keys/nonces)
--     random_hex(n)                → String  (2n-char lowercase hex)
--     generate_token(n)            → String  (URL-safe base64, no padding)
--
--   Hashing
--     sha256(data)                 → String  (lowercase hex, data: String | Bytes)
--
--   HMAC
--     hmac_sha256(key, data)       → String  (lowercase hex, key/data: String | Bytes)
--
--   Key derivation
--     hkdf_sha256(ikm, salt, info, len) → Bytes (HKDF-SHA256, RFC 5869)
--     derive_key(secret, context)  → String  (32-byte HKDF-SHA256 derivation, hex)
--
--   Password hashing (PBKDF2-SHA256, 600 000 iterations, 16-byte random salt)
--     hash_password(plain)         → String  ("pbkdf2:sha256:…" storable format)
--     verify_password(plain, hash) → Bool
--
--   Comparison
--     secure_compare(a, b)         → Bool    (constant-time equality)
--
--   Base64
--     base64_encode(data)          → String  (standard alphabet + padding)
--     base64_decode(s)             → Result(Bytes, String)
--     base64_url_encode(data)      → String  (URL-safe, no padding)
--     base64_url_decode(s)         → Result(Bytes, String)
--
--   Utilities
--     bytes_to_string(b)           → String  (bytes → String)

mod Crypto do

  needs IO.Random

  import Hkdf

  -- ── Private helpers ───────────────────────────────────────────────────────

  pfn rev_list(xs) do
    fn go(lst, acc) do
      match lst do
      Nil -> acc
      Cons(h, t) -> go(t, Cons(h, acc))
      end
    end
    go(xs, Nil)
  end

  pfn hex_nibble(n) do
    if n < 10 do int_to_string(n)
    else char_from_int(87 + n)
    end
  end

  pfn byte_to_hex(n) do
    hex_nibble(n / 16) ++ hex_nibble(n % 16)
  end

  pfn bytes_to_hex(b) do
    match b do
    Bytes(xs) ->
      fn go(bs, acc) do
        match bs do
        Nil -> string_join(rev_list(acc), "")
        Cons(n, rest) -> go(rest, Cons(byte_to_hex(n), acc))
        end
      end
      go(xs, Nil)
    end
  end

  pfn hex_char_val(c) do
    let code = char_to_int(c)
    if code >= 48 && code <= 57 do code - 48
    else if code >= 97 && code <= 102 do code - 87
    else if code >= 65 && code <= 70 do code - 55
    else -1 end end end
  end

  pfn hex_str_to_bytes(s) do
    let chars = string_chars(s)
    fn go(cs, acc) do
      match cs do
      Nil -> Some(rev_list(acc))
      Cons(hi, Cons(lo, rest)) ->
        let h = hex_char_val(hi)
        let l = hex_char_val(lo)
        if h < 0 || l < 0 do None
        else go(rest, Cons(h * 16 + l, acc)) end
      _ -> None
      end
    end
    go(chars, Nil)
  end

  pfn to_url_safe_b64(s) do
    let s1 = String.replace_all(s, "+", "-")
    let s2 = String.replace_all(s1, "/", "_")
    fn strip_pad(t) do
      let len = string_byte_length(t)
      if len > 0 && string_slice(t, len - 1, 1) == "=" do
        strip_pad(string_slice(t, 0, len - 1))
      else t end
    end
    strip_pad(s2)
  end

  pfn from_url_safe_b64(s) do
    let s1 = String.replace_all(s, "-", "+")
    let s2 = String.replace_all(s1, "_", "/")
    let len = string_byte_length(s2)
    let rem = len % 4
    if rem == 0 do s2
    else if rem == 2 do s2 ++ "=="
    else if rem == 3 do s2 ++ "="
    else s2 end end end
  end

  let pw_iterations = 600000
  let pw_dklen = 32

  -- ── Random ────────────────────────────────────────────────────────────────

  doc """
  Generate `n` cryptographically secure random bytes from the OS CSPRNG.

      Crypto.random_bytes(16)  -- Bytes with 16 random bytes
  """
  fn random_bytes(n : Int) : Bytes do
    stdlib_random_bytes(n)
  end

  doc """
  Generate `n` random bytes and return them as a lowercase hex string (2n chars).

      Crypto.random_hex(16)  -- 32-char lowercase hex string
  """
  fn random_hex(n : Int) : String do
    bytes_to_hex(stdlib_random_bytes(n))
  end

  doc """
  Generate a URL-safe, base64-encoded random token of `n` bytes entropy.
  No padding characters; uses `-`/`_` instead of `+`/`/`.

      Crypto.generate_token(32)  -- e.g. "dGhpcyBpcyBhIHRlc3Q"
  """
  fn generate_token(n : Int) : String do
    to_url_safe_b64(stdlib_base64_encode(bytes_to_string(stdlib_random_bytes(n))))
  end

  -- ── Hashing ───────────────────────────────────────────────────────────────

  doc """
  Compute the SHA-256 hash of `data`, returning a lowercase hex string.

      Crypto.sha256("hello")
      -- "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
  """
  fn sha256(data : String) : String do
    stdlib_sha256(data)
  end

  -- ── HMAC ─────────────────────────────────────────────────────────────────

  doc """
  Compute HMAC-SHA256 of `data` under `key`, returning a lowercase hex string.

      Crypto.hmac_sha256("secret", "message")
  """
  fn hmac_sha256(key : String, data : String) : String do
    -- Use stdlib_hmac_sha256 to avoid shadowing the same-named builtin.
    match stdlib_hmac_sha256(key, data) do
    Ok(b)  -> bytes_to_hex(b)
    Err(_) -> ""
    end
  end

  -- ── Key derivation ────────────────────────────────────────────────────────

  -- Versioned extract salt for derive_key.  Bump the version suffix if the
  -- derivation scheme ever changes so old and new keys can never collide.
  let hkdf_salt = "bastion.hkdf.v1"

  doc """
  HKDF-SHA256 (RFC 5869): derive `len` bytes of key material from input
  keying material `ikm`, a `salt`, and a context `info` string.

  Thin re-export of `Hkdf.hkdf_sha256` (the implementation lives in its own
  module because Crypto's hex-string `hmac_sha256` shadows the Bytes-domain
  builtin HKDF needs).  `len` must be at most 8160 (255 blocks x 32 bytes).

      let okm = Crypto.hkdf_sha256(secret, "my-salt", "encryption", 32)
  """
  fn hkdf_sha256(ikm : String, salt : String, info : String, len : Int) : Bytes do
    Hkdf.hkdf_sha256(ikm, salt, info, len)
  end

  doc """
  Derive a 32-byte key from `secret` and a `context` label, returned as a
  64-char lowercase hex string.

  Uses HKDF-SHA256 (extract-then-expand, RFC 5869) with the versioned salt
  "bastion.hkdf.v1" and `context` as the expand info, so keys derived for
  different contexts are cryptographically independent — recovering one
  derived key reveals nothing about the secret or any sibling key.

      let k = Crypto.derive_key(secret_key_base, "session_signing")
  """
  fn derive_key(secret : String, context : String) : String do
    bytes_to_hex(hkdf_sha256(secret, hkdf_salt, context, 32))
  end

  -- ── Password hashing ──────────────────────────────────────────────────────

  doc """
  Hash a plaintext password using PBKDF2-SHA256 with a random 16-byte salt
  and 600 000 iterations (OWASP 2023 recommendation).

      let h = Crypto.hash_password("my-secret-pass")
      -- "pbkdf2:sha256:600000:<salt_hex>:<hash_hex>"
  """
  fn hash_password(plain : String) : String do
    let salt_bytes = stdlib_random_bytes(16)
    let salt_hex = bytes_to_hex(salt_bytes)
    match pbkdf2_sha256(plain, salt_bytes, pw_iterations, pw_dklen) do
    Ok(hash_bytes) ->
      let hash_hex = bytes_to_hex(hash_bytes)
      "pbkdf2:sha256:" ++ int_to_string(pw_iterations) ++ ":" ++ salt_hex ++ ":" ++ hash_hex
    Err(_) -> ""
    end
  end

  doc """
  Verify `plain` against a stored hash produced by `hash_password/1`.

      Crypto.verify_password("correct-horse-battery-staple", stored_hash)
  """
  fn verify_password(plain : String, stored : String) : Bool do
    let parts = string_split(stored, ":")
    match parts do
    Cons("pbkdf2", Cons("sha256", Cons(iter_str, Cons(salt_hex, Cons(hash_hex, Nil))))) ->
      match string_to_int(iter_str) do
      None -> false
      Some(iters) ->
        match hex_str_to_bytes(salt_hex) do
        None -> false
        Some(byte_list) ->
          let salt_bytes = Bytes(byte_list)
          match pbkdf2_sha256(plain, salt_bytes, iters, pw_dklen) do
          Ok(new_bytes) ->
            let new_hex = bytes_to_hex(new_bytes)
            secure_compare(new_hex, hash_hex)
          Err(_) -> false
          end
        end
      end
    _ -> false
    end
  end

  -- ── Constant-time comparison ──────────────────────────────────────────────

  doc """
  Compare two strings for equality in constant time (proportional to the
  longer string length).  Prevents timing attacks on secret comparisons.

      Crypto.secure_compare(request_token, stored_token)
  """
  fn secure_compare(a : String, b : String) : Bool do
    let la = string_byte_length(a)
    let lb = string_byte_length(b)
    let a_chars = string_chars(a)
    let b_chars = string_chars(b)
    fn go(acs, bcs, diff) do
      match (acs, bcs) do
      (Nil, Nil) -> diff
      (Cons(x, xr), Cons(y, yr)) ->
        let d = if x == y do 0 else 1 end
        go(xr, yr, diff + d)
      (Cons(_, xr), Nil) -> go(xr, Nil, diff + 1)
      (Nil, Cons(_, yr)) -> go(Nil, yr, diff + 1)
      end
    end
    let total = go(a_chars, b_chars, 0)
    total == 0 && la == lb
  end

  -- ── Base64 ────────────────────────────────────────────────────────────────

  doc "Base64-encode `data` using the standard alphabet (padded with `=`)."
  fn base64_encode(data : String) : String do
    stdlib_base64_encode(data)
  end

  doc "Decode a standard Base64 string to bytes."
  fn base64_decode(s : String) : Result(Bytes, String) do
    stdlib_base64_decode(s)
  end

  doc "Base64-encode `data` using the URL-safe alphabet (no padding, `-`/`_`)."
  fn base64_url_encode(data : String) : String do
    to_url_safe_b64(stdlib_base64_encode(data))
  end

  doc "Decode a URL-safe Base64 string to bytes."
  fn base64_url_decode(s : String) : Result(Bytes, String) do
    stdlib_base64_decode(from_url_safe_b64(s))
  end

  -- ── Utilities ─────────────────────────────────────────────────────────────

  doc "Convert a `Bytes` value to a `String` (each byte treated as a raw octet)."
  fn bytes_to_string(b : Bytes) : String do
    match b do
    Bytes(xs) ->
      fn go(cs, acc) do
        match cs do
        Nil -> string_join(rev_list(acc), "")
        Cons(n, rest) -> go(rest, Cons(char_from_int(n), acc))
        end
      end
      go(xs, Nil)
    end
  end

end
