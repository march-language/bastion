-- Session — cookie-backed session storage for Bastion.
--
-- Sessions are stored as a signed cookie named "_session".
-- The cookie value is: "<hmac_hex>.<base64_payload>" where:
--   - base64_payload = base64(serialize(data))
--   - hmac_hex       = HMAC-SHA256(signing_key, base64_payload)
--   - signing_key    = Crypto.derive_key(secret_key_base, "session_signing")
--
-- The payload is signed but not encrypted.  This is safe as long as the
-- session contains only non-secret identifiers (user IDs, CSRF tokens,
-- flash messages).  AES-256-GCM encryption will be added once the March
-- runtime exposes the necessary builtins.
--
-- Cookie lifetime:
--   - Browser session (no Max-Age) by default.
--   - Persistent (Max-Age=N) when Session.persist/2 is called before commit.
--
-- Session auto-commit:
--   Session.load/2 registers an after-send hook "session_commit" that
--   writes the Set-Cookie header just before the response is flushed.
--   Call Session.load/2 early in the middleware pipeline.
--
-- Typical pipeline:
--
--   conn
--   |> Session.load(secret_key_base)
--   |> CSRF.ensure_token()
--   |> CSRF.protect()
--   |> MyApp.Router.route()
--
-- Reading and writing session values:
--
--   Session.get(conn, "user_id")
--   Session.put(conn, "user_id", "42")
--   Session.delete(conn, "user_id")
--   Session.clear(conn)
--
-- Committing explicitly (if not using the after-send hook):
--
--   conn |> Session.commit(secret_key_base)

mod Bastion.Session do

  needs IO.Random

  import Conn
  import HttpServer
  import Crypto

  -- Assigns key where the secret_key_base is stored for the commit hook.
  let secret_assign = "_session_secret"

  -- Assigns key that marks the session as modified (needs re-commit).
  let dirty_assign  = "_session_dirty"

  -- Cookie name.
  let cookie_name   = "_session"

  -- Session data assign key (holds the decoded "key=value;..." payload).
  let data_assign   = "_session_data"

  -- ── Pipeline middleware ───────────────────────────────────────────────────

  doc """
  Load the session from the request cookie and register the commit hook.

  Decodes and verifies the "_session" cookie using `secret_key_base`.
  If the cookie is absent or has been tampered with, starts a fresh
  empty session.

  Registers the "session_commit" after-send hook so the session is
  automatically written back to a Set-Cookie header after the response.

  Call this early in the request pipeline, after CSRF.ensure_token or
  as the first middleware step.

      conn |> Session.load(secret_key_base)
  """
  fn load(conn : Conn, secret_key_base : String) : Conn do
    let raw = Conn.get_req_cookie(conn, cookie_name)
    let data = match raw do
      None    -> ""
      Some(v) -> verify_and_decode(v, secret_key_base)
      end
    conn
    |> HttpServer.assign(secret_assign, secret_key_base)
    |> HttpServer.assign(data_assign, data)
    |> Conn.register_after_send("session_commit")
  end

  -- ── Reading ───────────────────────────────────────────────────────────────

  doc """
  Get a session value by key.

      Session.get(conn, "user_id")   -- Some("42") or None
  """
  fn get(conn : Conn, key : String) : Option(String) do
    let data = session_data(conn)
    find_session_key(String.split(data, ";"), key)
  end

  -- ── Writing ───────────────────────────────────────────────────────────────

  doc """
  Store a value in the session under `key`.

  Marks the session as dirty so it will be committed.

      Session.put(conn, "user_id", user_id)
  """
  fn put(conn : Conn, key : String, value : String) : Conn do
    let data    = session_data(conn)
    let entries = parse_session(data)
    let updated = upsert_entry(entries, key, value)
    conn
    |> HttpServer.assign(data_assign, serialize_session(updated))
    |> mark_dirty()
  end

  doc """
  Delete a key from the session.

      Session.delete(conn, "user_id")
  """
  fn delete(conn : Conn, key : String) : Conn do
    let data    = session_data(conn)
    let entries = parse_session(data)
    let updated = List.filter(entries, fn pair -> match pair do (k, _) -> k != key end)
    conn
    |> HttpServer.assign(data_assign, serialize_session(updated))
    |> mark_dirty()
  end

  doc """
  Remove all keys from the session.

      Session.clear(conn)
  """
  fn clear(conn : Conn) : Conn do
    conn
    |> HttpServer.assign(data_assign, "")
    |> mark_dirty()
  end

  -- ── Committing ────────────────────────────────────────────────────────────

  doc """
  Write the session back to a Set-Cookie header.

  Called automatically by BastionServer via the "session_commit"
  after-send hook registered by Session.load/2.  You can also call
  it explicitly before redirecting if the hook mechanism isn't available.

      conn |> Session.commit(secret_key_base)
  """
  fn commit(conn : Conn, secret_key_base : String) : Conn do
    match HttpServer.get_assign(conn, dirty_assign) do
    None    -> conn   -- session not modified; skip Set-Cookie
    Some(_) -> do
      let data      = session_data(conn)
      let signed    = sign_and_encode(data, secret_key_base)
      let max_age   = match HttpServer.get_assign(conn, "_session_max_age") do
        Some(v) -> [("Max-Age", v)]
        None    -> []
        end
      -- Secure is env-gated per specs/cookies.md: on in prod (cookies must
      -- only travel over HTTPS), off in dev/test so plain-HTTP localhost
      -- development keeps working.
      let secure = if Config.is_prod() do [("Secure", "")] else [] end
      let opts = List.append(
        List.append([("Path", "/"), ("HttpOnly", ""), ("SameSite", "Lax")], secure),
        max_age
      )
      Conn.put_resp_cookie(conn, cookie_name, signed, opts)
    end
    end
  end

  doc """
  Commit the session using the secret stored by Session.load/2.

  Used by BastionServer's after-send hook dispatch — it has only the
  conn and looks up the secret from assigns.
  """
  fn commit_from_conn(conn : Conn) : Conn do
    match HttpServer.get_assign(conn, secret_assign) do
    None        -> conn   -- Session.load was never called; no-op
    Some(secret) -> commit(conn, secret)
    end
  end

  doc """
  Configure the session cookie to persist for `seconds` after creation.

  Call before commit/2 or let the commit hook pick it up.

      Session.persist(conn, 60 * 60 * 24 * 60)   -- 60 days
  """
  fn persist(conn : Conn, seconds : Int) : Conn do
    HttpServer.assign(conn, "_session_max_age", int_to_string(seconds))
  end

  -- ── Internal helpers ──────────────────────────────────────────────────────

  pfn session_data(conn : Conn) : String do
    match HttpServer.get_assign(conn, data_assign) do
    Some(v) -> v
    None    -> ""
    end
  end

  pfn mark_dirty(conn : Conn) : Conn do
    HttpServer.assign(conn, dirty_assign, "1")
  end

  pfn parse_session(data : String) : List((String, String)) do
    if String.is_empty(data) do []
    else
      List.filter_map(String.split(data, ";"), fn part ->
        match String.split_first(part, "=") do
        Some((k, v)) -> if String.is_empty(k) do None else Some((k, v)) end
        None         -> None
        end
      )
    end
  end

  pfn serialize_session(entries : List((String, String))) : String do
    String.join(List.map(entries, fn pair -> match pair do (k, v) -> k ++ "=" ++ v end), ";")
  end

  pfn upsert_entry(entries : List((String, String)), key : String, value : String) : List((String, String)) do
    let without = List.filter(entries, fn pair -> match pair do (k, _) -> k != key end)
    List.append(without, [(key, value)])
  end

  pfn find_session_key(parts : List(String), key : String) : Option(String) do
    match parts do
    Nil -> None
    Cons(part, rest) ->
      match String.split_first(part, "=") do
      None         -> find_session_key(rest, key)
      Some((k, v)) ->
        if k == key do Some(v)
        else find_session_key(rest, key)
        end
      end
    end
  end

  -- ── Signing ───────────────────────────────────────────────────────────────
  --
  -- Cookie format: "<hmac_hex>.<base64_payload>"
  --
  --   base64_payload = base64(session_data_string)
  --   hmac_hex       = HMAC-SHA256(signing_key, base64_payload)
  --   signing_key    = Crypto.derive_key(secret_key_base, "session_signing")
  --
  -- Using a derived key means the signing key is distinct from the raw
  -- secret_key_base and from other derived keys (e.g. "csrf_signing"),
  -- preventing cross-context forgeries.

  pfn sign_and_encode(data : String, secret : String) : String do
    let signing_key = Crypto.derive_key(secret, "session_signing")
    let payload     = Crypto.base64_encode(data)
    let mac         = Crypto.hmac_sha256(signing_key, payload)
    mac ++ "." ++ payload
  end

  -- The "." delimiter is unambiguous because neither side can contain it:
  -- the MAC is lowercase hex and the payload is standard base64
  -- (A-Z a-z 0-9 + / =).  Both halves are still validated structurally
  -- before any crypto runs so malformed cookies are rejected cheaply and
  -- can never reach HMAC/decode with attacker-shaped input.
  pfn verify_and_decode(raw : String, secret : String) : String do
    -- Browsers cap cookies at ~4 KiB; anything larger is hostile or corrupt.
    if String.byte_size(raw) > 8192 do ""
    else
      match String.split_first(raw, ".") do
      None                 -> ""   -- malformed — no dot separator
      Some((mac, payload)) ->
        -- HMAC-SHA256 as lowercase hex is always exactly 64 characters.
        if String.byte_size(mac) != 64 ||
           not(all_hex(string_chars(mac))) ||
           String.is_empty(payload) do
          ""   -- malformed — MAC is not 64 hex chars or payload is empty
        else
          let signing_key = Crypto.derive_key(secret, "session_signing")
          let expected    = Crypto.hmac_sha256(signing_key, payload)
          if Crypto.secure_compare(mac, expected) do
            match Crypto.base64_decode(payload) do
            Ok(b)  -> Crypto.bytes_to_string(b)
            Err(_) -> ""
            end
          else ""  -- HMAC mismatch — tampered or wrong secret
          end
        end
      end
    end
  end

  pfn all_hex(cs : List(String)) : Bool do
    match cs do
    Nil -> true
    Cons(c, rest) ->
      let ok = char_is_digit(c) || c == "a" || c == "b" || c == "c" ||
               c == "d" || c == "e" || c == "f"
      if ok do all_hex(rest) else false end
    end
  end

end
