-- Bastion.TypedMiddleware — typed middleware pipeline for Bastion.
--
-- Each middleware function transforms a Conn from one type state to another.
-- The type parameter on Conn(a) makes middleware ordering a compile-time
-- guarantee when the March type system supports parameterized types.
--
-- Intended type signatures:
--
--   parse_body   : Conn(Raw)         -> Conn(Parsed)
--   load_session : Conn(Parsed)      -> Conn(WithSession)
--   require_auth : Conn(WithSession) -> Result(Conn(Authenticated), Conn(WithSession))
--   with_db      : Conn(a)           -> Conn(a & WithDB)
--
-- Standard endpoint pipeline:
--
--   fn call(conn) do
--     conn
--     |> TypedMiddleware.parse_body()
--     |> TypedMiddleware.load_session(MyApp.Config.secret_key_base())
--     |> TypedMiddleware.with_db(MyApp.Repo.pool())
--     |> MyApp.Router.route()
--   end
--
-- Protected routes with authentication:
--
--   fn route(conn, :get, ["dashboard" | rest]) do
--     match TypedMiddleware.require_auth(conn) do
--     Ok(authed_conn) -> DashboardHandler.index(authed_conn)
--     Error(err_conn) -> err_conn |> redirect("/login")
--     end
--   end

mod TypedMiddleware do

  -- ── Body parsing ──────────────────────────────────────────────────

  doc """
  Parse the request body based on the Content-Type header.

  Stores the raw body in assigns under "_body". The parsed form is also
  available via get_body_string/1. For JSON bodies, use Request.json_body/1.

  Intended type: Conn(Raw) -> Conn(Parsed)
  """
  fn parse_body(conn) do
    let body = HttpServer.req_body(conn)
    HttpServer.assign(conn, "_body", body)
  end

  doc "Returns the request body string stored by parse_body."
  fn get_body_string(conn) do
    match HttpServer.get_assign(conn, "_body") do
    Some(v) -> v
    None    -> HttpServer.req_body(conn)
    end
  end

  -- ── Session ───────────────────────────────────────────────────────

  doc """
  Load and decode the session from the signed "_session" cookie.

  Stores the raw session payload in assigns under "_session".
  If the cookie is absent or tampered with, an empty value is stored.

  The secret_key_base is used to verify the cookie signature. A real
  implementation uses HMAC-SHA256; this stub extracts the payload after
  the first "." separator (sig.payload format).

  Intended type: Conn(Parsed) -> Conn(WithSession)
  """
  fn load_session(conn, secret_key_base) do
    let raw    = extract_session_cookie(conn)
    let payload = verify_and_decode(raw, secret_key_base)
    HttpServer.assign(conn, "_session", payload)
  end

  doc """
  Look up a value in the loaded session by key.

  Session data is encoded as "key=value;key2=value2;..." in assigns.
  Returns None if the key is not present or load_session has not run.
  """
  fn get_session_value(conn, key) do
    match HttpServer.get_assign(conn, "_session") do
    None    -> None
    Some(s) -> find_session_key(String.split(s, ";"), key)
    end
  end

  doc """
  Store a value in the current session payload string.

  Returns the conn with the updated session in assigns.
  Call this before writing the session cookie in the response.
  """
  fn put_session_value(conn, key, value) do
    let current = match HttpServer.get_assign(conn, "_session") do
      Some(s) -> s
      None    -> ""
    end
    let entry   = key ++ "=" ++ value
    let updated = match String.is_empty(current) do
      true  -> entry
      false -> current ++ ";" ++ entry
    end
    HttpServer.assign(conn, "_session", updated)
  end

  -- ── Authentication ────────────────────────────────────────────────

  doc """
  Require the current_user_id assign to be set.

  Returns Ok(conn) if the conn carries an authenticated user ID, or
  Error(conn) with a 401 Unauthorized response if not.

  Intended type: Conn(WithSession) -> Result(Conn(Authenticated), Conn(WithSession))

  Typical usage in a router:

    match TypedMiddleware.require_auth(conn) do
    Ok(authed_conn) -> UserHandler.show(authed_conn)
    Error(err_conn) -> err_conn |> redirect("/login")
    end
  """
  fn require_auth(conn) do
    match HttpServer.get_assign(conn, "current_user_id") do
    None    -> HttpServer.text(conn, 401, "Unauthorized")
    Some(_) -> conn
    end
  end

  doc """
  Set the current authenticated user ID in the conn assigns.

  Call this after successfully verifying credentials (password, token, etc.)
  to mark the conn as authenticated for downstream middleware.
  """
  fn set_current_user(conn, user_id) do
    HttpServer.assign(conn, "current_user_id", user_id)
  end

  doc """
  Get the current authenticated user ID from the conn assigns.

  Returns None if require_auth has not been called or the user is not
  authenticated.
  """
  fn get_current_user_id(conn) do
    HttpServer.get_assign(conn, "current_user_id")
  end

  -- ── Database pool ─────────────────────────────────────────────────

  doc """
  Attach a Depot database pool handle to the conn.

  Stores the pool reference under "_db_pool" in assigns so downstream
  handlers can retrieve it with TypedMiddleware.get_db/1.

  Intended type: Conn(a) -> Conn(a & WithDB)

  Example:
    conn |> TypedMiddleware.with_db(MyApp.Repo.pool())
    -- later in handler:
    let pool = TypedMiddleware.get_db(conn)
  """
  fn with_db(conn, pool) do
    HttpServer.assign(conn, "_db_pool", pool)
  end

  doc "Retrieve the database pool handle attached by with_db."
  fn get_db(conn) do
    HttpServer.get_assign(conn, "_db_pool")
  end

  -- ── Content-Type guards ───────────────────────────────────────────

  doc "Returns true if the request Content-Type is application/json."
  fn is_json_request(conn) do
    match HttpServer.get_req_header(conn, "content-type") do
    None    -> false
    Some(ct) -> String.starts_with(ct, "application/json")
    end
  end

  doc "Returns true if the request Content-Type is application/x-www-form-urlencoded."
  fn is_form_request(conn) do
    match HttpServer.get_req_header(conn, "content-type") do
    None    -> false
    Some(ct) -> String.starts_with(ct, "application/x-www-form-urlencoded")
    end
  end

  doc "Returns true if the request Content-Type is multipart/form-data."
  fn is_multipart_request(conn) do
    match HttpServer.get_req_header(conn, "content-type") do
    None    -> false
    Some(ct) -> String.starts_with(ct, "multipart/form-data")
    end
  end

  -- ── Pipeline shortcuts ────────────────────────────────────────────

  doc """
  Standard web pipeline: parse body then load session.

  Equivalent to:
    conn |> parse_body() |> load_session(secret)
  """
  fn web_pipeline(conn, secret) do
    conn
    |> parse_body()
    |> load_session(secret)
  end

  doc """
  Full pipeline: parse body, load session, attach DB pool.

  Equivalent to:
    conn |> parse_body() |> load_session(secret) |> with_db(pool)
  """
  fn full_pipeline(conn, secret, pool) do
    conn
    |> parse_body()
    |> load_session(secret)
    |> with_db(pool)
  end

  -- ── Internal helpers ──────────────────────────────────────────────

  pfn extract_session_cookie(conn) do
    match HttpServer.get_req_header(conn, "cookie") do
    None    -> ""
    Some(v) -> find_cookie_value(String.split(v, "; "), "_session")
    end
  end

  pfn cookie_pair_match(pair, name, eq_idx) do
    let k   = String.trim(String.slice_bytes(pair, 0, eq_idx))
    let len = string_byte_length(pair)
    if k == name
    then String.slice_bytes(pair, eq_idx + 1, len - eq_idx - 1)
    else ""
  end

  pfn find_cookie_value(pairs, name) do
    match pairs do
    Nil -> ""
    Cons(pair, rest) ->
      match String.index_of(pair, "=") do
      None    -> find_cookie_value(rest, name)
      Some(i) -> do
        let v = cookie_pair_match(pair, name, i)
        if string_is_empty(v) then find_cookie_value(rest, name) else v
      end
      end
    end
  end

  -- Verify cookie signature and extract payload.
  -- Format: "<sig>.<payload>" — strips sig, returns payload.
  -- A real implementation verifies the HMAC with secret_key_base.
  pfn verify_and_decode(raw, _secret) do
    match String.index_of(raw, ".") do
    None    -> ""
    Some(i) -> String.slice_bytes(raw, i + 1, string_byte_length(raw) - i - 1)
    end
  end

  pfn session_pair_match(part, key, eq_idx) do
    let k   = String.slice_bytes(part, 0, eq_idx)
    let len = string_byte_length(part)
    if k == key
    then Some(String.slice_bytes(part, eq_idx + 1, len - eq_idx - 1))
    else None
  end

  pfn find_session_key(parts, key) do
    match parts do
    Nil -> None
    Cons(part, rest) ->
      match String.index_of(part, "=") do
      None    -> find_session_key(rest, key)
      Some(i) ->
        match session_pair_match(part, key, i) do
        None    -> find_session_key(rest, key)
        Some(v) -> Some(v)
        end
      end
    end
  end

end
