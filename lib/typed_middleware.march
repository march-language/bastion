-- Bastion.TypedMiddleware — typed middleware pipeline for Bastion.
--
-- Each middleware function transforms a TypedConn(s) from one state to
-- the next.  The phantom type parameter `s` makes pipeline ordering a
-- compile-time guarantee: passing TypedConn(Raw) where TypedConn(WithSession)
-- is expected is a type error caught by the March typechecker.
--
-- Enforced type signatures:
--
--   wrap               : HttpServer.Conn        -> TypedConn(Raw)
--   parse_body         : TypedConn(Raw)         -> TypedConn(Parsed)
--   load_session       : TypedConn(Parsed)      -> TypedConn(WithSession)
--   load_current_user  : TypedConn(WithSession) -> TypedConn(WithSession)  (soft, never halts)
--   unwrap             : TypedConn(s)           -> HttpServer.Conn
--   with_db            : HttpServer.Conn        -> HttpServer.Conn  (WithDB
--                          compositionality deferred: needs intersection/row types)
--
-- Auth is a gate, not a pipeline step.  require_auth is called inside
-- route handlers and returns Result — callers handle both branches:
--
--   require_auth  : TypedConn(WithSession) -> Result(TypedConn(Authenticated), Conn)
--   authenticated : TypedConn(WithSession) -> (TypedConn(Authenticated) -> Conn) -> Conn
--
-- Standard endpoint pipeline:
--
--   fn call(conn) do
--     wrap(conn)
--     |> parse_body()
--     |> load_session(secret)
--     |> load_current_user(fn id -> MyApp.Accounts.get_user(db, id) end)
--     |> unwrap()
--     |> MyApp.Router.route()
--   end
--
-- Inside a handler that requires authentication:
--
--   fn handle_dashboard(conn) do
--     let tc = wrap(conn) |> parse_body() |> load_session(secret) |> load_current_user(loader)
--     authenticated(tc, fn tc ->
--       Dashboard.render(tc) |> unwrap()
--     end)
--   end

mod TypedMiddleware do

  import ConnStates

  -- ── Typed pipeline entry / exit ───────────────────────────────────

  doc """
  Enter the typed middleware pipeline.  Tags a raw HttpServer.Conn with
  the initial `Raw` state so it can flow through the typed stages.
  """
  fn wrap(conn : Conn) : TypedConn(Raw) do
    TypedConn(conn)
  end

  doc """
  Exit the typed middleware pipeline back to a raw HttpServer.Conn.
  Works at any pipeline stage thanks to the polymorphic phantom `s`.
  """
  fn unwrap(tc) do
    match tc do
    TypedConn(c) -> c
    end
  end

  -- ── Body parsing ──────────────────────────────────────────────────

  doc """
  Parse the request body based on the Content-Type header.

  Stores the raw body in assigns under "_body". The parsed form is also
  available via get_body_string/1. For JSON bodies, use Request.json_body/1.

  Enforced type: TypedConn(Raw) -> TypedConn(Parsed)
  """
  fn parse_body(tc : TypedConn(Raw)) : TypedConn(Parsed) do
    let conn = unwrap(tc)
    TypedConn(parse_body_raw(conn))
  end

  pfn parse_body_raw(conn) do
    HttpServer.assign(conn, "_body", HttpServer.req_body(conn))
  end

  doc "Returns the request body string stored by parse_body."
  fn get_body_string(conn) do
    match HttpServer.get_assign(conn, "_body") do
    Some(v) -> v
    None    -> HttpServer.req_body(conn)
    end
  end

  -- ── Session ───────────────────────────────────────────────────────

  doc """
  Load and decode the session from the signed "_session" cookie.

  Stores the raw session payload in assigns under "_session".
  If the cookie is absent or tampered with, an empty value is stored.

  The secret_key_base is used to verify the cookie signature. A real
  implementation uses HMAC-SHA256; this stub extracts the payload after
  the first "." separator (sig.payload format).

  Enforced type: TypedConn(Parsed) -> TypedConn(WithSession)
  """
  fn load_session(tc : TypedConn(Parsed), secret_key_base : String) : TypedConn(WithSession) do
    let conn = unwrap(tc)
    TypedConn(load_session_raw(conn, secret_key_base))
  end

  pfn load_session_raw(conn, secret_key_base) do
    HttpServer.assign(conn, "_session",
      verify_and_decode(extract_session_cookie(conn), secret_key_base))
  end

  doc """
  Look up a value in the loaded session by key.

  Session data is encoded as "key=value;key2=value2;..." in assigns.
  Returns None if the key is not present or load_session has not run.
  """
  fn get_session_value(conn, key) do
    match HttpServer.get_assign(conn, "_session") do
    None    -> None
    Some(s) -> find_session_key(String.split(s, ";"), key)
    end
  end

  doc """
  Store a value in the current session payload string.

  Returns the conn with the updated session in assigns.
  Call this before writing the session cookie in the response.
  """
  fn put_session_value(conn, key, value) do
    let current = match HttpServer.get_assign(conn, "_session") do
      Some(s) -> s
      None    -> ""
    end
    let entry   = key ++ "=" ++ value
    let updated = match String.is_empty(current) do
      true  -> entry
      false -> current ++ ";" ++ entry
    end
    HttpServer.assign(conn, "_session", updated)
  end

  -- ── Authentication ────────────────────────────────────────────────

  doc """
  Soft auth check: load the current user from the session into conn assigns.

  Reads current_user_id from the session, calls loader(conn, id) to fetch
  the user, and assigns the result under "current_user".  If no session
  user ID is present, or the loader returns an error (e.g. deleted user),
  assigns None.  Never halts.

  Enforced type: TypedConn(WithSession) -> TypedConn(WithSession)

  This belongs in the pipeline.  For a hard auth gate (halt on failure),
  call require_auth/1 inside the route handler after the pipeline runs.
  """
  fn load_current_user(tc : TypedConn(WithSession), loader) : TypedConn(WithSession) do
    let conn = unwrap(tc)
    let user = match HttpServer.get_assign(conn, "current_user_id") do
      None     -> None
      Some(id) -> match loader(conn, id) do
        Ok(u)  -> Some(u)
        Err(_) -> None
        end
    end
    TypedConn(HttpServer.assign(conn, "current_user", user))
  end

  doc """
  Auth gate: require an authenticated user.  Call inside route handlers,
  not in the pipeline.

  Returns Ok(TypedConn(Authenticated)) if a current user is loaded, or
  Error(Conn) with a halted redirect to /login if not.

  The Error branch carries a plain Conn (not TypedConn) because it is a
  finished response that needs no further type tracking.

  Use with the `with` expression or the `authenticated/2` helper:

    with Ok(tc) <- require_auth(tc) do
      ...
    else
      Error(conn) -> conn
    end
  """
  fn require_auth(tc : TypedConn(WithSession)) : Result(TypedConn(Authenticated), Conn) do
    let raw = unwrap(tc)
    match HttpServer.get_assign(raw, "current_user_id") do
    Some(_) -> Ok(TypedConn(raw))
    None    ->
      match HttpServer.get_assign(raw, "current_user") do
      Some(_) -> Ok(TypedConn(raw))
      None    -> Err(raw |> HttpServer.send_resp(401, "Unauthorized") |> HttpServer.halt())
      end
    end
  end

  doc """
  Sugar for the common require_auth pattern.

  Calls handler with a TypedConn(Authenticated) if auth passes, or returns
  the halted redirect conn directly if not.  The handler is only ever
  called with a genuinely authenticated conn.
  """
  fn authenticated(tc : TypedConn(WithSession), handler) : Conn do
    match require_auth(tc) do
    Ok(authed)     -> handler(authed)
    Err(halted)  -> halted
    end
  end

  doc """
  Get the current user assigned by load_current_user.

  Returns None if load_current_user was not called or no user was found.
  Callable at any pipeline stage but only meaningful after WithSession.
  """
  fn get_current_user(tc) do
    HttpServer.get_assign(unwrap(tc), "current_user")
  end

  doc """
  Set the current user ID in conn assigns (used by auth generators and
  log_in helpers to mark a user as logged in for the current request).
  """
  fn set_current_user_id(conn, user_id) do
    HttpServer.assign(conn, "current_user_id", user_id)
  end

  -- ── Database pool ─────────────────────────────────────────────────

  doc """
  Attach a Depot database pool handle to the conn.

  Stores the pool reference under "_db_pool" in assigns so downstream
  handlers can retrieve it with TypedMiddleware.get_db/1.

  Intended type: Conn(a) -> Conn(a & WithDB)

  Example:
    conn |> TypedMiddleware.with_db(MyApp.Repo.pool())
    -- later in handler:
    let pool = TypedMiddleware.get_db(conn)
  """
  fn with_db(conn, pool) do
    HttpServer.assign(conn, "_db_pool", pool)
  end

  doc "Retrieve the database pool handle attached by with_db."
  fn get_db(conn) do
    HttpServer.get_assign(conn, "_db_pool")
  end

  -- ── Content-Type guards ───────────────────────────────────────────

  doc "Returns true if the request Content-Type is application/json."
  fn is_json_request(conn) do
    match HttpServer.get_req_header(conn, "content-type") do
    None    -> false
    Some(ct) -> String.starts_with(ct, "application/json")
    end
  end

  doc "Returns true if the request Content-Type is application/x-www-form-urlencoded."
  fn is_form_request(conn) do
    match HttpServer.get_req_header(conn, "content-type") do
    None    -> false
    Some(ct) -> String.starts_with(ct, "application/x-www-form-urlencoded")
    end
  end

  doc "Returns true if the request Content-Type is multipart/form-data."
  fn is_multipart_request(conn) do
    match HttpServer.get_req_header(conn, "content-type") do
    None    -> false
    Some(ct) -> String.starts_with(ct, "multipart/form-data")
    end
  end

  -- ── Pipeline shortcuts ────────────────────────────────────────────

  doc """
  Standard web pipeline: parse body then load session.

  Takes and returns a raw HttpServer.Conn so existing call sites keep
  working.  Internally runs the typed pipeline and unwraps at the end.
  """
  fn web_pipeline(conn, secret) do
    unwrap(
      wrap(conn)
      |> parse_body()
      |> load_session(secret))
  end

  doc """
  Full pipeline: parse body, load session, attach DB pool.

  Takes and returns a raw HttpServer.Conn.  with_db/2 is applied to the
  raw conn after unwrapping because WithDB composes at any stage and
  intersection/row types are not yet supported.
  """
  fn full_pipeline(conn, secret, pool) do
    let c = unwrap(
      wrap(conn)
      |> parse_body()
      |> load_session(secret))
    with_db(c, pool)
  end

  -- ── Internal helpers ──────────────────────────────────────────────

  pfn extract_session_cookie(conn) do
    match HttpServer.get_req_header(conn, "cookie") do
    None    -> ""
    Some(v) -> find_cookie_value(String.split(v, "; "), "_session")
    end
  end

  pfn cookie_pair_match(pair, name, eq_idx) do
    let k   = String.trim(String.slice_bytes(pair, 0, eq_idx))
    let len = string_byte_length(pair)
    if k == name
    then String.slice_bytes(pair, eq_idx + 1, len - eq_idx - 1)
    else ""
  end

  pfn find_cookie_value(pairs, name) do
    match pairs do
    Nil -> ""
    Cons(pair, rest) ->
      match String.index_of(pair, "=") do
      None    -> find_cookie_value(rest, name)
      Some(i) -> do
        let v = cookie_pair_match(pair, name, i)
        if string_is_empty(v) then find_cookie_value(rest, name) else v
      end
      end
    end
  end

  -- Verify cookie signature and extract payload.
  -- Format: "<sig>.<payload>" — strips sig, returns payload.
  -- A real implementation verifies the HMAC with secret_key_base.
  pfn verify_and_decode(raw, _secret) do
    match String.index_of(raw, ".") do
    None    -> ""
    Some(i) -> String.slice_bytes(raw, i + 1, string_byte_length(raw) - i - 1)
    end
  end

  pfn session_pair_match(part, key, eq_idx) do
    let k   = String.slice_bytes(part, 0, eq_idx)
    let len = string_byte_length(part)
    if k == key
    then Some(String.slice_bytes(part, eq_idx + 1, len - eq_idx - 1))
    else None
  end

  pfn find_session_key(parts, key) do
    match parts do
    Nil -> None
    Cons(part, rest) ->
      match String.index_of(part, "=") do
      None    -> find_session_key(rest, key)
      Some(i) ->
        match session_pair_match(part, key, i) do
        None    -> find_session_key(rest, key)
        Some(v) -> Some(v)
        end
      end
    end
  end

end
