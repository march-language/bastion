-- Bastion.ErrorOverlay — dev-mode error overlay.
--
-- Provides:
--   1. `rescue_errors/1` plug — stub (no-op until HttpServer.try_call is available).
--   2. `router_plug/1` — mounts /_bastion/debug/:session_id (returns 404 stub).
--   3. `render_error_page/2` — renders a rich HTML 500 page for dev mode.
--
-- The crash REPL is not yet available (requires March.Repl, not yet implemented).
--
-- The debug endpoint and rich error page are hard-gated at runtime on
-- Bastion.Dev.dev_env(): outside dev the plug answers 404 and the error
-- page degrades to a plain 500 without exception details.  You can still
-- additionally guard the mount in your router, but production safety does
-- not depend on it.
--
-- Typical setup in your router:
--
--   import Bastion.ErrorOverlay
--
--   conn |> ErrorOverlay.router_plug()

mod Bastion.ErrorOverlay do

  needs IO.Console
  needs IO.Clock
  needs IO.NetListen
  needs IO.Mut
  import HttpServer
  import Bastion.Dev

-- ---------------------------------------------------------------------------
-- Public API
-- ---------------------------------------------------------------------------

doc """
Wrap the next pipeline step in error recovery.

NOTE: Not yet implemented — returns conn unchanged until HttpServer.try_call
is available.
"""
fn rescue_errors(conn) do
  conn
end

doc """
Handle /_bastion/debug/:session_id WebSocket requests.

NOTE: Crash REPL not yet available (requires March.Repl).
Returns 404 for now.
"""
fn debug_socket(conn, _session_id : String) do
  HttpServer.send_resp(conn, 404, "Crash REPL not yet available")
end

doc """
Route plug: intercept /_bastion/debug/:id requests.

Hard-gated at runtime on `Bastion.Dev.dev_env()` — outside dev the
endpoint answers a plain 404 (indistinguishable from a missing route)
regardless of how the app mounted it, so a forgotten `if dev_env?()`
in a router cannot expose the debug surface in production.
"""
fn router_plug(conn) do
  let path = HttpServer.path(conn)
  let prefix = "/_bastion/debug/"
  if String.starts_with(path, prefix) do
    if Bastion.Dev.dev_env() do
      let session_id = String.slice_bytes(path, String.byte_size(prefix),
                         String.byte_size(path) - String.byte_size(prefix))
      debug_socket(conn, session_id)
    else
      HttpServer.send_resp(conn, 404, "Not Found")
    end
  else conn end
end

doc """
Render a 500 error page with error message.

In dev mode this is the rich overlay including the error message.  In any
other environment it degrades to a plain "Internal Server Error" page so
exception details (paths, SQL, secrets in messages) never reach clients.
"""
fn render_error_page(conn, err_msg : String) do
  if Bastion.Dev.dev_env() do
    let session_id = Crypto.generate_token(16)
    let html       = error_page_html(err_msg, session_id)
    HttpServer.send_resp(conn, 500, html)
  else
    HttpServer.send_resp(conn, 500, "Internal Server Error")
  end
end

-- ---------------------------------------------------------------------------
-- Error page HTML
-- ---------------------------------------------------------------------------

pfn error_page_html(err_msg : String, session_id : String) : String do
  "<!DOCTYPE html>\n" ++
  "<html lang=\"en\">\n" ++
  "<head>\n" ++
  "  <meta charset=\"UTF-8\">\n" ++
  "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" ++
  "  <title>Error — Bastion Dev Overlay</title>\n" ++
  "  <style>" ++ overlay_css() ++ "</style>\n" ++
  "</head>\n" ++
  "<body>\n" ++
  "  <div class=\"overlay\">\n" ++
  "    <header>\n" ++
  "      <span class=\"badge\">RuntimeError</span>\n" ++
  "      <h1 class=\"message\">" ++ Html.escape(err_msg) ++ "</h1>\n" ++
  "    </header>\n" ++
  "    <section class=\"request-info\">\n" ++
  "      <h2>Request</h2>\n" ++
  "      <dl id=\"req-info\"></dl>\n" ++
  "    </section>\n" ++
  "    <section class=\"repl\">\n" ++
  "      <h2>Crash REPL\n" ++
  "        <span class=\"hint\">not yet available — requires March.Repl</span>\n" ++
  "      </h2>\n" ++
  "    </section>\n" ++
  "  </div>\n" ++
  "  <script>" ++ overlay_js(session_id) ++ "</script>\n" ++
  "</body>\n" ++
  "</html>\n"
end

-- ---------------------------------------------------------------------------
-- Static assets (inlined)
-- ---------------------------------------------------------------------------

pfn overlay_css() : String do
  "* { box-sizing: border-box; margin: 0; padding: 0; }" ++
  "body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;" ++
  "       background: #0f0f10; color: #e2e8f0; min-height: 100vh; }" ++
  ".overlay { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }" ++
  "header { border-left: 4px solid #e53e3e; padding-left: 1rem; margin-bottom: 2rem; }" ++
  ".badge { background: #e53e3e; color: #fff; font-size: .75rem; font-weight: 700;" ++
  "         padding: .2rem .5rem; border-radius: 4px; text-transform: uppercase; }" ++
  "h1.message { font-size: 1.4rem; font-weight: 600; margin-top: .5rem;" ++
  "             color: #fed7d7; word-break: break-word; }" ++
  "section { margin-bottom: 2rem; }" ++
  "h2 { font-size: .85rem; text-transform: uppercase; letter-spacing: .08em;" ++
  "     color: #718096; margin-bottom: .75rem; display: flex; align-items: center; gap: .5rem; }" ++
  ".hint { font-size: .8rem; color: #4a5568; text-transform: none; letter-spacing: 0; }" ++
  "dl { display: grid; grid-template-columns: max-content 1fr; gap: .3rem .75rem;" ++
  "     font-size: .9rem; }" ++
  "dt { color: #718096; }" ++
  "dd { font-family: monospace; word-break: break-all; color: #e2e8f0; }"
end

pfn overlay_js(session_id : String) : String do
  let safe_id = String.replace_all(session_id, "\"", "\\\"")
  "const SID = \"" ++ safe_id ++ "\";\n" ++
  "// Crash REPL not yet available.\n" ++
  "// Session ID: " ++ safe_id ++ "\n"
end

end -- mod Bastion.ErrorOverlay
