-- test/test_gate.march
-- Tests for the Gate changeset-style form validation module.

mod TestGate do

-- ── Gate.cast ────────────────────────────────────────────────────────────────

describe "Gate.cast" do
  test "keeps only permitted fields" do
    let gate = Gate.cast([("email", "a@b.com"), ("role", "admin")], ["email"])
    assert (Gate.get_change(gate, "email") == Some("a@b.com"))
    assert (Gate.get_change(gate, "role") == None)
  end

  test "empty params gives empty changes" do
    let gate = Gate.cast([], ["email"])
    assert (Gate.get_change(gate, "email") == None)
  end

  test "empty permitted keeps nothing" do
    let gate = Gate.cast([("email", "a@b.com")], [])
    assert (Gate.get_change(gate, "email") == None)
  end

  test "fresh gate is valid" do
    let gate = Gate.cast([], [])
    assert (Gate.valid(gate))
  end
end

-- ── Gate.cast_record ──────────────────────────────────────────────────────────

describe "Gate.cast_record" do
  test "changes override original data in get_field" do
    let record = [("email", "old@example.com")]
    let gate   = Gate.cast_record(record, [("email", "new@example.com")], ["email"])
    assert (Gate.get_field(gate, "email") == Some("new@example.com"))
  end

  test "original data is returned when no change present" do
    let record = [("email", "old@example.com"), ("name", "Alice")]
    let gate   = Gate.cast_record(record, [("email", "new@example.com")], ["email"])
    assert (Gate.get_field(gate, "name") == Some("Alice"))
  end

  test "get_change returns None for fields not in params" do
    let record = [("email", "old@example.com")]
    let gate   = Gate.cast_record(record, [], ["email"])
    assert (Gate.get_change(gate, "email") == None)
  end
end

-- ── Gate.validate_required ───────────────────────────────────────────────────

describe "Gate.validate_required" do
  test "valid when field is present and non-empty" do
    let gate = Gate.cast([("email", "a@b.com")], ["email"])
               |> Gate.validate_required(["email"])
    assert (Gate.valid(gate))
  end

  test "error when field is absent" do
    let gate = Gate.cast([], ["email"])
               |> Gate.validate_required(["email"])
    assert (!Gate.valid(gate))
    assert (Gate.error_for(gate, "email") != None)
  end

  test "error when field is empty string" do
    let gate = Gate.cast([("email", "")], ["email"])
               |> Gate.validate_required(["email"])
    assert (!Gate.valid(gate))
  end

  test "error when field is whitespace only" do
    let gate = Gate.cast([("email", "   ")], ["email"])
               |> Gate.validate_required(["email"])
    assert (!Gate.valid(gate))
  end

  test "validates multiple fields" do
    let gate = Gate.cast([("email", "a@b.com")], ["email", "password"])
               |> Gate.validate_required(["email", "password"])
    assert (!Gate.valid(gate))
    assert (Gate.error_for(gate, "password") != None)
    assert (Gate.error_for(gate, "email") == None)
  end
end

-- ── Gate.validate_length ─────────────────────────────────────────────────────

describe "Gate.validate_length" do
  test "valid when within range" do
    let gate = Gate.cast([("pw", "helloworld12")], ["pw"])
               |> Gate.validate_length("pw", [LenMin(12), LenMax(72)])
    assert (Gate.valid(gate))
  end

  test "error when too short" do
    let gate = Gate.cast([("pw", "short")], ["pw"])
               |> Gate.validate_length("pw", [LenMin(12)])
    assert (!Gate.valid(gate))
    match Gate.error_for(gate, "pw") do
    None    -> assert false
    Some(e) -> assert (string_contains(e, "too short"))
    end
  end

  test "error when too long" do
    let gate = Gate.cast([("name", "averylongnamethatexceedslimit")], ["name"])
               |> Gate.validate_length("name", [LenMax(10)])
    assert (!Gate.valid(gate))
    match Gate.error_for(gate, "name") do
    None    -> assert false
    Some(e) -> assert (string_contains(e, "too long"))
    end
  end

  test "no error when field absent" do
    let gate = Gate.cast([], ["pw"])
               |> Gate.validate_length("pw", [LenMin(12)])
    assert (Gate.valid(gate))
  end
end

-- ── Gate.validate_inclusion ──────────────────────────────────────────────────

describe "Gate.validate_inclusion" do
  test "valid when value in list" do
    let gate = Gate.cast([("role", "admin")], ["role"])
               |> Gate.validate_inclusion("role", ["admin", "member"])
    assert (Gate.valid(gate))
  end

  test "error when value not in list" do
    let gate = Gate.cast([("role", "superuser")], ["role"])
               |> Gate.validate_inclusion("role", ["admin", "member"])
    assert (!Gate.valid(gate))
  end

  test "no error when field absent" do
    let gate = Gate.cast([], ["role"])
               |> Gate.validate_inclusion("role", ["admin", "member"])
    assert (Gate.valid(gate))
  end
end

-- ── Gate.validate_confirmation ───────────────────────────────────────────────

describe "Gate.validate_confirmation" do
  test "valid when field matches confirmation" do
    let gate = Gate.cast([("password", "secret123"), ("password_confirmation", "secret123")], ["password", "password_confirmation"])
               |> Gate.validate_confirmation("password")
    assert (Gate.valid(gate))
  end

  test "error when field does not match confirmation" do
    let gate = Gate.cast([("password", "secret123"), ("password_confirmation", "wrong")], ["password", "password_confirmation"])
               |> Gate.validate_confirmation("password")
    assert (!Gate.valid(gate))
    assert (Gate.error_for(gate, "password_confirmation") != None)
  end

  test "no error when confirmation field absent" do
    let gate = Gate.cast([("password", "secret123")], ["password"])
               |> Gate.validate_confirmation("password")
    assert (Gate.valid(gate))
  end
end

-- ── Gate.put_change / delete_change ──────────────────────────────────────────

describe "Gate.put_change / delete_change" do
  test "put_change adds a new field" do
    let gate = Gate.cast([], [])
               |> Gate.put_change("hashed_password", "bcrypt_hash")
    assert (Gate.get_change(gate, "hashed_password") == Some("bcrypt_hash"))
  end

  test "put_change replaces existing field" do
    let gate = Gate.cast([("email", "old@example.com")], ["email"])
               |> Gate.put_change("email", "new@example.com")
    assert (Gate.get_change(gate, "email") == Some("new@example.com"))
  end

  test "delete_change removes a field" do
    let gate = Gate.cast([("password", "plain")], ["password"])
               |> Gate.delete_change("password")
    assert (Gate.get_change(gate, "password") == None)
  end
end

-- ── Gate.add_error ────────────────────────────────────────────────────────────

describe "Gate.add_error" do
  test "add_error marks gate invalid" do
    let gate = Gate.cast([], [])
               |> Gate.add_error("email", "has already been taken")
    assert (!Gate.valid(gate))
  end

  test "error_for returns the message" do
    let gate = Gate.cast([], [])
               |> Gate.add_error("email", "has already been taken")
    assert (Gate.error_for(gate, "email") == Some("has already been taken"))
  end

  test "errors returns all error pairs" do
    let gate = Gate.cast([], [])
               |> Gate.add_error("email", "invalid")
               |> Gate.add_error("password", "too short")
    let errs = Gate.errors(gate)
    assert (List.length(errs) == 2)
  end

  test "error_for returns None for field with no error" do
    let gate = Gate.cast([("email", "a@b.com")], ["email"])
    assert (Gate.error_for(gate, "email") == None)
  end
end

-- ── Pipeline composition ─────────────────────────────────────────────────────

describe "Gate pipeline" do
  test "multiple validators compose correctly" do
    let params = [("email", "not-an-email"), ("password", "short")]
    let gate = Gate.cast(params, ["email", "password"])
               |> Gate.validate_required(["email", "password"])
               |> Gate.validate_length("password", [LenMin(12)])
    -- email passes required, password fails length
    assert (!Gate.valid(gate))
    assert (Gate.error_for(gate, "email") == None)
    assert (Gate.error_for(gate, "password") != None)
  end

  test "all fields valid gives valid gate" do
    let params = [("email", "me@example.com"), ("password", "longenoughpassword")]
    let gate = Gate.cast(params, ["email", "password"])
               |> Gate.validate_required(["email", "password"])
               |> Gate.validate_length("password", [LenMin(12)])
    assert (Gate.valid(gate))
  end
end

-- ── Helpers ───────────────────────────────────────────────────────────────────

pfn string_contains(haystack : String, needle : String) : Bool do
  match String.index_of(haystack, needle) do
  Some(_) -> true
  None    -> false
  end
end

end
